{
  "version": "0.4",
  "title": "Single Event - 02 Hero",
  "type": "section",
  "content": [
    {
      "id": "se_hero_wrap",
      "elType": "container",
      "settings": {
        "content_width": "full",
        "padding": { "unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true }
      },
      "elements": [
        {
          "id": "se_hero_html",
          "elType": "widget",
          "settings": {
            "html": "<section class=\"se-hero-section\">\n  <img class=\"se-hero-bg\" src=\"[se_event_image]\" alt=\"[se_event_title]\">\n  <div class=\"se-hero-overlay\"></div>\n  <div class=\"se-hero-content\">\n    <span class=\"se-eyebrow\">[se_event_attr name=\"Event Dates\"]</span>\n    <h1 class=\"se-hero-title\">[se_event_title]</h1>\n    <p class=\"se-hero-sub\">[se_event_attr name=\"Sanctuary\"]</p>\n  </div>\n</section>\n<style>\n@import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400;1,500&family=Jost:wght@200;300;400;500;600&display=swap');\n.se-hero-section {\n  position: relative !important;\n  width: 100% !important;\n  height: 60vh !important;\n  min-height: 480px !important;\n  display: flex !important;\n  align-items: flex-end !important;\n  overflow: hidden !important;\n  background: #0E1B30 !important;\n}\n.se-hero-bg {\n  position: absolute !important;\n  inset: 0 !important;\n  width: 100% !important;\n  height: 100% !important;\n  object-fit: cover !important;\n  object-position: center 35% !important;\n  opacity: 0.85 !important;\n  animation: se-slowzoom 16s ease forwards !important;\n  z-index: 0 !important;\n}\n.se-hero-overlay {\n  position: absolute !important;\n  inset: 0 !important;\n  background: linear-gradient(to top, rgba(14,27,48,0.95) 0%, rgba(14,27,48,0.45) 55%, rgba(14,27,48,0.1) 100%) !important;\n  z-index: 1 !important;\n}\n.se-hero-content {\n  position: relative !important;\n  z-index: 2 !important;\n  padding: 0 4rem 4rem !important;\n  width: 100% !important;\n  max-width: 900px !important;\n  display: flex !important;\n  flex-direction: column !important;\n  gap: 0.4rem !important;\n}\n.se-eyebrow {\n  font-family: 'Jost', sans-serif !important;\n  font-size: 0.62rem !important;\n  letter-spacing: 0.42em !important;\n  text-transform: uppercase !important;\n  color: #688F9D !important;\n  display: block !important;\n  margin-bottom: 0.6rem !important;\n  opacity: 0;\n  animation: se-fadeUp 1s ease 0.4s forwards !important;\n}\n.se-hero-title {\n  font-family: 'Cormorant Garamond', serif !important;\n  font-size: clamp(2rem, 4.5vw, 3.8rem) !important;\n  font-weight: 300 !important;\n  line-height: 1.15 !important;\n  color: #F7F0EC !important;\n  margin: 0 0 0.4rem !important;\n  word-wrap: break-word !important;\n  overflow-wrap: break-word !important;\n  opacity: 0;\n  animation: se-fadeUp 1s ease 0.7s forwards !important;\n}\n.se-hero-sub {\n  font-family: 'Jost', sans-serif !important;\n  font-size: 11px !important;\n  letter-spacing: 0.25em !important;\n  text-transform: uppercase !important;\n  color: #A4B2BA !important;\n  margin: 0 !important;\n  opacity: 0;\n  animation: se-fadeUp 1s ease 1s forwards !important;\n}\n@keyframes se-slowzoom { from { transform: scale(1.06); } to { transform: scale(1); } }\n@keyframes se-fadeUp { from { opacity: 0; transform: translateY(22px); } to { opacity: 1; transform: translateY(0); } }\n@media (max-width: 768px) {\n  .se-hero-content { padding: 0 1.5rem 3rem !important; }\n  .se-hero-section { min-height: 440px !important; height: 55vh !important; }\n}\n</style>"
          },
          "widgetType": "html"
        }
      ]
    }
  ],
  "page_settings": []
}
