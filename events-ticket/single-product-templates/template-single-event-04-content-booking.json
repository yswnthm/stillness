{"version":"0.4","title":"Single Event - 04 Content + Booking","type":"section","content":[{"id":"se_cb_wrap","elType":"container","settings":{"content_width":"full","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true}},"elements":[{"id":"se_cb_html","elType":"widget","settings":{"html":"<section class=\"se-detail-section\">\n  <div class=\"se-detail-grid\">\n\n    <!-- LEFT COLUMN -->\n    <div class=\"se-content-col\">\n      <div class=\"se-intro-block\">\n        <h2 class=\"se-section-h2\">A return to <em>your center</em>.</h2>\n        <blockquote class=\"se-pull-quote\">[se_event_short_desc]</blockquote>\n      </div>\n      <div class=\"se-desc-block\">[se_event_desc]</div>\n    </div>\n\n    <!-- RIGHT BOOKING CARD -->\n    <div class=\"se-booking-sidebar\" id=\"booking-section\">\n      <div class=\"se-booking-card\">\n        <div class=\"se-card-top\">\n          [se_event_stock]\n          <h3 class=\"se-card-title\">[se_event_title]</h3>\n          <div class=\"se-card-price\">[se_event_price]</div>\n        </div>\n        <div class=\"se-card-details\">\n          <div class=\"se-card-detail\">\n            <svg viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M19 4h-1V2h-2v2H8V2H6v2H5c-1.11 0-1.99.9-1.99 2L3 20c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 16H5V9h14v11z\"/></svg>\n            <span>[se_event_attr name=\"Event Dates\"]</span>\n          </div>\n          <div class=\"se-card-detail\">\n            <svg viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z\"/></svg>\n            <span>[se_event_attr name=\"Duration\"]</span>\n          </div>\n          <div class=\"se-card-detail\">\n            <svg viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z\"/></svg>\n            <span>[se_event_attr name=\"Sanctuary\"]</span>\n          </div>\n        </div>\n        <div class=\"se-card-form\" id=\"se-wc-form-inject\">\n          [se_event_add_to_cart_form]\n        </div>\n        <p class=\"se-card-trust\">Price includes luxury boutique lodging, organic vegetarian meals, all daily practices, and integration materials.</p>\n        <a href=\"#notify\" class=\"se-card-waitlist-link\">Join Waitlist Instead &rarr;</a>\n      </div>\n    </div>\n\n  </div>\n</section>\n\n<style>\n@import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400;1,500&family=Jost:wght@200;300;400;500;600&display=swap');\n\n.se-detail-section { background: #F7F0EC !important; }\n.se-detail-grid {\n  max-width: 1200px !important;\n  margin: 0 auto !important;\n  padding: 80px 4rem !important;\n  display: grid !important;\n  grid-template-columns: 1fr 360px !important;\n  gap: 80px !important;\n  align-items: start !important;\n}\n.se-content-col { display: flex !important; flex-direction: column !important; gap: 52px !important; }\n.se-intro-block, .se-desc-block { display: flex !important; flex-direction: column !important; gap: 20px !important; }\n.se-section-h2 {\n  font-family: 'Cormorant Garamond', serif !important;\n  font-size: clamp(1.8rem, 3vw, 2.8rem) !important;\n  font-weight: 300 !important;\n  line-height: 1.15 !important;\n  color: #0E1B30 !important;\n  margin: 0 !important;\n}\n.se-section-h2 em { font-style: italic !important; color: #688F9D !important; }\n.se-pull-quote {\n  font-family: 'Cormorant Garamond', serif !important;\n  margin: 0 !important;\n  padding-left: 1.25rem !important;\n  border-left: 1.5px solid #688F9D !important;\n}\n.se-pull-quote p {\n  font-family: 'Cormorant Garamond', serif !important;\n  font-size: clamp(1.1rem, 1.6vw, 1.4rem) !important;\n  font-weight: 300 !important;\n  font-style: italic !important;\n  color: #0E1B30 !important;\n  line-height: 1.6 !important;\n  margin: 0 0 1rem !important;\n}\n.se-pull-quote p:last-child {\n  margin-bottom: 0 !important;\n}\n.se-desc-block {\n  font-family: 'Jost', sans-serif !important;\n  font-size: 13.5px !important;\n  line-height: 1.95 !important;\n  color: #3D4F57 !important;\n  padding-top: 16px !important;\n  border-top: 0.5px solid rgba(14,27,48,0.1) !important;\n}\n.se-desc-block p {\n  font-family: 'Jost', sans-serif !important;\n  font-size: 13.5px !important;\n  line-height: 1.95 !important;\n  color: #3D4F57 !important;\n  margin: 0 0 1.2rem !important;\n}\n.se-desc-block p:last-child { margin-bottom: 0 !important; }\n\n/* Styling for long description HTML children */\n.se-desc-block h1,\n.se-desc-block h2,\n.se-desc-block h3,\n.se-desc-block h4 {\n  font-family: 'Cormorant Garamond', serif !important;\n  font-weight: 300 !important;\n  color: #0E1B30 !important;\n  margin-top: 1.8rem !important;\n  margin-bottom: 0.8rem !important;\n  line-height: 1.25 !important;\n}\n.se-desc-block h1 { font-size: clamp(1.8rem, 2.5vw, 2.4rem) !important; }\n.se-desc-block h2 { font-size: clamp(1.5rem, 2vw, 2rem) !important; }\n.se-desc-block h3 { font-size: clamp(1.2rem, 1.8vw, 1.6rem) !important; }\n.se-desc-block h4 { font-size: clamp(1rem, 1.5vw, 1.3rem) !important; }\n\n.se-desc-block ul,\n.se-desc-block ol {\n  margin-top: 0.5rem !important;\n  margin-bottom: 1.2rem !important;\n  padding-left: 1.5rem !important;\n}\n.se-desc-block li {\n  font-family: 'Jost', sans-serif !important;\n  font-size: 13.5px !important;\n  line-height: 1.8 !important;\n  color: #3D4F57 !important;\n  margin-bottom: 0.5rem !important;\n}\n.se-desc-block strong {\n  font-weight: 500 !important;\n  color: #0E1B30 !important;\n}\n.se-desc-block em {\n  font-style: italic !important;\n}\n.se-desc-block a {\n  color: #688F9D !important;\n  text-decoration: underline !important;\n  transition: color 0.3s ease !important;\n}\n.se-desc-block a:hover {\n  color: #1D3152 !important;\n}\n\n/* BOOKING CARD */\n.se-booking-sidebar { position: sticky !important; top: 100px !important; }\n.se-booking-card {\n  background: #FFFFFF !important;\n  border: 0.5px solid rgba(14,27,48,0.08) !important;\n  border-radius: 3px !important;\n  padding: 36px !important;\n  display: flex !important;\n  flex-direction: column !important;\n  gap: 28px !important;\n  box-shadow: 0 16px 40px rgba(14,27,48,0.06) !important;\n}\n.se-card-top { display: flex !important; flex-direction: column !important; gap: 8px !important; }\n.se-card-title {\n  font-family: 'Cormorant Garamond', serif !important;\n  font-size: 22px !important;\n  letter-spacing: 0.01em !important;\n  font-weight: 300 !important;\n  color: #0E1B30 !important;\n  margin: 0 !important;\n  line-height: 1.2 !important;\n}\n.se-card-price {\n  font-family: 'Jost', sans-serif !important;\n  font-size: 26px !important;\n  margin-top: 4px !important;\n  font-weight: 400 !important;\n  color: #688F9D !important;\n}\n.se-card-price .amount { font-size: inherit !important; color: inherit !important; font-family: inherit !important; }\n.se-card-details {\n  display: flex !important;\n  flex-direction: column !important;\n  gap: 12px !important;\n  padding: 20px 0 !important;\n  border-top: 0.5px solid rgba(14,27,48,0.06) !important;\n  border-bottom: 0.5px solid rgba(14,27,48,0.06) !important;\n}\n.se-card-detail {\n  display: flex !important;\n  align-items: center !important;\n  gap: 12px !important;\n  font-family: 'Jost', sans-serif !important;\n  font-size: 11.5px !important;\n  color: #3D4F57 !important;\n}\n.se-card-detail svg { width: 14px !important; height: 14px !important; color: #688F9D !important; flex-shrink: 0 !important; }\n\n/* Stock badge */\n.se-stock-badge {\n  display: inline-flex !important;\n  align-items: center !important;\n  gap: 6px !important;\n  font-family: 'Jost', sans-serif !important;\n  font-size: 8px !important;\n  letter-spacing: 0.22em !important;\n  text-transform: uppercase !important;\n  font-weight: 500 !important;\n}\n.se-stock-limited, .se-stock-avail { color: #C4935A !important; }\n.se-stock-sold-out { color: #A4B2BA !important; }\n.se-badge-dot {\n  width: 6px !important; height: 6px !important;\n  border-radius: 50% !important;\n  background: currentColor !important;\n  animation: se-pulse 2s infinite !important;\n  display: inline-block !important;\n}\n@keyframes se-pulse { 0%,100% { opacity: 0.7; transform: scale(0.9); } 50% { opacity: 1; transform: scale(1.3); } }\n\n/* WooCommerce form inside card */\n.se-card-form form.cart {\n  display: flex !important;\n  flex-direction: column !important;\n  gap: 12px !important;\n  margin: 0 !important;\n  padding: 0 !important;\n  border: none !important;\n  background: none !important;\n}\n/* Hide default WC stock text */\n.se-card-form .stock,\n.se-card-form .in-stock,\n.se-card-form .out-of-stock,\n.se-card-form .availability,\n.se-booking-card p.stock {\n  display: none !important;\n}\n/* Quantity Selector Styled like Prototype */\n.booking-qty-wrapper { display: flex !important; flex-direction: column !important; gap: 8px !important; }\n.qty-label { font-size: 9px !important; letter-spacing: 0.15em !important; text-transform: uppercase !important; color: #7A8F96 !important; font-weight: 500 !important; font-family: 'Jost', sans-serif !important; }\n.qty-selectors { display: flex !important; border: 0.5px solid rgba(14,27,48,0.15) !important; border-radius: 2px !important; overflow: hidden !important; width: 120px !important; height: 40px !important; }\n.qty-btn { width: 40px !important; border: none !important; background: transparent !important; color: #0E1B30 !important; cursor: pointer !important; display: flex !important; align-items: center !important; justify-content: center !important; font-size: 14px !important; transition: background 0.2s !important; }\n.qty-btn:hover { background: rgba(217,232,235,0.3) !important; }\n.qty-input { width: 40px !important; border: none !important; border-left: 0.5px solid rgba(14,27,48,0.15) !important; border-right: 0.5px solid rgba(14,27,48,0.15) !important; text-align: center !important; font-family: 'Jost', sans-serif !important; font-size: 13px !important; font-weight: 400 !important; color: #0E1B30 !important; outline: none !important; background: transparent !important; padding: 0 !important; margin: 0 !important; -moz-appearance: textfield; }\n.qty-input::-webkit-outer-spin-button, .qty-input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }\n.se-card-form button.single_add_to_cart_button {\n  font-family: 'Jost', sans-serif !important;\n  font-size: 10px !important;\n  font-weight: 500 !important;\n  letter-spacing: 0.22em !important;\n  text-transform: uppercase !important;\n  color: #F7F0EC !important;\n  background: #0E1B30 !important;\n  border: none !important;\n  padding: 16px 24px !important;\n  border-radius: 2px !important;\n  cursor: pointer !important;\n  width: 100% !important;\n  transition: all 0.3s ease !important;\n  line-height: normal !important;\n}\n.se-card-form button.single_add_to_cart_button:hover {\n  background: #1D3152 !important;\n  transform: translateY(-2px) !important;\n  box-shadow: 0 4px 12px rgba(14,27,48,0.1) !important;\n}\n.se-card-trust {\n  font-family: 'Jost', sans-serif !important;\n  font-size: 10px !important;\n  line-height: 1.6 !important;\n  color: #7A8F96 !important;\n  text-align: center !important;\n  font-style: italic !important;\n  margin: 0 !important;\n}\n.se-card-waitlist-link {\n  display: none;\n  text-align: center !important;\n  font-family: 'Jost', sans-serif !important;\n  font-size: 10px !important;\n  letter-spacing: 0.2em !important;\n  text-transform: uppercase !important;\n  color: #688F9D !important;\n  text-decoration: none !important;\n  font-weight: 500 !important;\n  padding: 14px 20px !important;\n  border: 1px solid #688F9D !important;\n  border-radius: 2px !important;\n  transition: all 0.3s ease !important;\n  margin-top: 10px !important;\n}\n.se-card-waitlist-link:hover {\n  background: #688F9D !important;\n  color: #FFFFFF !important;\n}\n.se-booking-card:has(.se-stock-sold-out) .se-card-waitlist-link {\n  display: block !important;\n}\n.se-booking-card.is-sold-out .se-card-waitlist-link {\n  display: block !important;\n}\n\n@media (max-width: 1024px) {\n  .se-detail-grid { grid-template-columns: 1fr !important; gap: 48px !important; padding: 60px 2.5rem !important; }\n  .se-booking-sidebar { position: static !important; }\n}\n@media (max-width: 768px) {\n  .se-detail-grid { padding: 40px 1.5rem !important; }\n}\n</style>\n\n<script>\ndocument.addEventListener('DOMContentLoaded', function() {\n  // Move the native WooCommerce add-to-cart form into the booking card if not already there\n  var formInject = document.getElementById('se-wc-form-inject');\n  var nativeForm = document.querySelector('form.cart');\n  if (formInject && nativeForm && !formInject.contains(nativeForm)) {\n    formInject.classList.add('se-card-form');\n    formInject.appendChild(nativeForm);\n  }\n\n  // Style the quantity selector inside the booking card\n  var qtyWrapper = document.querySelector('.se-card-form .quantity');\n  var qtyInput = document.querySelector('.se-card-form .qty');\n  if (qtyWrapper && qtyInput && !qtyWrapper.classList.contains('styled')) {\n    qtyWrapper.classList.add('styled');\n    \n    Array.from(qtyWrapper.childNodes).forEach(function(child) {\n      if (child !== qtyInput) qtyWrapper.removeChild(child);\n    });\n    \n    var newWrapper = document.createElement('div');\n    newWrapper.className = 'booking-qty-wrapper';\n    \n    var label = document.createElement('span');\n    label.className = 'qty-label';\n    label.innerText = 'Quantity';\n    \n    var selectors = document.createElement('div');\n    selectors.className = 'qty-selectors';\n    \n    var minusBtn = document.createElement('button');\n    minusBtn.type = 'button';\n    minusBtn.className = 'qty-btn';\n    minusBtn.innerText = '-';\n    minusBtn.onclick = function() { \n      qtyInput.stepDown(); \n      qtyInput.dispatchEvent(new Event('change', { bubbles: true }));\n    };\n    \n    var plusBtn = document.createElement('button');\n    plusBtn.type = 'button';\n    plusBtn.className = 'qty-btn';\n    plusBtn.innerText = '+';\n    plusBtn.onclick = function() { \n      qtyInput.stepUp(); \n      qtyInput.dispatchEvent(new Event('change', { bubbles: true }));\n    };\n    \n    qtyInput.classList.add('qty-input');\n    \n    selectors.appendChild(minusBtn);\n    selectors.appendChild(qtyInput);\n    selectors.appendChild(plusBtn);\n    \n    newWrapper.appendChild(label);\n    newWrapper.appendChild(selectors);\n    \n    qtyWrapper.appendChild(newWrapper);\n  }\n\n  // Show waitlist link if sold out\n  var stockEl = document.querySelector('.se-stock-sold-out');\n  var waitlistLink = document.querySelector('.se-card-waitlist-link');\n  if (stockEl) {\n    var card = document.querySelector('.se-booking-card');\n    if (card) {\n      card.classList.add('is-sold-out');\n    }\n    if (waitlistLink) {\n      waitlistLink.style.display = 'block';\n    }\n  }\n});\n</script>"},"widgetType":"html"}]}],"page_settings":[]}