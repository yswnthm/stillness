          "settings": {
            "html": "<section class=\"ec-hero\">\n  <img class=\"ec-hero-img\" src=\"\" alt=\"Meditation in nature\">\n  <div class=\"ec-hero-overlay\"></div>\n  <div class=\"ec-hero-content\">\n    <span class=\"ec-eyebrow\">The Catalog</span>\n    <h1 class=\"ec-hero-title\">Curated <em>Retreats</em></h1>\n    <p class=\"ec-hero-sub\">Step away from the noise. Intimate, transformative experiences designed to return you to your center.</p>\n    <div class=\"ec-hero-btns\">\n      <a href=\"#events\" class=\"ec-btn-cream\">View Upcoming</a>\n    </div>\n  </div>\n  <div class=\"ec-scroll-hint\">\n    <div class=\"ec-scroll-line\"></div>\n    <span>Scroll</span>\n  </div>\n</section>\n\n<style>\n@import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400&family=Jost:wght@300;400;500&display=swap');\n\n*, *::before, *::after { margin: 0 !important; padding: 0 !important; box-sizing: border-box !important; }\n\n:root {\n  --ec-stone: #0E1B30;\n  --ec-midnight: #1D3152;\n  --ec-seafoam: #688F9D;\n  --ec-wave: #A4B2BA;\n  --ec-breeze: #D9E8EB;\n  --ec-sand: #C4BBB4;\n  --ec-cream: #F7F0EC;\n  --ec-warm: #F2E8DF;\n  --ec-white: #FFFFFF;\n}\n\n.ec-hero {\n  position: relative !important;\n  height: 85vh !important;\n  min-height: 640px !important;\n  display: flex !important;\n  align-items: flex-end !important;\n  overflow: hidden !important;\n  background: var(--ec-stone) !important;\n}\n\n.ec-hero-img {\n  position: absolute !important;\n  inset: 0 !important;\n  width: 100% !important;\n  height: 100% !important;\n  object-fit: cover !important;\n  object-position: center 30% !important;\n  opacity: 0.8 !important;\n}\n\n.ec-hero-overlay {\n  position: absolute !important;\n  inset: 0 !important;\n  background: linear-gradient(to top, rgba(14,27,48,0.95) 0%, rgba(14,27,48,0.4) 50%, rgba(14,27,48,0.1) 100%) !important;\n}\n\n.ec-hero-content {\n  position: relative !important;\n  z-index: 2 !important;\n  padding: 0 4rem 6rem !important;\n  max-width: 900px !important;\n}\n\n.ec-eyebrow {\n  font-family: 'Jost', sans-serif !important;\n  font-size: 0.65rem !important;\n  letter-spacing: 0.42em !important;\n  text-transform: uppercase !important;\n  color: var(--ec-breeze) !important;\n  margin-bottom: 1.75rem !important;\n  display: block !important;\n  opacity: 0 !important;\n  animation: ec-fadeUp 1s ease 0.4s forwards !important;\n}\n\n.ec-hero-title {\n  font-family: 'Cormorant Garamond', serif !important;\n  font-size: clamp(3.5rem, 8vw, 7rem) !important;\n  font-weight: 300 !important;\n  line-height: 0.95 !important;\n  color: var(--ec-cream) !important;\n  margin-bottom: 1.5rem !important;\n  opacity: 0 !important;\n  animation: ec-fadeUp 1s ease 0.7s forwards !important;\n}\n\n.ec-hero-title em {\n  font-style: italic !important;\n  color: var(--ec-wave) !important;\n  display: block !important;\n}\n\n.ec-hero-sub {\n  font-family: 'Cormorant Garamond', serif !important;\n  font-size: clamp(1rem, 2vw, 1.4rem) !important;\n  font-style: italic !important;\n  color: var(--ec-wave) !important;\n  max-width: 500px !important;\n  line-height: 1.65 !important;\n  margin-bottom: 2.5rem !important;\n  opacity: 0 !important;\n  animation: ec-fadeUp 1s ease 1s forwards !important;\n}\n\n.ec-hero-btns {\n  display: flex !important;\n  gap: 1rem !important;\n  flex-wrap: wrap !important;\n  opacity: 0 !important;\n  animation: ec-fadeUp 1s ease 1.3s forwards !important;\n}\n\n.ec-btn-cream {\n  font-family: 'Jost', sans-serif !important;\n  font-size: 0.72rem !important;\n  font-weight: 500 !important;\n  letter-spacing: 0.2em !important;\n  text-transform: uppercase !important;\n  color: var(--ec-stone) !important;\n  background: var(--ec-cream) !important;\n  border: none !important;\n  padding: 1rem 2.2rem !important;\n  cursor: pointer !important;\n  transition: all 0.3s !important;\n  text-decoration: none !important;\n  display: inline-block !important;\n}\n\n.ec-btn-cream:hover {\n  background: var(--ec-breeze) !important;\n  transform: translateY(-2px) !important;\n}\n\n.ec-scroll-hint {\n  position: absolute !important;\n  bottom: 2.5rem !important;\n  right: 4rem !important;\n  z-index: 2 !important;\n  display: flex !important;\n  flex-direction: column !important;\n  align-items: center !important;\n  gap: 0.5rem !important;\n  opacity: 0 !important;\n  animation: ec-fadeUp 1s ease 1.8s forwards !important;\n}\n\n.ec-scroll-hint span {\n  font-family: 'Jost', sans-serif !important;\n  font-size: 0.58rem !important;\n  letter-spacing: 0.35em !important;\n  text-transform: uppercase !important;\n  color: var(--ec-seafoam) !important;\n  writing-mode: vertical-rl !important;\n}\n\n.ec-scroll-line {\n  width: 0.5px !important;\n  height: 52px !important;\n  background: linear-gradient(to bottom, transparent, var(--ec-seafoam)) !important;\n  animation: ec-scrollPulse 2s ease-in-out infinite !important;\n}\n\n@keyframes ec-fadeUp {\n  from { opacity: 0; transform: translateY(24px); }\n  to { opacity: 1; transform: translateY(0); }\n}\n\n@keyframes ec-scrollPulse {\n  0%, 100% { transform: scaleY(0.8); opacity: 0.5; transform-origin: top; }\n  50% { transform: scaleY(1); opacity: 1; transform-origin: top; }\n}\n\n@media(max-width: 768px) {\n  .ec-hero-content { padding: 0 1.5rem 5rem !important; }\n  .ec-scroll-hint { display: none !important; }\n}\n</style>"
