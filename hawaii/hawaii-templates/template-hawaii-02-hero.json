          "settings": {
            "html": "<div class=\"hw-wrapper\">\n<section class=\"hw-hero\">\n  <img class=\"hw-hero-img\" src=\"https://images.unsplash.com/photo-1542259009477-d625272157b7?q=80&w=2069&auto=format&fit=crop\" alt=\"Hawaii Luxury Retreat\">\n  <div class=\"hw-hero-overlay\"></div>\n  <div class=\"hw-hero-content\">\n    <div class=\"hw-hero-eyebrow\">An Exclusive Clinical-Grade Intervention</div>\n    <h1 class=\"hw-hero-title\">THE NEURO-SENSORY RESET</h1>\n    <p class=\"hw-hero-sub\">A 4-day biometric intervention on Big Island, Hawaii. Systematically deactivate your stress response, rest your visual cortex, and retrain your vagus nerve to restore your biological baseline.</p>\n    <div class=\"hw-hero-byline\">November 17–22, 2026 · 12 Exclusive Spots · $6,000 Investment</div>\n    <div class=\"hw-hero-btns\">\n      <a href=\"#application\" class=\"hw-btn-p\">Apply for Private Intake Consultation</a>\n    </div>\n  </div>\n</section>\n</div>\n\n<style>\n@import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400;1,500&family=Jost:wght@200;300;400;500&display=swap');\n\n*,*::before,*::after{box-sizing:border-box !important}\n:root{\n  --stone: #0E1B30;\n  --cream: #F7F0EC;\n  --warm: #F2E8DF;\n  --seafoam: #688F9D;\n  --wave: #A4B2BA;\n  --sand: #C4BBB4;\n  --amber: #C4935A;\n  --midnight: #1D3152;\n  --breeze: #D9E8EB;\n  --text-body: #3D4F57;\n}\n.hw-wrapper{\n  background:var(--cream);\n  color:var(--stone);\n  font-family:'Jost',sans-serif !important;\n  font-weight:300;\n}\n\n/* ─── HERO (Untouched) ─── */\n.hw-hero{position:relative;height:100vh;min-height:640px;display:flex;align-items:center;justify-content:center;overflow:hidden;text-align:center}\n.hw-hero-img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center;animation:slowzoom 16s ease forwards}\n@keyframes slowzoom{from{transform:scale(1.06)}to{transform:scale(1.0)}}\n.hw-hero-overlay{position:absolute;inset:0;background:linear-gradient(to top,rgba(14,27,48,0.8) 0%,rgba(14,27,48,0.4) 50%,rgba(14,27,48,0.2) 100%)}\n.hw-hero-content{position:relative;z-index:2;padding:0 4rem;max-width:900px;display:flex;flex-direction:column;align-items:center}\n.hw-hero-eyebrow{font-size:0.68rem;letter-spacing:0.4em;text-transform:uppercase;color:var(--seafoam);margin-bottom:1.5rem;opacity:0;animation:fadeUp 1s ease 0.4s forwards}\n.hw-hero-title{font-family:'Cormorant Garamond',serif !important;font-size:clamp(3.5rem,7vw,6rem);font-weight:300;line-height:1;color:var(--cream);margin-bottom:1.5rem;opacity:0;animation:fadeUp 1s ease 0.7s forwards;letter-spacing:-0.02em}\n.hw-hero-sub{font-family:'Jost',sans-serif !important;font-size:1.1rem;font-weight:300;color:var(--breeze);max-width:750px;line-height:1.8;margin-bottom:1.5rem;opacity:0;animation:fadeUp 1s ease 1s forwards}\n.hw-hero-byline{font-family:'Cormorant Garamond',serif !important;font-size:1.1rem;font-style:italic;color:var(--wave);margin-bottom:2.5rem;opacity:0;animation:fadeUp 1s ease 1.2s forwards}\n.hw-hero-btns{opacity:0;animation:fadeUp 1s ease 1.4s forwards}\n.hw-btn-p{font-family:'Jost',sans-serif !important;font-size:0.72rem;font-weight:400;letter-spacing:0.22em;text-transform:uppercase;color:var(--stone);background:var(--wave);border:none;padding:1rem 2.5rem;cursor:pointer;transition:all 0.3s ease;text-decoration:none;display:inline-block}\n.hw-btn-p:hover{background:var(--sand);transform:translateY(-2px)}\n\n@keyframes fadeUp{from{opacity:0;transform:translateY(22px)}to{opacity:1;transform:translateY(0)}}\n@keyframes slowzoom{from{transform:scale(1.06)}to{transform:scale(1.0)}}\n@media (max-width: 1024px) {\n  .hw-crisis-section{flex-direction:column}\n  .hw-crisis-visual{height:60vh;position:relative}\n  .hw-crisis-visual::after{background:linear-gradient(to top,var(--stone),transparent)}\n  .hw-crisis-content{padding:80px 40px;min-height:auto}\n  .hw-black-card{grid-template-columns:1fr}\n  .hw-bc-left{border-right:none;border-bottom:1px solid rgba(196,147,90,0.15)}\n}\n\n@media (max-width: 900px) {\n  .hw-glass-grid, .hw-dash-panels{grid-template-columns:1fr;gap:30px}\n  .hw-v-timeline{padding-left:0;padding-right:0}\n  .hw-v-spine{left:30px}\n  .hw-v-node-wrapper{padding-left:80px}\n  .hw-v-circle{left:0;width:60px;justify-content:center}\n  .hw-v-circle-inner{width:50px;height:50px;box-shadow:0 0 0 4px var(--cream)}\n  .hw-v-circle-inner span:last-child{font-size:16px}\n  .hw-v-circle-inner span:first-child{font-size:7px}\n  .hw-v-event-row{flex-direction:column;gap:8px}\n  .hw-img-strip{grid-template-columns:1fr}\n}\n\n@media (max-width: 768px) {\n  nav{padding:1.25rem 1.5rem}\n  .hw-hero-content{padding:0 1.5rem}\n  .hw-pillars-section, .hw-itinerary-section, .hw-dash-section, .hw-inv-section, .hw-app-section{padding:80px 24px}\n  .hw-v-data-card{padding:30px 24px}\n  .hw-portal-box{padding:40px 30px}\n  .hw-bc-left, .hw-bc-right{padding:40px 30px}\n}\n</style>"
