          "settings": {
            "html": "<div class=\"hw-wrapper\">\n<section class=\"hw-inv-section\">\n  <div class=\"hw-inv-header\">\n    <h2 class=\"hw-section-title\">Ultra-Exclusive <em>Inclusions & Investment</em></h2>\n    <div class=\"hw-exclusivity\">\n      Due to the highly immersive nature of the 24-hour blind sensory day and personalized biometric tracking, this cohort is strictly limited to 12 curated attendees.\n    </div>\n  </div>\n\n  <div class=\"hw-black-card\">\n    <div class=\"hw-bc-left\">\n      <h3 class=\"hw-bc-title\">What's Included</h3>\n      <ul class=\"hw-bc-list\">\n        <li>4 Days / 3 Nights in a private, ultra-luxury eco-villa on Big Island</li>\n        <li>All gourmet, organic meals curated by a private chef to optimize cell health</li>\n        <li>Complete access to all private sound therapy pools, floating setups, and vocal yoga sessions</li>\n        <li>All biometric tracking hardware shipped to your home, including pre-and-post data monitoring</li>\n        <li>Two private, 1-on-1 virtual integration and prep consultations</li>\n        <li>All local luxury airport ground transit in Hawaii</li>\n      </ul>\n    </div>\n    \n    <div class=\"hw-bc-right\">\n      <h3 class=\"hw-bc-title\">Total Investment</h3>\n      <div class=\"hw-bc-price\">$6,000</div>\n      \n      <div class=\"hw-bc-tiers\">\n        <div class=\"hw-bc-tier\">\n          <strong>Full Tuition</strong>\n          <span>One-time payment. Due prior to arrival.</span>\n        </div>\n        <div class=\"hw-bc-tier\">\n          <strong>Payment Plan (5 × $1K)</strong>\n          <span>$1,000 deposit to secure. Then $1,000 monthly (July–November 2026).</span>\n        </div>\n      </div>\n      \n      <p class=\"hw-bc-terms\">All balances must be settled in full prior to arrival. All payments are non-refundable but fully transferable to a qualified colleague upon approval.</p>\n    </div>\n  </div>\n</section>\n</div>\n\n<style>\n@import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400;1,500&family=Jost:wght@200;300;400;500&display=swap');\n\n*,*::before,*::after{box-sizing:border-box !important}\n:root{\n  --stone: #0E1B30;\n  --cream: #F7F0EC;\n  --warm: #F2E8DF;\n  --seafoam: #688F9D;\n  --wave: #A4B2BA;\n  --sand: #C4BBB4;\n  --amber: #C4935A;\n  --midnight: #1D3152;\n  --breeze: #D9E8EB;\n  --text-body: #3D4F57;\n}\n.hw-wrapper{\n  background:var(--cream);\n  color:var(--stone);\n  font-family:'Jost',sans-serif !important;\n  font-weight:300;\n}\n\n/* ─── INCLUSIONS & INVESTMENT (Black Card) ─── */\n.hw-inv-section{padding:160px 0;background:var(--cream);position:relative}\n.hw-inv-header{text-align:center;max-width:800px;margin:0 auto 80px}\n.hw-inv-header h2{font-family:'Cormorant Garamond',serif !important;font-size:clamp(36px,5vw,56px);font-weight:300;color:var(--stone);line-height:1.1}\n.hw-inv-header h2 em{color:var(--seafoam);font-style:italic}\n.hw-inv-header .hw-exclusivity{background:transparent;border:none;border-bottom:1px solid var(--amber);padding-bottom:24px;font-size:16px;font-weight:400;color:var(--stone);line-height:1.6;margin-top:24px}\n\n.hw-black-card{background:var(--stone);max-width:1100px;margin:0 auto;border-radius:2px;position:relative;overflow:hidden;box-shadow:0 40px 80px rgba(14,27,48,0.15);display:grid;grid-template-columns:1.2fr 1fr;border:1px solid rgba(196,147,90,0.3)}\n.hw-bc-left{padding:80px;position:relative;z-index:2;border-right:1px solid rgba(196,147,90,0.15)}\n.hw-bc-right{padding:80px;position:relative;z-index:2;background:rgba(255,255,255,0.02)}\n.hw-bc-title{font-family:'Cormorant Garamond',serif !important;font-size:28px;font-weight:300;color:var(--cream);margin-bottom:40px}\n.hw-bc-list{list-style:none;display:flex;flex-direction:column;gap:20px}\n.hw-bc-list li{font-size:15px;color:var(--breeze);padding-left:36px;position:relative;line-height:1.7}\n.hw-bc-list li::before{content:'';position:absolute;left:0;top:8px;width:16px;height:1px;background:var(--amber)}\n.hw-bc-price{font-family:'Cormorant Garamond',serif !important;font-size:72px;font-weight:300;color:var(--amber);margin-bottom:40px;line-height:1}\n.hw-bc-tiers{display:flex;flex-direction:column;gap:20px;margin-bottom:40px}\n.hw-bc-tier{border:1px solid rgba(104,143,157,0.3);padding:24px;border-radius:2px;transition:all 0.3s ease}\n.hw-bc-tier:hover{border-color:var(--amber);background:rgba(196,147,90,0.05)}\n.hw-bc-tier strong{display:block;font-size:14px;color:var(--cream);letter-spacing:0.05em;margin-bottom:6px;font-weight:400}\n.hw-bc-tier span{font-size:13px;color:var(--wave);line-height:1.6;display:block}\n.hw-bc-terms{font-size:11px;color:rgba(164,178,186,0.5);line-height:1.6;font-style:italic}\n@media (max-width: 1024px) {\n  .hw-crisis-section{flex-direction:column}\n  .hw-crisis-visual{height:60vh;position:relative}\n  .hw-crisis-visual::after{background:linear-gradient(to top,var(--stone),transparent)}\n  .hw-crisis-content{padding:80px 40px;min-height:auto}\n  .hw-black-card{grid-template-columns:1fr}\n  .hw-bc-left{border-right:none;border-bottom:1px solid rgba(196,147,90,0.15)}\n}\n\n@media (max-width: 900px) {\n  .hw-glass-grid, .hw-dash-panels{grid-template-columns:1fr;gap:30px}\n  .hw-v-timeline{padding-left:0;padding-right:0}\n  .hw-v-spine{left:30px}\n  .hw-v-node-wrapper{padding-left:80px}\n  .hw-v-circle{left:0;width:60px;justify-content:center}\n  .hw-v-circle-inner{width:50px;height:50px;box-shadow:0 0 0 4px var(--cream)}\n  .hw-v-circle-inner span:last-child{font-size:16px}\n  .hw-v-circle-inner span:first-child{font-size:7px}\n  .hw-v-event-row{flex-direction:column;gap:8px}\n  .hw-img-strip{grid-template-columns:1fr}\n}\n\n@media (max-width: 768px) {\n  nav{padding:1.25rem 1.5rem}\n  .hw-hero-content{padding:0 1.5rem}\n  .hw-pillars-section, .hw-itinerary-section, .hw-dash-section, .hw-inv-section, .hw-app-section{padding:80px 24px}\n  .hw-v-data-card{padding:30px 24px}\n  .hw-portal-box{padding:40px 30px}\n  .hw-bc-left, .hw-bc-right{padding:40px 30px}\n}\n</style>"
