          "settings": {
            "html": "<div class=\"hw-wrapper\">\n<section class=\"hw-itinerary-section\">\n  <div class=\"hw-itin-header\">\n    <h2 class=\"hw-section-title\">The Protocol for <em>Deep Transformation</em></h2>\n    <p>Every hour is intentionally curated to transition your body from high-frequency executive survival to deep, restorative stillness.</p>\n  </div>\n  \n  <div class=\"hw-v-timeline\">\n    <div class=\"hw-v-spine\"></div>\n    \n    <div class=\"hw-v-node-wrapper\">\n      <div class=\"hw-v-circle\">\n        <div class=\"hw-v-circle-inner\">\n          <span>Day</span>\n          <span>01</span>\n        </div>\n      </div>\n      <div class=\"hw-v-data-card\">\n        <h3 class=\"hw-v-data-title\">The Severance & Unplugging</h3>\n        <div class=\"hw-v-event-row\">\n          <div class=\"hw-v-time\">14:00</div>\n          <div class=\"hw-v-desc\">VIP Private Transit Arrival & Luxury Villa Check-in</div>\n        </div>\n        <div class=\"hw-v-event-row\">\n          <div class=\"hw-v-time\">16:00</div>\n          <div class=\"hw-v-desc\">The Digital Severance: Devices securely locked away to break dopamine addiction loops</div>\n        </div>\n        <div class=\"hw-v-event-row\">\n          <div class=\"hw-v-time\">17:30</div>\n          <div class=\"hw-v-desc\">Opening Orientation & Initial Biometric Review</div>\n        </div>\n        <div class=\"hw-v-event-row\">\n          <div class=\"hw-v-time\">19:00</div>\n          <div class=\"hw-v-desc\">Welcome Dinner: Anti-inflammatory, locally sourced organic cuisine</div>\n        </div>\n        <div class=\"hw-v-event-row\">\n          <div class=\"hw-v-time\">20:30</div>\n          <div class=\"hw-v-desc\">Somatic Grounding Sound Bath to eliminate travel anxiety</div>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"hw-v-node-wrapper\">\n      <div class=\"hw-v-circle\">\n        <div class=\"hw-v-circle-inner\">\n          <span>Day</span>\n          <span>02</span>\n        </div>\n      </div>\n      <div class=\"hw-v-data-card\">\n        <h3 class=\"hw-v-data-title\">Acoustic Re-Awakening & Vagal Toning</h3>\n        <div class=\"hw-v-event-row\">\n          <div class=\"hw-v-time\">07:30</div>\n          <div class=\"hw-v-desc\">Morning Hydration & Nervous System Breathwork</div>\n        </div>\n        <div class=\"hw-v-event-row\">\n          <div class=\"hw-v-time\">09:00</div>\n          <div class=\"hw-v-desc\">Vocal Yoga Workshop: Activating vocal cord resonance to stimulate vagal pathways</div>\n        </div>\n        <div class=\"hw-v-event-row\">\n          <div class=\"hw-v-time\">12:30</div>\n          <div class=\"hw-v-desc\">Organic, nutrient-dense lunch</div>\n        </div>\n        <div class=\"hw-v-event-row\">\n          <div class=\"hw-v-time\">14:30</div>\n          <div class=\"hw-v-desc\">Hydro-Acoustic Floating Journey (Session 1: Gravitational Release)</div>\n        </div>\n        <div class=\"hw-v-event-row\">\n          <div class=\"hw-v-time\">17:00</div>\n          <div class=\"hw-v-desc\">Group Integration & Executive Stress-Mapping</div>\n        </div>\n        <div class=\"hw-v-event-row\">\n          <div class=\"hw-v-time\">19:00</div>\n          <div class=\"hw-v-desc\">Ocean-side Dinner</div>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"hw-v-node-wrapper\">\n      <div class=\"hw-v-circle\">\n        <div class=\"hw-v-circle-inner\">\n          <span>Day</span>\n          <span>03</span>\n        </div>\n      </div>\n      <div class=\"hw-v-data-card\">\n        <h3 class=\"hw-v-data-title\">The 24-Hour Blind Sensory Immersion</h3>\n        <div class=\"hw-v-event-row\">\n          <div class=\"hw-v-time\">08:00</div>\n          <div class=\"hw-v-desc\">Total Blackout Mask Fitting (Masks remain on for 24 continuous hours)</div>\n        </div>\n        <div class=\"hw-v-event-row\">\n          <div class=\"hw-v-time\">09:00</div>\n          <div class=\"hw-v-desc\">Sensory Breakfast: Re-engaging olfactory and tactile receptivity</div>\n        </div>\n        <div class=\"hw-v-event-row\">\n          <div class=\"hw-v-time\">11:00</div>\n          <div class=\"hw-v-desc\">Blind Neuro-Acoustic Sound Immersion amplified tenfold by visual deprivation</div>\n        </div>\n        <div class=\"hw-v-event-row\">\n          <div class=\"hw-v-time\">14:30</div>\n          <div class=\"hw-v-desc\">Blind Vocal Yoga & Chanting: Releasing deep stress without self-consciousness</div>\n        </div>\n        <div class=\"hw-v-event-row\">\n          <div class=\"hw-v-time\">18:30</div>\n          <div class=\"hw-v-desc\">Sensory Dinner in complete visual darkness</div>\n        </div>\n        <div class=\"hw-v-event-row\">\n          <div class=\"hw-v-time\">20:30</div>\n          <div class=\"hw-v-desc\">The Sunset Unveiling: Strategic removal of masks, followed by silent meditation</div>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"hw-v-node-wrapper\">\n      <div class=\"hw-v-circle\">\n        <div class=\"hw-v-circle-inner\">\n          <span>Day</span>\n          <span>04</span>\n        </div>\n      </div>\n      <div class=\"hw-v-data-card\">\n        <h3 class=\"hw-v-data-title\">Strategic Re-Entry & Integration</h3>\n        <div class=\"hw-v-event-row\">\n          <div class=\"hw-v-time\">08:00</div>\n          <div class=\"hw-v-desc\">Final Biometric Check-in & Recovery Matrix Analysis</div>\n        </div>\n        <div class=\"hw-v-event-row\">\n          <div class=\"hw-v-time\">09:30</div>\n          <div class=\"hw-v-desc\">Boardroom Integration Workshop: Building nervous system habits for high-stress workspaces</div>\n        </div>\n        <div class=\"hw-v-event-row\">\n          <div class=\"hw-v-time\">11:30</div>\n          <div class=\"hw-v-desc\">Device Return & Closing Circle</div>\n        </div>\n        <div class=\"hw-v-event-row\">\n          <div class=\"hw-v-time\">13:00</div>\n          <div class=\"hw-v-desc\">Private Transit Departures</div>\n        </div>\n      </div>\n    </div>\n  </div>\n</section>\n</div>\n\n<style>\n@import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400;1,500&family=Jost:wght@200;300;400;500&display=swap');\n\n*,*::before,*::after{box-sizing:border-box !important}\n:root{\n  --stone: #0E1B30;\n  --cream: #F7F0EC;\n  --warm: #F2E8DF;\n  --seafoam: #688F9D;\n  --wave: #A4B2BA;\n  --sand: #C4BBB4;\n  --amber: #C4935A;\n  --midnight: #1D3152;\n  --breeze: #D9E8EB;\n  --text-body: #3D4F57;\n}\n.hw-wrapper{\n  background:var(--cream);\n  color:var(--stone);\n  font-family:'Jost',sans-serif !important;\n  font-weight:300;\n}\n\n/* ─── ITINERARY (Elaborated Vertical Timeline) ─── */\n.hw-itinerary-section{padding:160px 0;background:var(--cream);position:relative}\n.hw-itin-header{text-align:center;max-width:700px;margin:0 auto 100px}\n.hw-itin-header h2{font-family:'Cormorant Garamond',serif !important;font-size:clamp(36px,5vw,56px);font-weight:300;color:var(--stone);line-height:1.1}\n.hw-itin-header h2 em{color:var(--seafoam);font-style:italic}\n.hw-itin-header p{color:var(--text-body);margin-top:24px;font-size:17px;line-height:1.8}\n\n.hw-v-timeline{max-width:900px;margin:0 auto;position:relative;padding-left:120px;padding-right:52px}\n.hw-v-spine{position:absolute;left:60px;top:20px;bottom:20px;width:1px;background:linear-gradient(to bottom,var(--amber),var(--seafoam),var(--amber))}\n.hw-v-node-wrapper{position:relative;margin-bottom:100px}\n.hw-v-node-wrapper:last-child{margin-bottom:0}\n.hw-v-circle{position:absolute;left:-120px;top:0;width:120px;display:flex;align-items:flex-start;justify-content:center}\n.hw-v-circle-inner{width:70px;height:70px;border-radius:50%;background:var(--stone);border:1px solid var(--amber);display:flex;flex-direction:column;align-items:center;justify-content:center;position:relative;z-index:2;box-shadow:0 0 0 6px var(--cream);transition:all 0.4s ease}\n.hw-v-circle-inner span:first-child{font-size:9px;letter-spacing:0.2em;color:var(--seafoam);text-transform:uppercase}\n.hw-v-circle-inner span:last-child{font-family:'Cormorant Garamond',serif !important;font-size:24px;color:var(--cream);line-height:1}\n.hw-v-node-wrapper:hover .hw-v-circle-inner{transform:scale(1.1);background:var(--midnight);box-shadow:0 0 20px rgba(196,147,90,0.3),0 0 0 6px var(--cream)}\n\n.hw-v-data-card{background:#FFF;padding:50px;border:1px solid rgba(196,187,180,0.5);position:relative;transition:all 0.4s ease}\n.hw-v-node-wrapper:hover .hw-v-data-card{border-color:var(--amber);box-shadow:0 20px 40px rgba(14,27,48,0.04)}\n.hw-v-data-title{font-family:'Cormorant Garamond',serif !important;font-size:32px;font-weight:300;color:var(--stone);margin-bottom:32px;padding-bottom:24px;border-bottom:1px solid var(--warm)}\n.hw-v-event-row{display:flex;gap:32px;margin-bottom:24px}\n.hw-v-event-row:last-child{margin-bottom:0}\n.hw-v-time{font-family:'Jost',sans-serif !important;font-weight:400;color:var(--amber);font-size:14px;min-width:60px;letter-spacing:0.05em;padding-top:4px}\n.hw-v-desc{font-size:15px;line-height:1.7;color:var(--text-body);font-weight:300}\n@media (max-width: 1024px) {\n  .hw-crisis-section{flex-direction:column}\n  .hw-crisis-visual{height:60vh;position:relative}\n  .hw-crisis-visual::after{background:linear-gradient(to top,var(--stone),transparent)}\n  .hw-crisis-content{padding:80px 40px;min-height:auto}\n  .hw-black-card{grid-template-columns:1fr}\n  .hw-bc-left{border-right:none;border-bottom:1px solid rgba(196,147,90,0.15)}\n}\n\n@media (max-width: 900px) {\n  .hw-glass-grid, .hw-dash-panels{grid-template-columns:1fr;gap:30px}\n  .hw-v-timeline{padding-left:0;padding-right:0}\n  .hw-v-spine{left:30px}\n  .hw-v-node-wrapper{padding-left:80px}\n  .hw-v-circle{left:0;width:60px;justify-content:center}\n  .hw-v-circle-inner{width:50px;height:50px;box-shadow:0 0 0 4px var(--cream)}\n  .hw-v-circle-inner span:last-child{font-size:16px}\n  .hw-v-circle-inner span:first-child{font-size:7px}\n  .hw-v-event-row{flex-direction:column;gap:8px}\n  .hw-img-strip{grid-template-columns:1fr}\n}\n\n@media (max-width: 768px) {\n  nav{padding:1.25rem 1.5rem}\n  .hw-hero-content{padding:0 1.5rem}\n  .hw-pillars-section, .hw-itinerary-section, .hw-dash-section, .hw-inv-section, .hw-app-section{padding:80px 24px}\n  .hw-v-data-card{padding:30px 24px}\n  .hw-portal-box{padding:40px 30px}\n  .hw-bc-left, .hw-bc-right{padding:40px 30px}\n}\n</style>"
