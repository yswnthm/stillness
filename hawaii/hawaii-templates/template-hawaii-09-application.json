          "settings": {
            "html": "<div class=\"hw-wrapper\">\n<section class=\"hw-app-section\" id=\"application\">\n  <div class=\"hw-app-header\">\n    <h2 class=\"hw-section-title\">Application for <em>Private Invitation</em></h2>\n    <p>To ensure a cohesive, intentional cohort, admission is by private application only. All applicants participate in a 30-minute intake call.</p>\n  </div>\n\n  <div class=\"hw-portal-box\">\n    <div class=\"hw-stillness-hawaii-form-wrap\">\n      [metform form_id=\"6698\"]\n    </div>\n    <div class=\"hw-portal-note\">Your information is confidential. We'll reach out within 48 hours.</div>\n  </div>\n</section>\n</div>\n\n<style>\n@import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400;1,500&family=Jost:wght@200;300;400;500&display=swap');\n\n*,*::before,*::after{box-sizing:border-box !important}\n:root{\n  --stone: #0E1B30;\n  --cream: #F7F0EC;\n  --warm: #F2E8DF;\n  --seafoam: #688F9D;\n  --wave: #A4B2BA;\n  --sand: #C4BBB4;\n  --amber: #C4935A;\n  --midnight: #1D3152;\n  --breeze: #D9E8EB;\n  --text-body: #3D4F57;\n}\n.hw-wrapper{\n  background:var(--cream);\n  color:var(--stone);\n  font-family:'Jost',sans-serif !important;\n  font-weight:300;\n}\n\n/* ─── APPLICATION FORM (Hovering Portal) ─── */\n.hw-app-section{padding:160px 0;background:var(--stone);position:relative;overflow:hidden;text-align:center}\n.hw-app-section::before{content:'';position:absolute;top:-50%;left:-50%;width:200%;height:200%;background:radial-gradient(circle at 50% 50%,rgba(104,143,157,0.05) 0%,transparent 60%);z-index:0;pointer-events:none}\n.hw-app-header{position:relative;z-index:2;margin-bottom:60px}\n.hw-app-header h2{font-family:'Cormorant Garamond',serif !important;font-size:clamp(36px,5vw,56px);font-weight:300;color:var(--cream);line-height:1.1}\n.hw-app-header p{color:var(--wave);margin-top:20px;font-size:16px;max-width:600px;margin-left:auto;margin-right:auto;line-height:1.8}\n\n.hw-portal-box{max-width:600px;margin:0 auto;background:rgba(247,240,236,0.98);padding:70px 60px;border-radius:2px;box-shadow:0 30px 60px rgba(0,0,0,0.5);position:relative;z-index:2;text-align:left}\n.hw-portal-group{margin-bottom:32px;position:relative}\n.hw-portal-label{font-size:10px;text-transform:uppercase;letter-spacing:0.2em;color:var(--seafoam);display:block;margin-bottom:8px;font-weight:500}\n.hw-portal-input{width:100%;background:transparent;border:none;border-bottom:1px solid var(--sand);padding:12px 0;font-size:16px;font-family:'Jost',sans-serif !important;color:var(--stone);transition:border-color 0.4s}\n.hw-portal-input:focus{outline:none;border-bottom-color:var(--amber)}\n.hw-portal-input::placeholder{color:rgba(122,143,150,0.5);font-weight:300}\ntextarea.hw-portal-input{resize:vertical;min-height:100px}\n.hw-portal-submit{width:100%;padding:20px;background:var(--stone);color:var(--cream);border:none;font-family:'Jost',sans-serif !important;font-size:11px;letter-spacing:0.25em;text-transform:uppercase;cursor:pointer;transition:all 0.4s;margin-top:16px}\n.hw-portal-submit:hover{background:var(--amber);color:var(--stone)}\n.hw-portal-note{font-size:11px;color:var(--text-light);font-style:italic;text-align:center;margin-top:24px}\n\n/* MetForm Overrides for Hawaii Application */\n.hw-stillness-hawaii-form-wrap {\n  width: 100% !important;\n  max-width: 100% !important;\n  margin: 0 !important;\n}\n\n.hw-stillness-hawaii-form-wrap form,\n.hw-stillness-hawaii-form-wrap [class~=\"mf-form\"] {\n  display: flex !important;\n  flex-direction: column !important;\n  align-items: stretch !important;\n  justify-content: flex-start !important;\n  width: 100% !important;\n  margin: 0 !important;\n  padding: 0 !important;\n  background: transparent !important;\n  box-shadow: none !important;\n}\n\n.hw-stillness-hawaii-form-wrap [class~=\"mf-input-label\"],\n.hw-stillness-hawaii-form-wrap label {\n  display: block !important;\n  font-family: 'Jost', sans-serif !important;\n  font-size: 10px !important;\n  text-transform: uppercase !important;\n  letter-spacing: 0.2em !important;\n  color: var(--seafoam) !important;\n  margin: 0 0 8px 0 !important;\n  font-weight: 500 !important;\n  line-height: 1.2 !important;\n}\n\n.hw-stillness-hawaii-form-wrap [class~=\"mf-input-wrapper\"],\n.hw-stillness-hawaii-form-wrap form > div:not([class~=\"mf-btn-wraper\"]):not([class~=\"mf-btn-wrapper\"]),\n.hw-stillness-hawaii-form-wrap [class~=\"mf-form\"] > div:not([class~=\"mf-btn-wraper\"]):not([class~=\"mf-btn-wrapper\"]) {\n  width: 100% !important;\n  margin: 0 0 32px 0 !important;\n}\n\n.hw-stillness-hawaii-form-wrap [class~=\"mf-input\"],\n.hw-stillness-hawaii-form-wrap input[type='text'],\n.hw-stillness-hawaii-form-wrap input[type='email'],\n.hw-stillness-hawaii-form-wrap input[type='tel'],\n.hw-stillness-hawaii-form-wrap textarea {\n  width: 100% !important;\n  background: transparent !important;\n  border: none !important;\n  border-bottom: 1px solid var(--sand) !important;\n  padding: 12px 0 !important;\n  font-size: 16px !important;\n  font-family: 'Jost', sans-serif !important;\n  color: var(--stone) !important;\n  transition: border-color 0.4s !important;\n  outline: none !important;\n  box-shadow: none !important;\n  border-radius: 0 !important;\n}\n\n.hw-stillness-hawaii-form-wrap [class~=\"mf-input\"]:focus,\n.hw-stillness-hawaii-form-wrap input[type='text']:focus,\n.hw-stillness-hawaii-form-wrap input[type='email']:focus,\n.hw-stillness-hawaii-form-wrap input[type='tel']:focus,\n.hw-stillness-hawaii-form-wrap textarea:focus {\n  border-bottom-color: var(--amber) !important;\n  background: transparent !important;\n}\n\n.hw-stillness-hawaii-form-wrap [class~=\"mf-input\"]::placeholder,\n.hw-stillness-hawaii-form-wrap input[type='text']::placeholder,\n.hw-stillness-hawaii-form-wrap input[type='email']::placeholder,\n.hw-stillness-hawaii-form-wrap input[type='tel']::placeholder,\n.hw-stillness-hawaii-form-wrap textarea::placeholder {\n  color: rgba(122, 143, 150, 0.5) !important;\n  font-weight: 300 !important;\n}\n\n.hw-stillness-hawaii-form-wrap textarea {\n  resize: vertical !important;\n  min-height: 100px !important;\n}\n\n.hw-stillness-hawaii-form-wrap [class~=\"mf-btn-wraper\"],\n.hw-stillness-hawaii-form-wrap [class~=\"mf-btn-wrapper\"],\n.hw-stillness-hawaii-form-wrap [class~=\"mf-button-wrapper\"],\n.hw-stillness-hawaii-form-wrap [class~=\"mf-submit\"],\n.hw-stillness-hawaii-form-wrap button {\n  display: block !important;\n  flex: 0 0 auto !important;\n  margin: 0 !important;\n  padding: 0 !important;\n  width: 100% !important;\n  opacity: 1 !important;\n  visibility: visible !important;\n}\n\n.hw-stillness-hawaii-form-wrap button[type='submit'],\n.hw-stillness-hawaii-form-wrap input[type='submit'],\n.hw-stillness-hawaii-form-wrap [class~=\"metform-btn\"],\n.hw-stillness-hawaii-form-wrap [class~=\"metform-btn-submit\"],\n.hw-stillness-hawaii-form-wrap [class~=\"mf-btn\"],\n.hw-stillness-hawaii-form-wrap [class~=\"mf-btn-wraper\"] button,\n.hw-stillness-hawaii-form-wrap [class~=\"mf-btn-wrapper\"] button,\n.hw-stillness-hawaii-form-wrap [class~=\"mf-button-wrapper\"] button,\n.hw-stillness-hawaii-form-wrap [class~=\"stillness-hawaii-submit-fallback\"] {\n  display: flex !important;\n  align-items: center !important;\n  justify-content: center !important;\n  width: 100% !important;\n  min-height: 54px !important;\n  padding: 20px !important;\n  background: var(--stone) !important;\n  color: var(--cream) !important;\n  border: none !important;\n  font-family: 'Jost', sans-serif !important;\n  font-size: 11px !important;\n  letter-spacing: 0.25em !important;\n  text-transform: uppercase !important;\n  cursor: pointer !important;\n  transition: all 0.4s !important;\n  margin-top: 16px !important;\n  border-radius: 2px !important;\n  line-height: normal !important;\n  box-shadow: none !important;\n  appearance: none !important;\n  -webkit-appearance: none !important;\n}\n\n.hw-stillness-hawaii-form-wrap button[type='submit']:hover,\n.hw-stillness-hawaii-form-wrap input[type='submit']:hover,\n.hw-stillness-hawaii-form-wrap [class~=\"metform-btn\"]:hover,\n.hw-stillness-hawaii-form-wrap [class~=\"metform-btn-submit\"]:hover,\n.hw-stillness-hawaii-form-wrap [class~=\"mf-btn\"]:hover,\n.hw-stillness-hawaii-form-wrap [class~=\"mf-btn-wraper\"] button:hover,\n.hw-stillness-hawaii-form-wrap [class~=\"mf-btn-wrapper\"] button:hover,\n.hw-stillness-hawaii-form-wrap [class~=\"mf-button-wrapper\"] button:hover,\n.hw-stillness-hawaii-form-wrap [class~=\"stillness-hawaii-submit-fallback\"]:hover {\n  background: var(--amber) !important;\n  color: var(--stone) !important;\n}\n@media (max-width: 1024px) {\n  .hw-crisis-section{flex-direction:column}\n  .hw-crisis-visual{height:60vh;position:relative}\n  .hw-crisis-visual::after{background:linear-gradient(to top,var(--stone),transparent)}\n  .hw-crisis-content{padding:80px 40px;min-height:auto}\n  .hw-black-card{grid-template-columns:1fr}\n  .hw-bc-left{border-right:none;border-bottom:1px solid rgba(196,147,90,0.15)}\n}\n\n@media (max-width: 900px) {\n  .hw-glass-grid, .hw-dash-panels{grid-template-columns:1fr;gap:30px}\n  .hw-v-timeline{padding-left:0;padding-right:0}\n  .hw-v-spine{left:30px}\n  .hw-v-node-wrapper{padding-left:80px}\n  .hw-v-circle{left:0;width:60px;justify-content:center}\n  .hw-v-circle-inner{width:50px;height:50px;box-shadow:0 0 0 4px var(--cream)}\n  .hw-v-circle-inner span:last-child{font-size:16px}\n  .hw-v-circle-inner span:first-child{font-size:7px}\n  .hw-v-event-row{flex-direction:column;gap:8px}\n  .hw-img-strip{grid-template-columns:1fr}\n}\n\n@media (max-width: 768px) {\n  nav{padding:1.25rem 1.5rem}\n  .hw-hero-content{padding:0 1.5rem}\n  .hw-pillars-section, .hw-itinerary-section, .hw-dash-section, .hw-inv-section, .hw-app-section{padding:80px 24px}\n  .hw-v-data-card{padding:30px 24px}\n  .hw-portal-box{padding:40px 30px}\n  .hw-bc-left, .hw-bc-right{padding:40px 30px}\n}\n</style>"
          },
