                    "settings": {
                        "html": "<div class=\"booking-ui-container\">\n  <!-- Calendar Section -->\n  <div class=\"booking-calendar-section\">\n    <div class=\"calendar-header\">\n      <div class=\"calendar-title-wrap\">\n        <h3 class=\"calendar-title\">Select a Date</h3>\n        <p class=\"calendar-subtitle\">March 2026</p>\n      </div>\n      <div class=\"calendar-nav\">\n        <button class=\"nav-button\">\n          <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m15 18-6-6 6-6\"/></svg>\n        </button>\n        <button class=\"nav-button\">\n          <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m9 18 6-6-6-6\"/></svg>\n        </button>\n      </div>\n    </div>\n    \n    <div class=\"calendar-grid\">\n      <div class=\"weekday\">Sun</div>\n      <div class=\"weekday\">Mon</div>\n      <div class=\"weekday\">Tue</div>\n      <div class=\"weekday\">Wed</div>\n      <div class=\"weekday\">Thu</div>\n      <div class=\"weekday\">Fri</div>\n      <div class=\"weekday\">Sat</div>\n      \n      <!-- Empty slot -->\n      <div class=\"day-cell empty-cell\"></div>\n      \n      <!-- Days 1-31 -->\n      <button class=\"day-button\">1</button>\n      <button class=\"day-button\">2</button>\n      <button class=\"day-button\">3</button>\n      <button class=\"day-button\">4</button>\n      <button class=\"day-button\">5</button>\n      <button class=\"day-button\">6</button>\n      <button class=\"day-button\">7</button>\n      <button class=\"day-button\">8</button>\n      <button class=\"day-button\">9</button>\n      <button class=\"day-button\">10</button>\n      <button class=\"day-button\">11</button>\n      <button class=\"day-button\">12</button>\n      <button class=\"day-button\">13</button>\n      <button class=\"day-button active\">14</button>\n      <button class=\"day-button\">15</button>\n      <button class=\"day-button\">16</button>\n      <button class=\"day-button\">17</button>\n      <button class=\"day-button\">18</button>\n      <button class=\"day-button\">19</button>\n      <button class=\"day-button\">20</button>\n      <button class=\"day-button\">21</button>\n      <button class=\"day-button\">22</button>\n      <button class=\"day-button\">23</button>\n      <button class=\"day-button\">24</button>\n      <button class=\"day-button\">25</button>\n      <button class=\"day-button\">26</button>\n      <button class=\"day-button\">27</button>\n      <button class=\"day-button\">28</button>\n      <button class=\"day-button\">29</button>\n      <button class=\"day-button\">30</button>\n      <button class=\"day-button\">31</button>\n    </div>\n  </div>\n\n  <!-- Time Selection Section -->\n  <div class=\"booking-time-section\">\n    <div class=\"time-header\">\n      <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#688F9D\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><polyline points=\"12 6 12 12 16 14\"/></svg>\n      <h3 class=\"time-title\">Available Times</h3>\n    </div>\n    \n    <div class=\"time-slots\">\n      <button class=\"time-button\">09:00 AM</button>\n      <button class=\"time-button active\">11:00 AM</button>\n      <button class=\"time-button\">01:00 PM</button>\n      <button class=\"time-button\">03:00 PM</button>\n      <button class=\"time-button\">05:00 PM</button>\n      <button class=\"time-button\">07:00 PM</button>\n    </div>\n    \n    <div class=\"booking-confirm\">\n      <button type=\"button\" class=\"confirm-button\">CONFIRM RESERVATION</button>\n      <p class=\"confirm-note\">No credit card required today</p>\n    </div>\n  </div>\n</div>\n\n<style>\n.booking-ui-container {\n  display: grid;\n  grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);\n  background-color: #FFFFFF;\n  border-radius: 32px;\n  box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);\n  border: 1px solid rgba(14, 27, 48, 0.05);\n  overflow: hidden;\n  width: 100%;\n  box-sizing: border-box;\n}\n\n/* Calendar Layout */\n.booking-calendar-section {\n  padding: 3rem 4rem;\n  background-color: #FFFFFF;\n  box-sizing: border-box;\n}\n\n.calendar-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-bottom: 3rem;\n}\n\n.calendar-title {\n  font-family: 'Cormorant Garamond', serif;\n  font-size: 24px;\n  color: #1D3152;\n  margin: 0 0 0.25rem 0;\n  font-weight: 400;\n}\n\n.calendar-subtitle {\n  font-family: 'Lato', sans-serif;\n  font-size: 14px;\n  color: rgba(29, 49, 82, 0.4);\n  text-transform: uppercase;\n  letter-spacing: 0.1em;\n  margin: 0;\n  font-weight: 500;\n}\n\n.calendar-nav {\n  display: flex;\n  gap: 1rem;\n}\n\n.nav-button {\n  padding: 0.5rem;\n  border-radius: 9999px;\n  border: 1px solid rgba(29, 49, 82, 0.1);\n  background: transparent;\n  color: #1D3152;\n  cursor: pointer;\n  transition: all 0.3s ease;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n\n.nav-button:hover {\n  background-color: #1D3152;\n  color: #FFFFFF;\n}\n\n.calendar-grid {\n  display: grid;\n  grid-template-columns: repeat(7, 1fr);\n  gap: 1rem;\n}\n\n.weekday {\n  font-family: 'Lato', sans-serif;\n  font-size: 12px;\n  text-transform: uppercase;\n  font-weight: 700;\n  color: rgba(14, 27, 48, 0.3);\n  text-align: center;\n  padding: 1rem 0;\n  letter-spacing: 0.1em;\n}\n\n.day-cell {\n  aspect-ratio: 1 / 1;\n}\n\n.day-button {\n  aspect-ratio: 1 / 1;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  border-radius: 16px;\n  font-family: 'Lato', sans-serif;\n  font-size: 14px;\n  border: 1px solid transparent;\n  background: transparent;\n  color: #0E1B30;\n  cursor: pointer;\n  transition: all 0.5s ease;\n}\n\n.day-button:hover:not(.active) {\n  background-color: #F7F0EC;\n  border-color: rgba(14, 27, 48, 0.05);\n}\n\n.day-button.active {\n  background-color: #688F9D;\n  color: #FFFFFF;\n  box-shadow: 0 10px 15px -3px rgba(104, 143, 157, 0.2), 0 4px 6px -2px rgba(104, 143, 157, 0.1);\n  transform: scale(1.1);\n}\n\n/* Time Selection Layout */\n.booking-time-section {\n  padding: 3rem 4rem;\n  background-color: rgba(247, 240, 236, 0.5);\n  border-left: 1px solid rgba(14, 27, 48, 0.05);\n  display: flex;\n  flex-direction: column;\n  box-sizing: border-box;\n}\n\n.time-header {\n  display: flex;\n  align-items: center;\n  gap: 0.5rem;\n  margin-bottom: 2.5rem;\n  color: #0E1B30;\n}\n\n.time-title {\n  font-family: 'Cormorant Garamond', serif;\n  font-size: 20px;\n  margin: 0;\n  font-weight: 400;\n}\n\n.time-slots {\n  display: flex;\n  flex-direction: column;\n  gap: 0.75rem;\n  flex-grow: 1;\n}\n\n.time-button {\n  width: 100%;\n  padding: 1rem 1.5rem;\n  border-radius: 16px;\n  font-family: 'Lato', sans-serif;\n  font-size: 14px;\n  font-weight: 700;\n  letter-spacing: 0.1em;\n  text-transform: uppercase;\n  cursor: pointer;\n  transition: all 0.5s ease;\n  border: 1px solid rgba(29, 49, 82, 0.05);\n  background-color: #FFFFFF;\n  color: #1D3152;\n  box-sizing: border-box;\n}\n\n.time-button:hover:not(.active) {\n  border-color: #688F9D;\n  color: #688F9D;\n}\n\n.time-button.active {\n  background-color: #1D3152;\n  color: #F7F0EC;\n  border-color: #1D3152;\n  box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);\n}\n\n.booking-confirm {\n  margin-top: 3rem;\n  padding-top: 3rem;\n  border-top: 1px solid rgba(14, 27, 48, 0.1);\n}\n\n.confirm-button {\n  width: 100%;\n  padding: 1.25rem;\n  background-color: #688F9D;\n  color: #FFFFFF;\n  border-radius: 9999px;\n  border: none;\n  font-family: 'Lato', sans-serif;\n  font-size: 12px;\n  font-weight: 700;\n  text-transform: uppercase;\n  letter-spacing: 0.2em;\n  cursor: pointer;\n  transition: all 0.5s ease;\n  box-shadow: 0 10px 15px -3px rgba(104, 143, 157, 0.2), 0 4px 6px -2px rgba(104, 143, 157, 0.1);\n  box-sizing: border-box;\n}\n\n.confirm-button:hover {\n  transform: scale(1.02);\n}\n\n.confirm-note {\n  font-family: 'Lato', sans-serif;\n  font-size: 10px;\n  text-align: center;\n  color: rgba(29, 49, 82, 0.4);\n  margin: 1.5rem 0 0 0;\n  text-transform: uppercase;\n  letter-spacing: 0.1em;\n}\n\n@media (max-width: 1024px) {\n  .booking-ui-container {\n    grid-template-columns: 1fr;\n  }\n  .booking-calendar-section {\n    padding: 2rem;\n  }\n  .booking-time-section {\n    padding: 2rem;\n    border-left: none;\n    border-top: 1px solid rgba(14, 27, 48, 0.05);\n  }\n}\n</style>"
                    }
                }
            ]
        }
