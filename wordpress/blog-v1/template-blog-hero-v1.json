                        "html": "<div class='stillness-hero'><div class='stillness-hero-bg'><img src='https://images.unsplash.com/photo-1499209974431-9dddcece7f88?q=80&w=2000&auto=format&fit=crop' alt='The Journal' /><div class='stillness-hero-overlay'></div></div><div class='stillness-hero-content'><div class='stillness-hero-text-wrap'><span class='stillness-hero-label'>The Journal</span><h1 class='stillness-hero-title'>Notes on <span class='italic'>Stillness</span></h1><p class='stillness-hero-subtitle'>Thoughts on healing, ritual, and the profound art of coming home to yourself.</p></div><div class='stillness-hero-scroll'><svg class='stillness-bounce' width='32' height='32' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><polyline points='6 9 12 15 18 9'></polyline></svg></div></div></div><style>.stillness-hero { position: relative; height: 100vh; width: 100%; overflow: hidden; display: flex; align-items: center; justify-content: center; color: #FFFFFF; background-color: #0E1B30; }.stillness-hero-bg { position: absolute; inset: 0; z-index: 0; }.stillness-hero-bg img { width: 100%; height: 100%; object-fit: cover; opacity: 0.6; }.stillness-hero-overlay { position: absolute; inset: 0; background: linear-gradient(to bottom, rgba(14, 27, 48, 0.4) 0%, transparent 50%, rgba(14, 27, 48, 0.8) 100%); }.stillness-hero-content { position: relative; z-index: 10; text-align: center; padding: 0 24px; width: 100%; height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; }.stillness-hero-text-wrap { max-width: 900px; opacity: 0; transform: translateY(30px); animation: stillnessFadeUp 1.5s ease-out forwards; }.stillness-hero-label { display: block; font-family: 'Lato', sans-serif !important; font-size: 14px !important; font-weight: 700 !important; text-transform: uppercase; letter-spacing: 3px; color: #688F9D !important; margin-bottom: 16px; }.stillness-hero-title { font-family: 'Cormorant Garamond', serif !important; font-size: 80px !important; font-weight: 400 !important; margin-bottom: 24px; line-height: 1.1 !important; letter-spacing: -0.02em; color: #FFFFFF !important; }\n@media (min-width: 768px) { .stillness-hero-title { font-size: 128px !important; line-height: 1 !important; } }.stillness-hero-title .italic { font-style: italic; }@media (max-width: 768px) { .stillness-hero-title { font-size: 64px !important; } }.stillness-hero-subtitle { font-family: 'Lato', sans-serif !important; font-size: 1.125rem !important; font-weight: 300 !important; color: rgba(255, 255, 255, 0.8) !important; max-width: 512px; margin: 0 auto; line-height: 1.625 !important; }\n@media (min-width: 768px) { .stillness-hero-subtitle { font-size: 1.25rem !important; } }.stillness-hero-scroll { position: absolute; bottom: 48px; left: 50%; transform: translateX(-50%); color: rgba(255, 255, 255, 0.5); opacity: 0; animation: stillnessFadeIn 1s ease-out 1.5s forwards; }.stillness-bounce { animation: stillnessBounce 2s infinite; }@keyframes stillnessFadeUp { from { opacity: 0; transform: translateY(30px); } to { opacity: 1; transform: translateY(0); } }@keyframes stillnessFadeIn { from { opacity: 0; } to { opacity: 1; } }@keyframes stillnessBounce { 0%, 20%, 50%, 80%, 100% {transform: translateY(0);} 40% {transform: translateY(-10px);} 60% {transform: translateY(-5px);} }</style>"
