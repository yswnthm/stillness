                    "settings": {
                        "html": "<div class='b-nl-card'><div class='b-nl-text'><div class='b-nl-icon'><i class='fas fa-book-open'></i></div><h3 class='b-nl-title'>Stillness, delivered.</h3><p class='b-nl-desc'>New essays on healing, ritual, and presence, written for the quiet hours. Join the readers who begin their week with a little more ease.</p></div><form class='b-nl-form' onsubmit='event.preventDefault()'><input type='email' placeholder='your@email.com' class='b-nl-input' /><button type='submit' class='b-nl-submit'>Subscribe</button></form></div><style>@import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=Lato:wght@300;400;700&display=swap'); .b-nl-card { display: flex; flex-direction: column; align-items: center; justify-content: space-between; gap: 32px; background-color: #688F9D; border-radius: 24px; padding: 40px; box-shadow: 0 20px 25px -5px rgba(104, 143, 157, 0.1), 0 10px 10px -5px rgba(104, 143, 157, 0.04); } @media (min-width: 768px) { .b-nl-card { flex-direction: row; padding: 56px; gap: 48px; } } .b-nl-text { flex: 1; } .b-nl-icon { font-size: 40px; color: #FFFFFF; opacity: 0.8; margin-bottom: 16px; display: flex; justify-content: flex-start; } .b-nl-icon svg { width: 40px; height: 40px; } .b-nl-title { font-family: 'Cormorant Garamond', serif !important; font-size: 32px !important; color: #FFFFFF !important; margin: 0 0 8px; line-height: 1.3 !important; font-weight: 400 !important; } @media (min-width: 768px) { .b-nl-title { font-size: 40px !important; } } .b-nl-desc { font-family: 'Lato', sans-serif !important; font-size: 16px !important; font-weight: 300 !important; color: rgba(255, 255, 255, 0.8) !important; line-height: 1.625 !important; max-width: 448px; margin: 0; } .b-nl-form { display: flex; flex-direction: column; width: 100%; gap: 12px; margin: 0 !important; padding: 0 !important; } @media (min-width: 480px) { .b-nl-form { flex-direction: row; min-width: 320px; width: auto; } } .b-nl-input { flex: 1; background: rgba(255, 255, 255, 0.1) !important; border: 1px solid rgba(255, 255, 255, 0.2) !important; border-radius: 9999px !important; padding: 12px 24px !important; color: #FFFFFF !important; font-family: 'Lato', sans-serif !important; font-size: 14px !important; outline: none !important; transition: border-color 0.3s ease; height: auto !important; margin: 0 !important; line-height: 1.5 !important; box-shadow: none !important; min-height: 48px !important; } .b-nl-input::placeholder { color: rgba(255, 255, 255, 0.6) !important; opacity: 1 !important; } .b-nl-input:focus { border-color: rgba(255, 255, 255, 0.4) !important; background: rgba(255, 255, 255, 0.15) !important; } .b-nl-submit { flex-shrink: 0; background: #FFFFFF !important; color: #688F9D !important; border-radius: 9999px !important; padding: 12px 24px !important; font-family: 'Lato', sans-serif !important; font-size: 12px !important; font-weight: 700 !important; text-transform: uppercase !important; letter-spacing: 0.1em !important; border: none !important; cursor: pointer; transition: all 0.3s ease; display: inline-flex !important; justify-content: center !important; align-items: center !important; height: auto !important; margin: 0 !important; min-height: 48px !important; } .b-nl-submit:hover { background: #0E1B30 !important; color: #FFFFFF !important; }</style>"
