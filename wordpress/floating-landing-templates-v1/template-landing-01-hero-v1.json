            "html": "<nav class=\"floating-nav\">\n  <a href=\"/\" class=\"nav-logo\">Stillness</a>\n  <a href=\"#notify\" class=\"nav-cta\">Reserve my space</a>\n</nav>\n\n<section class=\"hero\">\n  <img class=\"hero-img\" src=\"\" alt=\"\" loading=\"eager\">\n  <div class=\"hero-overlay\"></div>\n  <div class=\"hero-content\">\n    <p class=\"hero-eyebrow\">Vancouver · Summer 2025 · Open Water Sound Journey</p>\n    <h1 class=\"hero-title\">Float.<br><em>into sound.</em></h1>\n    <p class=\"hero-sub\">An open-water sound bath unlike anything you've experienced. Water beneath you. Sky above. Sound moving through everything.</p>\n    <div class=\"hero-btns\">\n      <a href=\"#notify\" class=\"btn-p\">Hold my space for summer</a>\n      <a href=\"#what\" class=\"btn-g\">What is this?</a>\n    </div>\n  </div>\n  <div class=\"scroll-hint\">\n    <span>Scroll</span>\n    <div class=\"scroll-line\"></div>\n  </div>\n</section>\n\n<style>\n*,*::before,*::after{margin:0;padding:0;box-sizing:border-box !important}\nhtml{scroll-behavior:smooth !important}\n\n:root {\n  --stone:#0E1B30;--midnight:#1D3152;--seafoam:#688F9D;\n  --wave:#A4B2BA;--breeze:#D9E8EB;--sand:#C4BBB4;--cream:#F7F0EC;\n}\n\n.floating-nav {\n  display: flex !important;\n  justify-content: space-between !important;\n  align-items: center !important;\n  padding: 1.75rem 4rem !important;\n  position: absolute !important;\n  top: 0 !important;\n  left: 0 !important;\n  right: 0 !important;\n  z-index: 100 !important;\n  background: linear-gradient(to bottom, rgba(14,27,48,0.92) 0%, transparent 100%) !important;\n}\n\n.nav-logo {\n  font-family: 'Cormorant Garamond', serif !important;\n  font-size: 1.35rem !important;\n  font-weight: 300 !important;\n  letter-spacing: 0.18em !important;\n  color: var(--cream) !important;\n  text-transform: uppercase !important;\n  text-decoration: none !important;\n}\n\n.nav-cta {\n  font-family: 'Jost', sans-serif !important;\n  font-size: 0.72rem !important;\n  font-weight: 400 !important;\n  letter-spacing: 0.2em !important;\n  text-transform: uppercase !important;\n  color: var(--stone) !important;\n  background: var(--breeze) !important;\n  border: none !important;\n  padding: 0.7rem 1.6rem !important;\n  cursor: pointer !important;\n  transition: all 0.3s ease !important;\n  text-decoration: none !important;\n}\n\n.nav-cta:hover {\n  background: var(--cream) !important;\n}\n\n.hero {\n  position: relative;\n  height: 100vh;\n  min-height: 640px;\n  display: flex !important;\n  align-items: flex-end !important;\n  overflow: hidden !important;\n  margin: 0 !important;\n}\n\n.hero-img {\n  position: absolute !important;\n  inset: 0 !important;\n  width: 100% !important;\n  height: 100% !important;\n  object-fit: cover !important;\n  object-position: center top !important;\n}\n\n.hero-overlay {\n  position: absolute !important;\n  inset: 0 !important;\n  background: linear-gradient(to top, rgba(14, 27, 48, 0.92) 0%, rgba(14, 27, 48, 0.35) 50%, rgba(14, 27, 48, 0.15) 100%) !important;\n}\n\n.hero-content {\n  position: relative !important;\n  z-index: 2 !important;\n  padding: 0 4rem 6rem !important;\n  max-width: 800px !important;\n}\n\n.hero-eyebrow {\n  font-family: 'Jost', sans-serif !important;\n  font-size: 0.68rem !important;\n  letter-spacing: 0.4em !important;\n  text-transform: uppercase !important;\n  color: var(--seafoam) !important;\n  margin-bottom: 1.75rem !important;\n  display: block;\n  opacity: 0;\n  animation: fadeUp 1s ease 0.4s forwards;\n}\n\n.hero-title {\n  font-family: 'Cormorant Garamond', serif !important;\n  font-size: clamp(4rem, 10vw, 8rem) !important;\n  font-weight: 300 !important;\n  line-height: 0.9 !important;\n  color: var(--cream) !important;\n  margin-bottom: 1.5rem !important;\n  opacity: 0;\n  animation: fadeUp 1s ease 0.7s forwards;\n}\n\n.hero-title em {\n  font-style: italic !important;\n  color: var(--wave) !important;\n  display: block !important;\n}\n\n.hero-sub {\n  font-family: 'Cormorant Garamond', serif !important;\n  font-size: clamp(1rem, 2vw, 1.45rem) !important;\n  font-style: italic !important;\n  font-weight: 300 !important;\n  color: var(--wave) !important;\n  max-width: 520px !important;\n  line-height: 1.65 !important;\n  margin-bottom: 2.5rem !important;\n  opacity: 0;\n  animation: fadeUp 1s ease 1s forwards;\n}\n\n.hero-btns {\n  display: flex !important;\n  gap: 1rem !important;\n  flex-wrap: wrap !important;\n  opacity: 0;\n  animation: fadeUp 1s ease 1.3s forwards;\n}\n\n.btn-p {\n  font-family: 'Jost', sans-serif !important;\n  font-size: 0.72rem !important;\n  font-weight: 400 !important;\n  letter-spacing: 0.22em !important;\n  text-transform: uppercase !important;\n  color: var(--stone) !important;\n  background: var(--breeze) !important;\n  border: none !important;\n  padding: 1rem 2.5rem !important;\n  cursor: pointer !important;\n  transition: all 0.3s ease !important;\n  text-decoration: none !important;\n  display: inline-block !important;\n}\n\n.btn-p:hover {\n  background: var(--cream) !important;\n  transform: translateY(-2px) !important;\n}\n\n.btn-g {\n  font-family: 'Jost', sans-serif !important;\n  font-size: 0.68rem !important;\n  letter-spacing: 0.22em !important;\n  text-transform: uppercase !important;\n  color: var(--wave) !important;\n  background: transparent !important;\n  border: 0.5px solid rgba(164,178,186,0.4) !important;\n  padding: 1rem 2.5rem !important;\n  cursor: pointer !important;\n  transition: all 0.3s ease !important;\n  text-decoration: none !important;\n  display: inline-block !important;\n}\n\n.btn-g:hover {\n  border-color: var(--wave) !important;\n  color: var(--cream) !important;\n}\n\n.scroll-hint {\n  position: absolute !important;\n  bottom: 2.5rem !important;\n  right: 4rem !important;\n  z-index: 2 !important;\n  display: flex !important;\n  flex-direction: column !important;\n  align-items: center !important;\n  gap: 0.5rem !important;\n  opacity: 0;\n  animation: fadeUp 1s ease 1.8s forwards;\n}\n\n.scroll-hint span {\n  font-family: 'Jost', sans-serif !important;\n  font-size: 0.58rem !important;\n  letter-spacing: 0.35em !important;\n  text-transform: uppercase !important;\n  color: var(--seafoam) !important;\n  writing-mode: vertical-rl !important;\n}\n\n.scroll-line {\n  width: 0.5px !important;\n  height: 56px !important;\n  background: linear-gradient(to bottom, transparent, var(--seafoam)) !important;\n  animation: scrollPulse 2s ease-in-out infinite !important;\n}\n\n@keyframes fadeUp { from { opacity: 0; transform: translateY(22px); } to { opacity: 1; transform: translateY(0); } }\n@keyframes scrollPulse { 0%, 100% { opacity: 0.4; } 50% { opacity: 1; } }\n\n@media (max-width: 768px) {\n  .floating-nav { padding: 1.5rem 1.5rem !important; }\n  .hero-content { padding: 0 1.5rem 5rem !important; }\n  .scroll-hint { display: none !important; }\n}\n</style>"
