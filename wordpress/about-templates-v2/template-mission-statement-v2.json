                            "settings": {
                                "html": "<div class='mission-wrap'>\n  <span class='mission-label'>Our Mission</span>\n  <h2 class='mission-title'>Healing isn't a destination.<br />But you have to <i>start somewhere.</i></h2>\n  <div class='mission-divider'></div>\n  <p class='mission-desc'>Stillness exists because healing is real work &mdash; and everyone deserves a place to do it. Whether you're just curious or you've been waiting a long time, you're welcome here.</p>\n</div>\n<style>\n.mission-wrap {\n    text-align: center;\n    max-width: 900px;\n    margin: 0 auto;\n}\n.mission-label {\n    display: block;\n    font-family: 'Lato', sans-serif !important;\n    font-size: 14px !important;\n    text-transform: uppercase !important;\n    letter-spacing: 0.3em !important;\n    font-weight: 700 !important;\n    color: #688F9D !important;\n    margin-bottom: 32px !important;\n}\n.mission-title {\n    font-family: 'Cormorant Garamond', serif !important;\n    font-size: 60px !important;\n    font-weight: 300 !important;\n    color: #F7F0EC !important;\n    line-height: 1.2 !important;\n    margin: 0 0 40px !important;\n    letter-spacing: -0.01em !important;\n}\n.mission-title i {\n    font-style: italic !important;\n}\n@media (max-width: 767px) {\n    .mission-title { font-size: 36px !important; }\n}\n.mission-divider {\n    width: 96px;\n    height: 1px;\n    background: rgba(247, 240, 236, 0.3) !important;\n    margin: 0 auto 40px !important;\n}\n.mission-desc {\n    font-family: 'Lato', sans-serif !important;\n    font-size: 24px !important;\n    font-weight: 300 !important;\n    line-height: 1.625 !important;\n    color: rgba(217, 232, 235, 0.7) !important;\n    margin: 0 auto !important;\n    max-width: 42rem !important;\n}\n@media (max-width: 767px) {\n    .mission-desc { font-size: 20px !important; }\n}\n</style>"
