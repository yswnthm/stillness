                            "settings": {
                                "html": "<div class='mission-wrap'>\n  <span class='mission-label'>Our Mission</span>\n  <h2 class='mission-title'>Healing isn't a destination.<br />But you have to <i>start somewhere.</i></h2>\n  <div class='mission-divider'></div>\n  <p class='mission-desc'>Stillness exists because healing is real work &mdash; and everyone deserves a place to do it. Whether you're just curious or you've been waiting a long time, you're welcome here.</p>\n</div>\n<style>\n.mission-wrap { text-align: center; max-width: 800px; margin: 0 auto; }\n.mission-label { display: block; font-family: 'Lato', sans-serif; font-size: 14px; text-transform: uppercase; letter-spacing: 3px; font-weight: 700; color: #688F9D; margin-bottom: 32px; }\n.mission-title { font-family: 'Cormorant Garamond', serif; font-size: 64px; color: #F7F0EC; line-height: 1.1; margin: 0 0 40px; }\n.mission-title i { font-style: italic; }\n@media (max-width: 768px) { .mission-title { font-size: 40px; } }\n.mission-divider { width: 96px; height: 1px; background: rgba(247, 240, 236, 0.3); margin: 0 auto 40px; }\n.mission-desc { font-family: 'Lato', sans-serif; font-size: 24px; font-weight: 300; line-height: 1.6; color: rgba(217, 232, 235, 0.7); margin: 0; }\n@media (max-width: 768px) { .mission-desc { font-size: 20px; } }\n</style>"
