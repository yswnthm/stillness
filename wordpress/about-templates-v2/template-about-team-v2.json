            "elements": [
                {
                    "id": "team-heading",
                    "elType": "widget",
                    "widgetType": "heading",
                    "settings": {
                        "title": "Founder",
                        "align": "center",
                        "title_color": "#1D3152",
                        "typography_typography": "custom",
                        "typography_font_family": "Cormorant Garamond",
                        "typography_font_size": {
                            "unit": "px",
                            "size": 40
                        },
                        "typography_font_weight": "400",
