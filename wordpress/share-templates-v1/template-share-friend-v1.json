          "settings": {
            "html": "<section class=\"share-friend-section\">\n    <div class=\"dot-pattern\"></div>\n    <div class=\"share-friend-container\">\n        <h2 class=\"share-friend-title\">Share with a Friend</h2>\n        \n        <div class=\"share-friend-divider\">\n            <span class=\"divider-line\"></span>\n            <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"divider-icon\"><rect x=\"3\" y=\"8\" width=\"18\" height=\"4\" rx=\"1\"/><path d=\"M12 8v13\"/><path d=\"M19 12v7a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-7\"/><path d=\"M7.5 8a2.5 2.5 0 0 1 0-5A4.8 8 0 0 1 12 8a4.8 8 0 0 1 4.5-5 2.5 2.5 0 0 1 0 5\"/></svg>\n            <span class=\"divider-line\"></span>\n        </div>\n\n        <p class=\"share-friend-lead\">\n            Sometimes the best gifts are the ones we tell our friends about. Copy the link below or tap to share it via text, email, or social.\n        </p>\n\n        <div class=\"share-friend-btns\">\n          <button onclick=\"navigator.clipboard.writeText('https://stillnesscuratedretreats.com'); const old = this.innerText; this.innerText = 'Copied!'; setTimeout(() => this.innerText = old, 2000);\" class=\"btn-share-friend\">\n            Copy Link\n          </button>\n          <button onclick=\"window.location.href='mailto:?subject=Found%20something%20beautiful&body=Hey,%20I%20came%20across%20this%20deck%20from%20Stillness%20and%20thought%20of%20you.%20They%20are%20tools%20for%20nervous%20system%20regulation%20and%20connection.%20Take%20a%20look:%20https://stillnesscuratedretreats.com';\" class=\"btn-share-friend\">\n            Share Via Email\n          </button>\n        </div>\n    </div>\n</section>\n\n<style>\n:root {\n  --stone: #0E1B30;\n  --midnightsea: #1D3152;\n  --seafoam: #688F9D;\n  --breeze: #D9E8EB;\n  --wave: #A4B2BA;\n  --sand: #C4BBB4;\n  --cream: #F7F0EC;\n  --white: #FFFFFF;\n}\n\n.share-friend-section {\n    position: relative !important;\n    padding: clamp(4rem, 10vw, 8rem) 1.5rem !important;\n    display: flex !important;\n    justify-content: center !important;\n    align-items: center !important;\n    background: var(--white) !important;\n    color: var(--stone) !important;\n    overflow: hidden !important;\n    -webkit-font-smoothing: antialiased !important;\n}\n\n.dot-pattern {\n    position: absolute !important;\n    inset: 0 !important;\n    background-image: radial-gradient(var(--stone) 0.6px, transparent 0.6px) !important;\n    background-size: 24px 24px !important;\n    opacity: 0.05 !important;\n    pointer-events: none !important;\n}\n\n.share-friend-container {\n    position: relative !important;\n    z-index: 10 !important;\n    max-width: 900px !important;\n    width: 100% !important;\n    margin: 0 auto !important;\n    display: flex !important;\n    flex-direction: column !important;\n    align-items: center !important;\n    text-align: center !important;\n}\n\n.share-friend-title {\n    font-family: 'Cormorant Garamond', serif !important;\n    font-size: clamp(2.5rem, 6vw, 4rem) !important;\n    color: var(--midnightsea) !important;\n    margin-bottom: 2.5rem !important;\n    line-height: 1.1 !important;\n}\n\n.share-friend-divider {\n    display: flex !important;\n    align-items: center !important;\n    gap: 1.5rem !important;\n    width: 100% !important;\n    max-width: 280px !important;\n    margin: 0 auto 3rem auto !important;\n}\n\n.divider-line {\n    height: 0.5px !important;\n    background: rgba(14, 27, 48, 0.18) !important;\n    flex: 1 !important;\n}\n\n.divider-icon {\n    color: rgba(14, 27, 48, 0.3) !important;\n}\n\n.share-friend-lead {\n    font-family: 'Lato', sans-serif !important;\n    font-size: 1.2rem !important;\n    line-height: 1.6 !important;\n    color: rgba(14, 27, 48, 0.8) !important;\n    font-weight: 300 !important;\n    margin: 0 auto 3.5rem auto !important;\n    max-width: 42rem !important;\n}\n\n.share-friend-btns {\n    display: flex !important;\n    flex-wrap: wrap !important;\n    justify-content: center !important;\n    gap: 1.5rem !important;\n    width: 100% !important;\n}\n\n.btn-share-friend {\n    font-family: 'Lato', sans-serif !important;\n    padding: 1.25rem 3rem !important;\n    background: var(--white) !important;\n    color: var(--stone) !important;\n    border: 0.5px solid var(--stone) !important;\n    border-radius: 0.75rem !important;\n    text-transform: uppercase !important;\n    letter-spacing: 0.25em !important;\n    font-size: 0.7rem !important;\n    font-weight: 700 !important;\n    cursor: pointer !important;\n    transition: all 0.3s ease !important;\n    min-width: 240px !important;\n    box-shadow: 0 10px 20px rgba(0, 0, 0, 0.05) !important;\n}\n\n.btn-share-friend:hover {\n    background: var(--stone) !important;\n    color: var(--white) !important;\n    box-shadow: 0 15px 30px rgba(14, 27, 48, 0.15) !important;\n    transform: translateY(-2px) !important;\n}\n\n@media (max-width: 768px) {\n    .share-friend-section {\n        padding: 4rem 1.25rem !important;\n    }\n    .btn-share-friend {\n        width: 100% !important;\n        min-width: auto !important;\n    }\n    .share-friend-btns {\n        flex-direction: column !important;\n        gap: 1rem !important;\n    }\n}\n\n::-webkit-scrollbar { width: 8px; }\n::-webkit-scrollbar-track { background: #F7F0EC; }\n::-webkit-scrollbar-thumb { background: #C4BBB4; border-radius: 4px; }\n::-webkit-scrollbar-thumb:hover { background: #688F9D; }\n</style>"
