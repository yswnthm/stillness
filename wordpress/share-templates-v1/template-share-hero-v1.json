          "id": "html_hero",
          "elType": "widget",
          "settings": {
            "html": "<div class=\"noise-overlay\"></div>\n\n<section class=\"share-hero\">\n  <div class=\"share-hero-container\">\n    <h1 class=\"share-hero-title\">\n      Loved It? <span class=\"share-hero-highlight\">Share</span> It.\n    </h1>\n    \n    <div class=\"share-hero-text-wrap\">\n      <p class=\"share-hero-lead\">\n        If this little deck made a big difference, it's your turn to share the magic.\n      </p>\n      <p class=\"share-hero-desc\">\n        Whether it brought more calm to your mornings, sparked a beautiful bedtime ritual, or helped your child feel seen—thank you for welcoming this deck into your home.\n      </p>\n      <p class=\"share-hero-desc secondary\">\n        We believe in the ripple effect of kindness. Pass it on:\n      </p>\n    </div>\n  </div>\n\n  <div class=\"share-hero-scroll\">\n    <span>Scroll</span>\n    <div class=\"scroll-line\"></div>\n  </div>\n</section>\n\n<style>\n:root {\n  --stone: #0E1B30;\n  --midnightsea: #1D3152;\n  --seafoam: #688F9D;\n  --breeze: #D9E8EB;\n  --wave: #A4B2BA;\n  --sand: #C4BBB4;\n  --cream: #F7F0EC;\n}\n\n.noise-overlay {\n  position: fixed !important;\n  top: 0 !important;\n  left: 0 !important;\n  width: 100% !important;\n  height: 100% !important;\n  pointer-events: none !important;\n  opacity: 0.04 !important;\n  z-index: 9999 !important;\n  background-image: url(\"data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E\") !important;\n}\n\n.share-hero {\n  position: relative !important;\n  min-height: 100vh !important;\n  display: flex !important;\n  flex-direction: column !important;\n  align-items: center !important;\n  justify-content: center !important;\n  text-align: center !important;\n  padding: 80px 24px !important;\n  background-color: #ECE0D1 !important;\n  background-image: url('https://images.unsplash.com/photo-1607344645866-009c320c62ab?q=80&w=2000&auto=format&fit=crop') !important;\n  background-size: cover !important;\n  background-position: center !important;\n  background-blend-mode: overlay !important;\n  -webkit-font-smoothing: antialiased !important;\n  color: var(--stone) !important;\n}\n\n.share-hero-container {\n  max-width: 1000px !important;\n  margin: 0 auto !important;\n  z-index: 10 !important;\n  display: flex !important;\n  flex-direction: column !important;\n  gap: 3rem !important;\n}\n\n.share-hero-title {\n  font-family: 'Cormorant Garamond', serif !important;\n  font-size: clamp(3.5rem, 10vw, 6.5rem) !important;\n  font-weight: 500 !important;\n  line-height: 1.05 !important;\n  color: var(--midnightsea) !important;\n  margin: 0 !important;\n}\n\n.share-hero-highlight {\n  color: var(--seafoam) !important;\n  display: inline-block !important;\n  position: relative !important;\n}\n\n.share-hero-highlight::after {\n  content: '' !important;\n  position: absolute !important;\n  bottom: -4px !important;\n  left: 0 !important;\n  width: 100% !important;\n  height: 0.5px !important;\n  background: rgba(104, 143, 157, 0.4) !important;\n}\n\n.share-hero-text-wrap {\n  max-width: 768px !important;\n  margin: 0 auto !important;\n  display: flex !important;\n  flex-direction: column !important;\n  gap: 2rem !important;\n}\n\n.share-hero-lead {\n  font-family: 'Cormorant Garamond', serif !important;\n  font-size: clamp(1.5rem, 4vw, 1.8rem) !important;\n  line-height: 1.3 !important;\n  color: var(--stone) !important;\n  margin: 0 !important;\n}\n\n.share-hero-desc {\n  font-family: 'Lato', sans-serif !important;\n  font-size: 1.1rem !important;\n  line-height: 1.6 !important;\n  letter-spacing: 0.05em !important;\n  opacity: 0.9 !important;\n  font-weight: 300 !important;\n  margin: 0 !important;\n}\n\n.share-hero-desc.secondary {\n  font-size: 1.1rem !important;\n}\n\n.share-hero-scroll {\n  position: absolute !important;\n  bottom: 2.5rem !important;\n  left: 50% !important;\n  transform: translateX(-50%) !important;\n  display: flex !important;\n  flex-direction: column !important;\n  align-items: center !important;\n  gap: 0.5rem !important;\n  z-index: 10 !important;\n}\n\n.share-hero-scroll span {\n  font-family: 'Lato', sans-serif !important;\n  font-size: 0.6rem !important;\n  letter-spacing: 0.3em !important;\n  text-transform: uppercase !important;\n  color: var(--seafoam) !important;\n  writing-mode: vertical-rl !important;\n}\n\n.scroll-line {\n  width: 0.5px !important;\n  height: 50px !important;\n  background: linear-gradient(to bottom, transparent, var(--seafoam)) !important;\n}\n\n@media (max-width: 768px) {\n  .share-hero {\n    padding: 60px 20px !important;\n  }\n  .share-hero-container {\n    gap: 2rem !important;\n  }\n  .share-hero-scroll {\n     bottom: 2rem !important;\n  }\n}\n\n::-webkit-scrollbar { width: 8px; }\n::-webkit-scrollbar-track { background: #F7F0EC; }\n::-webkit-scrollbar-thumb { background: #C4BBB4; border-radius: 4px; }\n::-webkit-scrollbar-thumb:hover { background: #688F9D; }\n</style>"
          },
          "widgetType": "html"
        }
      ]
    }
