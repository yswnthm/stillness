            "html": "<section id=\"gift\" class=\"gift-section\">\n  <div class=\"gift-container\">\n    <div class=\"gift-content\">\n      <h2 class=\"gift-title\">Gift a Deck</h2>\n      \n      <div class=\"gift-divider\">\n        <span class=\"divider-line\"></span>\n        <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"divider-icon\"><rect x=\"3\" y=\"8\" width=\"18\" height=\"4\" rx=\"1\"/><path d=\"M12 8v13\"/><path d=\"M19 12v7a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-7\"/><path d=\"M7.5 8a2.5 2.5 0 0 1 0-5A4.8 8 0 0 1 12 8a4.8 8 0 0 1 4.5-5 2.5 2.5 0 0 1 0 5\"/></svg>\n        <span class=\"divider-line\"></span>\n      </div>\n\n      <p class=\"gift-lead\">\n        Know a family who'd love this? Send a deck to someone you love—shipped to you or directly to them, with an optional note.\n      </p>\n\n      <div class=\"gift-cta\">\n        <button class=\"btn-gift\">\n          Send a Deck\n        </button>\n      </div>\n    </div>\n    <div class=\"gift-image-wrap\">\n      <img src=\"https://images.unsplash.com/photo-1544367567-0f2fcb009e0b?q=80&w=1200&auto=format&fit=crop\" alt=\"The Deck\" class=\"gift-img\" />\n    </div>\n  </div>\n</section>\n\n<style>\n:root {\n  --stone: #0E1B30;\n  --midnightsea: #1D3152;\n  --seafoam: #688F9D;\n  --breeze: #D9E8EB;\n  --wave: #A4B2BA;\n  --sand: #C4BBB4;\n  --cream: #F7F0EC;\n  --white: #FFFFFF;\n}\n\n.gift-section {\n  padding: clamp(4rem, 8vw, 8rem) 1.5rem !important;\n  background: #F7F3F0 !important;\n  color: var(--stone) !important;\n  -webkit-font-smoothing: antialiased !important;\n}\n\n.gift-container {\n  max-width: 80rem !important;\n  margin: 0 auto !important;\n  display: grid !important;\n  grid-template-columns: 1fr 1fr !important;\n  gap: clamp(3rem, 8vw, 6rem) !important;\n  align-items: center !important;\n}\n\n.gift-content {\n  display: flex !important;\n  flex-direction: column !important;\n  align-items: flex-start !important;\n  text-align: left !important;\n}\n\n.gift-title {\n  font-family: 'Cormorant Garamond', serif !important;\n  font-size: clamp(3rem, 6vw, 4.5rem) !important;\n  color: var(--midnightsea) !important;\n  margin-bottom: 1.5rem !important;\n  line-height: 1.1 !important;\n}\n\n.gift-divider {\n  display: flex !important;\n  align-items: center !important;\n  gap: 1.5rem !important;\n  width: 100% !important;\n  max-width: 280px !important;\n  margin-bottom: 2.5rem !important;\n}\n\n.divider-line {\n  height: 0.5px !important;\n  background: rgba(14, 27, 48, 0.18) !important;\n  flex: 1 !important;\n}\n\n.divider-icon {\n  color: rgba(14, 27, 48, 0.3) !important;\n}\n\n.gift-lead {\n  font-family: 'Lato', sans-serif !important;\n  font-size: 1.2rem !important;\n  line-height: 1.6 !important;\n  color: rgba(14, 27, 48, 0.8) !important;\n  font-weight: 300 !important;\n  margin-bottom: 2.5rem !important;\n  max-width: 25rem !important;\n}\n\n.btn-gift {\n  font-family: 'Lato', sans-serif !important;\n  padding: 1.25rem 3.5rem !important;\n  background: var(--stone) !important;\n  color: var(--white) !important;\n  border-radius: 0.75rem !important;\n  text-transform: uppercase !important;\n  letter-spacing: 0.25em !important;\n  font-size: 0.7rem !important;\n  font-weight: 700 !important;\n  border: none !important;\n  cursor: pointer !important;\n  transition: all 0.3s ease !important;\n  box-shadow: 0 10px 15px -3px rgba(14, 27, 48, 0.2) !important;\n}\n\n.btn-gift:hover {\n  background: var(--seafoam) !important;\n  transform: translateY(-2px) !important;\n  box-shadow: 0 20px 25px -5px rgba(104, 143, 157, 0.2) !important;\n}\n\n.gift-image-wrap {\n  border-radius: 2.5rem !important;\n  overflow: hidden !important;\n  box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.12) !important;\n  aspect-ratio: 4/3 !important;\n  border: 0.5px solid rgba(14, 27, 48, 0.15) !important;\n}\n\n.gift-img {\n  width: 100% !important;\n  height: 100% !important;\n  object-fit: cover !important;\n}\n\n@media (max-width: 768px) {\n  .gift-container {\n    grid-template-columns: 1fr !important;\n    text-align: center !important;\n    gap: 3.5rem !important;\n  }\n  .gift-content {\n    align-items: center !important;\n    text-align: center !important;\n    order: 2 !important;\n  }\n  .gift-image-wrap {\n    order: 1 !important;\n    border-radius: 2rem !important;\n  }\n  .gift-section {\n    padding: 3.5rem 1.25rem !important;\n  }\n  .gift-divider {\n    margin-left: auto !important;\n    margin-right: auto !important;\n  }\n}\n\n::-webkit-scrollbar { width: 8px; }\n::-webkit-scrollbar-track { background: #F7F0EC; }\n::-webkit-scrollbar-thumb { background: #C4BBB4; border-radius: 4px; }\n::-webkit-scrollbar-thumb:hover { background: #688F9D; }\n</style>"
