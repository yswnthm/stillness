          "settings": {
            "html": "<section id=\"story\" class=\"py-32 px-6 md:px-12 max-w-[85rem] mx-auto bg-[#FBF9F6] text-stone antialiased font-sans\">\n  <div class=\"grid lg:grid-cols-[0.8fr_1.2fr] gap-0 rounded-[3rem] overflow-hidden border border-stone/10 bg-white shadow-2xl\">\n    <div class=\"relative min-h-[400px]\">\n      <img src=\"https://images.unsplash.com/photo-1543333995-a78ee9e53ac5?q=80&w=1200&auto=format&fit=crop\" alt=\"Sharing a story\" class=\"absolute inset-0 w-full h-full object-cover\" />\n      <div class=\"absolute inset-0 bg-stone/20\"></div>\n      <div class=\"absolute bottom-16 left-1/2 -translate-x-1/2 z-20\">\n          <div class=\"bg-white px-8 py-5 rounded-3xl rounded-bl-none shadow-2xl relative\">\n              <p class=\"text-2xl text-stone italic\" style=\"font-family: 'Cormorant Garamond', serif;\">Thinking of you.</p>\n              <div class=\"absolute -bottom-4 left-0 w-8 h-8 bg-white\" style=\"clip-path: polygon(0 0, 0% 100%, 100% 0);\"></div>\n          </div>\n      </div>\n    </div>\n    <div class=\"p-12 md:p-20 bg-[#FBF9F6]\">\n        <h2 class=\"text-[3.8rem] text-midnightsea mb-6 text-center\" style=\"font-family: 'Cormorant Garamond', serif;\">Tell Us Your Story</h2>\n        <div class=\"flex items-center gap-6 max-w-[280px] mx-auto mb-12\">\n            <span class=\"divider-line\"></span>\n            <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"text-stone/40\"><rect x=\"3\" y=\"8\" width=\"18\" height=\"4\" rx=\"1\"/><path d=\"M12 8v13\"/><path d=\"M19 12v7a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-7\"/><path d=\"M7.5 8a2.5 2.5 0 0 1 0-5A4.8 8 0 0 1 12 8a4.8 8 0 0 1 4.5-5 2.5 2.5 0 0 1 0 5\"/></svg>\n            <span class=\"divider-line\"></span>\n        </div>\n        <p class=\"text-xl leading-relaxed text-stone/70 font-light mb-12 text-center\" style=\"font-family: 'Lato', sans-serif;\">\n            We'd love to hear how this deck has touched your family...\n        </p>\n        <div class=\"metform-story-wrap\">\n            [metform form_id=\"INSERT_FORM_ID_HERE\"]\n        </div>\n    </div>\n  </div>\n</section>\n\n<script src=\"https://cdn.tailwindcss.com?plugins=typography\"></script>\n<script>\n  tailwind.config = {\n    theme: {\n      extend: {\n        colors: {\n          stone: '#0E1B30',\n          midnightsea: '#1D3152',\n          midnight: '#1D3152',\n          seafoam: '#688F9D',\n          breeze: '#D9E8EB',\n          wave: '#A4B2BA',\n          sand: '#C4BBB4',\n          cream: '#FFFFFF',\n          terracotta: '#C1785D',\n          sage: '#8A9A8A',\n          clay: '#D9C5B2',\n        }\n      }\n    }\n  }\n</script>\n<style>\n  ::-webkit-scrollbar { width: 8px; }\n  ::-webkit-scrollbar-track { background: #F7F0EC; }\n  ::-webkit-scrollbar-thumb { background: #C4BBB4; border-radius: 4px; }\n  ::-webkit-scrollbar-thumb:hover { background: #688F9D; }\n\n  .divider-line {\n    height: 1px;\n    background: rgba(14, 27, 48, 0.15);\n    flex: 1;\n  }\n  \n  .metform-story-wrap form {\n    display: flex !important;\n    flex-direction: column !important;\n    gap: 24px !important;\n  }\n  .metform-story-wrap .mf-input-wrapper {\n    margin-bottom: 0 !important;\n  }\n  .metform-story-wrap .mf-input-label {\n    display: block !important;\n    color: rgba(14, 27, 48, 0.7) !important;\n    font-family: 'Lato', sans-serif !important;\n    font-size: 16px !important;\n    margin-bottom: 8px !important;\n    font-weight: 400 !important;\n  }\n  .metform-story-wrap .mf-input {\n    width: 100% !important;\n    background-color: #ffffff !important;\n    border: 1px solid rgba(14, 27, 48, 0.2) !important;\n    padding: 16px 24px !important;\n    border-radius: 12px !important;\n    font-family: 'Lato', sans-serif !important;\n    font-size: 16px !important;\n    color: #0E1B30 !important;\n    box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05) !important;\n    transition: all 0.3s ease !important;\n    box-sizing: border-box !important;\n    min-height: auto !important;\n  }\n  .metform-story-wrap .mf-input:focus, .metform-story-wrap .mf-input:active {\n    outline: none !important;\n    border-color: #688F9D !important;\n  }\n  .metform-story-wrap textarea.mf-input {\n    resize: none !important;\n    min-height: 120px !important;\n  }\n  /* File Upload specific styling */\n  .metform-story-wrap input[type=\"file\"]::file-selector-button {\n    margin-right: 16px !important;\n    padding: 8px 16px !important;\n    border-radius: 6px !important;\n    border: none !important;\n    font-size: 14px !important;\n    font-weight: 500 !important;\n    background-color: rgba(14, 27, 48, 0.05) !important;\n    color: #0E1B30 !important;\n    cursor: pointer !important;\n    transition: background-color 0.2s !important;\n  }\n  .metform-story-wrap input[type=\"file\"]::file-selector-button:hover {\n    background-color: rgba(14, 27, 48, 0.1) !important;\n  }\n  .metform-story-wrap input[type=\"file\"] {\n    padding: 12px 16px !important;\n    color: rgba(14, 27, 48, 0.6) !important;\n  }\n  /* Submit Button styling */\n  .metform-story-wrap .mf-btn-wraper {\n    margin-top: 16px !important;\n    text-align: center !important;\n  }\n  @media (min-width: 768px) {\n    .metform-story-wrap .mf-btn-wraper {\n      text-align: left !important;\n    }\n  }\n  .metform-story-wrap .metform-btn {\n    width: 100% !important;\n    background-color: #688F9D !important;\n    color: #ffffff !important;\n    padding: 20px 64px !important;\n    border-radius: 12px !important;\n    text-transform: uppercase !important;\n    letter-spacing: 0.25em !important;\n    font-size: 11.2px !important;\n    font-weight: 700 !important;\n    font-family: 'Lato', sans-serif !important;\n    border: none !important;\n    box-shadow: 0 20px 25px -5px rgba(104, 143, 157, 0.2), 0 10px 10px -5px rgba(104, 143, 157, 0.1) !important;\n    transition: all 0.3s ease !important;\n    cursor: pointer !important;\n  }\n  @media (min-width: 768px) {\n    .metform-story-wrap .metform-btn {\n        width: auto !important;\n        display: inline-block !important;\n    }\n  }\n  .metform-story-wrap .metform-btn:hover {\n    background-color: #0E1B30 !important;\n  }\n  /* Hide MetForm default titles/labels we don't need */\n  .metform-story-wrap h2, .metform-story-wrap h3, .metform-story-wrap .mf-section-title {\n    display: none !important;\n  }\n</style>"
