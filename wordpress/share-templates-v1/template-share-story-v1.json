          "settings": {
            "html": "<section id=\"story\" class=\"story-section\">\n  <div class=\"story-card\">\n    <div class=\"story-image-wrap\">\n      <img src=\"https://images.unsplash.com/photo-1543333995-a78ee9e53ac5?q=80&w=1200&auto=format&fit=crop\" alt=\"Sharing a story\" class=\"story-img\" />\n      <div class=\"story-img-overlay\"></div>\n      <div class=\"story-bubble-wrap\">\n          <div class=\"story-bubble\">\n              <p class=\"story-bubble-text\">Thinking of you.</p>\n              <div class=\"story-bubble-tail\"></div>\n          </div>\n      </div>\n    </div>\n    <div class=\"story-content\">\n        <h2 class=\"story-title\">Tell Us Your Story</h2>\n        <div class=\"story-divider\">\n            <span class=\"divider-line\"></span>\n            <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"divider-icon\"><rect x=\"3\" y=\"8\" width=\"18\" height=\"4\" rx=\"1\"/><path d=\"M12 8v13\"/><path d=\"M19 12v7a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-7\"/><path d=\"M7.5 8a2.5 2.5 0 0 1 0-5A4.8 8 0 0 1 12 8a4.8 8 0 0 1 4.5-5 2.5 2.5 0 0 1 0 5\"/></svg>\n            <span class=\"divider-line\"></span>\n        </div>\n        <p class=\"story-lead\">\n            We'd love to hear how this deck has touched your family...\n        </p>\n        <div class=\"metform-story-wrap\">\n            [metform form_id=\"INSERT_FORM_ID_HERE\"]\n        </div>\n    </div>\n  </div>\n</section>\n\n<style>\n:root {\n  --stone: #0E1B30;\n  --midnightsea: #1D3152;\n  --seafoam: #688F9D;\n  --breeze: #D9E8EB;\n  --wave: #A4B2BA;\n  --sand: #C4BBB4;\n  --cream: #F7F0EC;\n  --white: #FFFFFF;\n}\n\n.story-section {\n  padding: clamp(4rem, 8vw, 8rem) 1.5rem !important;\n  max-width: 85rem !important;\n  margin: 0 auto !important;\n  background: #FBF9F6 !important;\n  color: var(--stone) !important;\n  -webkit-font-smoothing: antialiased !important;\n}\n\n.story-card {\n  display: grid !important;\n  grid-template-columns: 0.8fr 1.2fr !important;\n  gap: 0 !important;\n  border-radius: 3rem !important;\n  overflow: hidden !important;\n  border: 0.5px solid rgba(14, 27, 48, 0.15) !important;\n  background: var(--white) !important;\n  box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.08) !important;\n}\n\n.story-image-wrap {\n  position: relative !important;\n  min-height: 450px !important;\n}\n\n.story-img {\n  position: absolute !important;\n  inset: 0 !important;\n  width: 100% !important;\n  height: 100% !important;\n  object-fit: cover !important;\n}\n\n.story-img-overlay {\n  position: absolute !important;\n  inset: 0 !important;\n  background: rgba(14, 27, 48, 0.1) !important;\n}\n\n.story-bubble-wrap {\n  position: absolute !important;\n  bottom: 4rem !important;\n  left: 50% !important;\n  transform: translateX(-50%) !important;\n  z-index: 20 !important;\n  width: 100% !important;\n  display: flex !important;\n  justify-content: center !important;\n}\n\n.story-bubble {\n  background: var(--white) !important;\n  padding: 1.25rem 2rem !important;\n  border-radius: 2rem !important;\n  border-bottom-left-radius: 0 !important;\n  box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1) !important;\n  position: relative !important;\n  border: 0.5px solid rgba(14, 27, 48, 0.08) !important;\n}\n\n.story-bubble-text {\n  font-family: 'Cormorant Garamond', serif !important;\n  font-size: 1.5rem !important;\n  font-style: italic !important;\n  color: var(--stone) !important;\n  margin: 0 !important;\n  white-space: nowrap !important;\n}\n\n.story-bubble-tail {\n  position: absolute !important;\n  bottom: -1rem !important;\n  left: 0 !important;\n  width: 2rem !important;\n  height: 2rem !important;\n  background: var(--white) !important;\n  clip-path: polygon(0 0, 0% 100%, 100% 0) !important;\n  border-right: 0.5px solid rgba(14, 27, 48, 0.08) !important;\n}\n\n.story-content {\n  padding: clamp(3rem, 6vw, 5rem) clamp(2rem, 5vw, 5rem) !important;\n  background: #FBF9F6 !important;\n  display: flex !important;\n  flex-direction: column !important;\n  align-items: center !important;\n  text-align: center !important;\n}\n\n.story-title {\n  font-family: 'Cormorant Garamond', serif !important;\n  font-size: clamp(2.5rem, 5vw, 3.8rem) !important;\n  color: var(--midnightsea) !important;\n  margin-bottom: 1.5rem !important;\n  line-height: 1.1 !important;\n}\n\n.story-divider {\n  display: flex !important;\n  align-items: center !important;\n  gap: 1.5rem !important;\n  width: 100% !important;\n  max-width: 280px !important;\n  margin-bottom: 3rem !important;\n}\n\n.divider-line {\n  height: 0.5px !important;\n  background: rgba(14, 27, 48, 0.18) !important;\n  flex: 1 !important;\n}\n\n.divider-icon {\n  color: rgba(14, 27, 48, 0.3) !important;\n}\n\n.story-lead {\n  font-family: 'Lato', sans-serif !important;\n  font-size: 1.25rem !important;\n  line-height: 1.6 !important;\n  color: rgba(14, 27, 48, 0.7) !important;\n  font-weight: 300 !important;\n  margin-bottom: 3rem !important;\n  max-width: 500px !important;\n}\n\n.metform-story-wrap {\n  width: 100% !important;\n}\n\n.metform-story-wrap form {\n  display: flex !important;\n  flex-direction: column !important;\n  gap: 1.5rem !important;\n}\n\n.metform-story-wrap .mf-input-wrapper {\n  margin-bottom: 0 !important;\n}\n\n.metform-story-wrap .mf-input-label {\n  display: block !important;\n  color: rgba(14, 27, 48, 0.7) !important;\n  font-family: 'Lato', sans-serif !important;\n  font-size: 0.9rem !important;\n  margin-bottom: 0.5rem !important;\n  font-weight: 400 !important;\n  text-align: left !important;\n}\n\n.metform-story-wrap .mf-input {\n  width: 100% !important;\n  background-color: var(--white) !important;\n  border: 0.5px solid rgba(14, 27, 48, 0.15) !important;\n  padding: 1rem 1.5rem !important;\n  border-radius: 0.75rem !important;\n  font-family: 'Lato', sans-serif !important;\n  font-size: 1rem !important;\n  color: var(--stone) !important;\n  box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05) !important;\n  transition: all 0.3s ease !important;\n  box-sizing: border-box !important;\n}\n\n.metform-story-wrap .mf-input:focus {\n  outline: none !important;\n  border-color: var(--seafoam) !important;\n  box-shadow: 0 0 0 2px rgba(104, 143, 157, 0.1) !important;\n}\n\n.metform-story-wrap .metform-btn {\n  width: 100% !important;\n  background-color: var(--seafoam) !important;\n  color: var(--white) !important;\n  padding: 1.25rem 4rem !important;\n  border-radius: 0.75rem !important;\n  text-transform: uppercase !important;\n  letter-spacing: 0.25em !important;\n  font-size: 0.7rem !important;\n  font-weight: 700 !important;\n  font-family: 'Lato', sans-serif !important;\n  border: none !important;\n  box-shadow: 0 10px 15px -3px rgba(104, 143, 157, 0.2) !important;\n  transition: all 0.3s ease !important;\n  cursor: pointer !important;\n  margin-top: 1rem !important;\n}\n\n.metform-story-wrap .metform-btn:hover {\n  background-color: var(--stone) !important;\n  transform: translateY(-2px) !important;\n}\n\n@media (max-width: 1024px) {\n  .story-card {\n    grid-template-columns: 1fr !important;\n  }\n  .story-image-wrap {\n    min-height: 400px !important;\n  }\n}\n\n@media (max-width: 768px) {\n  .story-section {\n    padding: 3rem 1rem !important;\n  }\n  .story-card {\n    border-radius: 2rem !important;\n  }\n  .story-content {\n    padding: 3rem 1.5rem !important;\n  }\n  .story-bubble-text {\n    font-size: 1.25rem !important;\n  }\n}\n\n::-webkit-scrollbar { width: 8px; }\n::-webkit-scrollbar-track { background: #F7F0EC; }\n::-webkit-scrollbar-thumb { background: #C4BBB4; border-radius: 4px; }\n::-webkit-scrollbar-thumb:hover { background: #688F9D; }\n</style>"
