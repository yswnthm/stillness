                    "settings": {
                        "html": "<div class='cc-features-section'>\n    <div class='cc-features-bg-accent'></div>\n    <div class='cc-features-container'>\n        <div class='cc-features-header cc-reveal'>\n            <span class='cc-subtitle-cream'>What's Included</span>\n            <h2 class='cc-title-cream'>Crafted for your nervous system.</h2>\n        </div>\n\n        <div class='cc-features-grid'>\n            <div class='cc-feature-card cc-reveal cc-delay-1'>\n                <div class='cc-feature-icon'>\n                    <svg viewBox='0 0 24 24' width='32' height='32' stroke='#688F9D' stroke-width='2' fill='none' stroke-linecap='round' stroke-linejoin='round'><path d='M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z'></path><path d='m9 12 2 2 4-4'></path></svg>\n                </div>\n                <h3 class='cc-feature-title'>11 Private In-Home Sessions</h3>\n                <p class='cc-feature-text'>Transform your living room into a healing sanctuary. Each session is uniquely crafted based on your body's physical and emotional landscape that day.</p>\n            </div>\n\n            <div class='cc-feature-card cc-reveal cc-delay-2'>\n                <div class='cc-feature-icon'>\n                    <svg viewBox='0 0 24 24' width='32' height='32' stroke='#688F9D' stroke-width='2' fill='none' stroke-linecap='round' stroke-linejoin='round'><path d='M17.7 7.7a2.5 2.5 0 1 1 1.8 4.3H2'></path><path d='M9.6 4.6A2 2 0 1 1 11 8H2'></path><path d='M12.6 19.4A2 2 0 1 0 14 16H2'></path></svg>\n                </div>\n                <h3 class='cc-feature-title'>1 Floating Sound Bath</h3>\n                <p class='cc-feature-text'>An exclusive immersion in weightless sound therapy at Canada's first floating sanctuary. The ultimate nervous system reset.</p>\n            </div>\n\n            <div class='cc-feature-card cc-reveal cc-delay-3'>\n                <div class='cc-feature-icon'>\n                    <svg viewBox='0 0 24 24' width='32' height='32' stroke='#688F9D' stroke-width='2' fill='none' stroke-linecap='round' stroke-linejoin='round'><circle cx='12' cy='12' r='4'></circle><path d='M12 2v2'></path><path d='M12 20v2'></path><path d='m4.93 4.93 1.41 1.41'></path><path d='m17.66 17.66 1.41 1.41'></path><path d='M2 12h2'></path><path d='M20 12h2'></path><path d='m6.34 17.66-1.41 1.41'></path><path d='m19.07 4.93-1.41 1.41'></path></svg>\n                </div>\n                <h3 class='cc-feature-title'>Flexible Scheduling</h3>\n                <p class='cc-feature-text'>Priority booking tailored strictly around your demanding life. We work with your schedule to ensure consistency without added stress.</p>\n            </div>\n\n            <div class='cc-feature-card cc-reveal cc-delay-4'>\n                <div class='cc-feature-icon'>\n                    <svg viewBox='0 0 24 24' width='32' height='32' stroke='#688F9D' stroke-width='2' fill='none' stroke-linecap='round' stroke-linejoin='round'><path d='m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z'></path><path d='M5 3v4'></path><path d='M3 5h4'></path><path d='M21 17v4'></path><path d='M19 19h4'></path></svg>\n                </div>\n                <h3 class='cc-feature-title'>All Materials Provided</h3>\n                <p class='cc-feature-text'>From sustainable mats to ambient scents and sound healing tools, we bring everything needed to create a full sensory experience in your space.</p>\n            </div>\n        </div>\n    </div>\n</div>\n\n<style>\n.cc-features-section {\n    position: relative;\n    width: 100%;\n}\n\n.cc-features-bg-accent {\n    position: absolute;\n    top: 0;\n    right: 0;\n    width: 50%;\n    height: 100%;\n    background: rgba(14, 27, 48, 0.4);\n    transform: skewX(-12deg) translateX(25%);\n    z-index: 1;\n}\n\n.cc-features-container {\n    max-width: 1200px;\n    margin: 0 auto;\n    padding: 0 40px;\n    position: relative;\n    z-index: 2;\n}\n\n.cc-features-header {\n    text-align: center;\n    margin-bottom: 80px;\n}\n\n.cc-subtitle-cream {\n    display: block;\n    color: #688F9D !important;\n    font-family: 'Lato', sans-serif !important;\n    font-size: 14px !important;\n    text-transform: uppercase !important;\n    letter-spacing: 0.4em !important;\n    margin-bottom: 24px;\n}\n\n.cc-title-cream {\n    color: #F7F0EC !important;\n    font-family: 'Cormorant Garamond', serif !important;\n    font-size: 48px !important;\n    font-weight: 400 !important;\n    line-height: 1.2 !important;\n}\n\n.cc-features-grid {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 48px;\n}\n\n.cc-feature-card {\n    padding: 64px;\n    border-radius: 40px;\n    background: rgba(255, 255, 255, 0.05);\n    border: 1px solid rgba(255, 255, 255, 0.05);\n    transition: all 0.5s ease;\n}\n\n.cc-feature-card:hover {\n    background: rgba(255, 255, 255, 0.1);\n}\n\n.cc-feature-icon {\n    width: 64px;\n    height: 64px;\n    border-radius: 50%;\n    background: #0E1B30;\n    border: 1px solid rgba(255, 255, 255, 0.1);\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    margin-bottom: 32px;\n    transition: transform 0.5s ease;\n}\n\n.cc-feature-card:hover .cc-feature-icon {\n    transform: scale(1.1);\n}\n\n.cc-feature-title {\n    color: #F7F0EC !important;\n    font-family: 'Cormorant Garamond', serif !important;\n    font-size: 24px !important;\n    margin-bottom: 24px;\n}\n\n.cc-feature-text {\n    color: rgba(247, 240, 236, 0.6) !important;\n    font-family: 'Lato', sans-serif !important;\n    font-size: 18px !important;\n    font-weight: 300 !important;\n    line-height: 1.8 !important;\n}\n\n/* Animations */\n.cc-reveal {\n    opacity: 0;\n    transform: translateY(30px);\n    animation: cc-fade-up 1.2s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;\n}\n\n.cc-delay-1 { animation-delay: 0.2s; }\n.cc-delay-2 { animation-delay: 0.4s; }\n.cc-delay-3 { animation-delay: 0.6s; }\n.cc-delay-4 { animation-delay: 0.8s; }\n\n@keyframes cc-fade-up {\n    to { opacity: 1; transform: translateY(0); }\n}\n\n@media (max-width: 768px) {\n    .cc-features-grid { grid-template-columns: 1fr; }\n    .cc-feature-card { padding: 40px; }\n    .cc-subtitle-cream { font-size: 12px !important; }\n    .cc-title-cream { font-size: 32px !important; }\n    .cc-feature-title { font-size: 20px !important; }\n    .cc-feature-text { font-size: 16px !important; }\n}\n</style>"
