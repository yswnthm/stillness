                            "id": "services_intro_html",
                            "elType": "widget",
                            "settings": {
                                "html": "<div class='services-intro-grid'><h2>One modality is powerful.<br><span class='italic'>Two together</span> is transformative.</h2><p>Each offering below stands on its own — but many of our sessions weave modalities together intentionally. Sound and breathwork. Floating and meditation. Movement and stillness. We'll always let you know when a session combines approaches, so you can choose what feels right for where you are.</p></div><style>.services-intro-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; align-items: start; } .services-intro-grid h2 { font-family: 'Cormorant Garamond', serif; font-size: 48px; color: #1D3152; line-height: 1.1; margin: 0; } .services-intro-grid .italic { font-style: italic; color: #688F9D; } .services-intro-grid p { font-family: 'Lato', sans-serif; font-size: 18px; line-height: 1.6; color: rgba(29, 49, 82, 0.7); margin: 0; padding-top: 8px; } @media (max-width: 768px) { .services-intro-grid { grid-template-columns: 1fr; gap: 32px; } }</style>"
                            },
