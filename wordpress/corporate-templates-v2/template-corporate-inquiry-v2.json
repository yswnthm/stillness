                                "html": "<div class='inquiry-form-card'><form class='inquiry-form'><input type='text' placeholder='Company Name' required /><input type='email' placeholder='Work Email' required /><textarea placeholder="Tell us about your team's needs..." rows='4'></textarea><button type='submit' class='submit-btn'>Send Inquiry</button></form></div><style>.inquiry-form-card { background: #D9E8EB; padding: 48px; border-radius: 24px; max-width: 600px; width: 100%; border: 1px solid rgba(14, 27, 48, 0.05); } .inquiry-form { display: flex; flex-direction: column; gap: 24px; } .inquiry-form input, .inquiry-form textarea { width: 100%; padding: 16px 24px; background: #FFFFFF; border: 1px solid rgba(14, 27, 48, 0.1); border-radius: 99px; font-family: 'Lato', sans-serif; font-size: 16px; transition: border-color 0.3s ease; } .inquiry-form textarea { border-radius: 16px; resize: none; } .inquiry-form input:focus, .inquiry-form textarea:focus { outline: none; border-color: #688F9D; } .submit-btn { background: #FFFFFF; color: #0E1B30; padding: 16px; border-radius: 99px; border: none; font-family: 'Lato', sans-serif; font-weight: 700; text-transform: uppercase; letter-spacing: 2px; cursor: pointer; transition: all 0.3s ease; box-shadow: 0 4px 6px rgba(0,0,0,0.05); } .submit-btn:hover { background: #1D3152; color: #FFFFFF; transform: translateY(-2px); }</style>"
