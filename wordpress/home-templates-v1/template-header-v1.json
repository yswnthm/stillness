                        "html": "<div class='sh-wrap'>\n    <a href='/' class='sh-logo'>Stillness.</a>\n    <nav class='sh-nav'>\n        <a href='/#intro' class='sh-link'>Philosophy</a>\n        <a href='/offerings' class='sh-link'>Sacred Offerings</a>\n        <a href='/shop' class='sh-link'>Shop</a>\n        <a href='/journal' class='sh-link'>Journal</a>\n        <a href='/about' class='sh-link'>About</a>\n        <a href='/reserve' class='sh-book'>Book</a>\n    </nav>\n</div>\n\n<style>\n/* Inline CSS for the inner items only */\n.sh-wrap {\n    max-width: 1400px;\n    margin: 0 auto;\n    padding: 32px 60px;\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    box-sizing: border-box;\n}\n\n.sh-logo {\n    font-family: 'Cormorant Garamond', serif;\n    font-size: 32px;\n    font-weight: 500;\n    letter-spacing: -0.01em;\n    color: #FFFFFF;\n    text-decoration: none;\n}\n\n.sh-nav {\n    display: flex;\n    align-items: center;\n    gap: 40px;\n}\n\n.sh-link {\n    font-family: 'Lato', sans-serif;\n    font-size: 11px;\n    text-transform: uppercase;\n    letter-spacing: 0.18em;\n    color: #FFFFFF;\n    text-decoration: none;\n    transition: color 0.3s ease;\n}\n.sh-link:hover { color: #688F9D; }\n\n.sh-book {\n    font-family: 'Lato', sans-serif;\n    font-size: 11px;\n    text-transform: uppercase;\n    letter-spacing: 0.18em;\n    padding: 10px 28px;\n    border: 1px solid rgba(255,255,255,0.7);\n    border-radius: 100px;\n    color: #FFFFFF;\n    text-decoration: none;\n    transition: all 0.3s ease;\n}\n.sh-book:hover {\n    background: #FFFFFF;\n    border-color: #FFFFFF;\n    color: #0E1B30;\n}\n\n@media (max-width: 768px) {\n    .sh-wrap { padding: 24px 24px; }\n    .sh-nav { display: none; }\n    .sh-logo { font-size: 26px; }\n}\n</style>"
