                    "settings": {
                        "html": "<div class='sf-footer'>\n\n  <!-- ── Main Grid ── -->\n  <div class='sf-grid'>\n\n    <!-- Brand Column -->\n    <div class='sf-col sf-brand'>\n      <a href='/' class='sf-logo'>Stillness.</a>\n      <p class='sf-brand-desc'>A sanctuary for the modern mind. Restoring balance through sensory reduction and nervous system regulation.</p>\n      <div class='sf-socials'>\n        <a href='#' class='sf-social-link' aria-label='Instagram'><i class='fab fa-instagram'></i></a>\n        <a href='#' class='sf-social-link' aria-label='Twitter'><i class='fab fa-twitter'></i></a>\n        <a href='#' class='sf-social-link' aria-label='Facebook'><i class='fab fa-facebook-f'></i></a>\n      </div>\n    </div>\n\n    <!-- Explore Column -->\n    <div class='sf-col'>\n      <h4 class='sf-col-heading'>Explore</h4>\n      <ul class='sf-link-list'>\n        <li><a href='/#intro' class='sf-link'>Our Philosophy</a></li>\n        <li><a href='/offerings' class='sf-link'>Sacred Offerings</a></li>\n        <li><a href='/shop' class='sf-link'>Shop</a></li>\n        <li><a href='/journal' class='sf-link'>Journal</a></li>\n        <li><a href='/about' class='sf-link'>About Us</a></li>\n      </ul>\n    </div>\n\n    <!-- Visit Us Column -->\n    <div class='sf-col'>\n      <h4 class='sf-col-heading'>Visit Us</h4>\n      <ul class='sf-link-list sf-contact-list'>\n        <li class='sf-contact-item'>\n          <i class='fas fa-map-marker-alt sf-icon'></i>\n          <span>1240 Sanctuary Blvd, Suite 100<br>Austin, TX 78704</span>\n        </li>\n        <li class='sf-contact-item'>\n          <i class='fas fa-envelope sf-icon'></i>\n          <a href='mailto:hello@stillness.com' class='sf-link'>hello@stillness.com</a>\n        </li>\n        <li class='sf-contact-item'>\n          <i class='fas fa-phone sf-icon'></i>\n          <span class='sf-link-text'>(512) 555-0123</span>\n        </li>\n      </ul>\n    </div>\n\n    <!-- Legal Column -->\n    <div class='sf-col'>\n      <h4 class='sf-col-heading'>Legal</h4>\n      <ul class='sf-link-list'>\n        <li><a href='#' class='sf-link'>Privacy Policy</a></li>\n        <li><a href='#' class='sf-link'>Terms of Service</a></li>\n        <li><a href='#' class='sf-link'>Waiver</a></li>\n        <li><a href='#' class='sf-link'>Accessibility</a></li>\n      </ul>\n    </div>\n\n  </div>\n\n  <!-- ── Bottom Bar ── -->\n  <div class='sf-bottom'>\n    <span class='sf-copy'>&copy; 2026 Stillness Wellness Co. All rights reserved.</span>\n    <span class='sf-credit'>Designed for Deep Rest.</span>\n  </div>\n\n</div>\n\n<style>\n/* ─────────────────────────────────\n   STILLNESS FOOTER — CSS Grid Layout\n   Bypasses Elementor % width bug.\n──────────────────────────────────── */\n\n.sf-footer {\n  width: 100%;\n  max-width: 1200px;\n  margin: 0 auto;\n  padding: 0 40px;\n  box-sizing: border-box;\n  font-family: 'Lato', sans-serif;\n}\n\n/* ── 4-column grid: 1.5fr brand + 3 equal cols ── */\n.sf-grid {\n  display: grid;\n  grid-template-columns: 1.5fr 1fr 1fr 1fr;\n  gap: 48px;\n  padding-bottom: 64px;\n}\n\n@media (max-width: 900px) {\n  .sf-grid {\n    grid-template-columns: 1fr 1fr;\n    gap: 40px;\n  }\n  .sf-brand {\n    grid-column: 1 / -1;\n  }\n}\n\n@media (max-width: 540px) {\n  .sf-footer { padding: 0 24px; }\n  .sf-grid {\n    grid-template-columns: 1fr;\n    gap: 32px;\n  }\n  .sf-brand { grid-column: auto; }\n}\n\n/* ── Logo ── */\n.sf-logo {\n  font-family: 'Cormorant Garamond', serif;\n  font-size: 32px;\n  font-weight: 500;\n  color: #F7F0EC;\n  text-decoration: none;\n  display: inline-block;\n  margin-bottom: 20px;\n  letter-spacing: -0.01em;\n}\n\n/* ── Brand description ── */\n.sf-brand-desc {\n  color: rgba(164, 178, 186, 0.6);\n  font-size: 14px;\n  line-height: 1.7;\n  font-weight: 300;\n  margin: 0 0 24px;\n  max-width: 280px;\n}\n\n/* ── Social icons ── */\n.sf-socials {\n  display: flex;\n  gap: 16px;\n  align-items: center;\n}\n\n.sf-social-link {\n  color: rgba(164, 178, 186, 0.55);\n  font-size: 18px;\n  text-decoration: none;\n  transition: color 0.3s ease;\n}\n.sf-social-link:hover { color: #F7F0EC; }\n\n/* ── Column heading ── */\n.sf-col-heading {\n  font-family: 'Lato', sans-serif;\n  font-size: 11px;\n  font-weight: 700;\n  text-transform: uppercase;\n  letter-spacing: 0.2em;\n  color: #688F9D;\n  margin: 0 0 24px;\n  padding: 0;\n}\n\n/* ── Nav link lists ── */\n.sf-link-list {\n  list-style: none;\n  margin: 0;\n  padding: 0;\n  display: flex;\n  flex-direction: column;\n  gap: 12px;\n}\n\n.sf-link {\n  color: rgba(164, 178, 186, 0.8);\n  font-size: 14px;\n  font-weight: 400;\n  text-decoration: none;\n  transition: color 0.3s ease;\n}\n.sf-link:hover { color: #F7F0EC; }\n\n.sf-link-text {\n  color: rgba(164, 178, 186, 0.8);\n  font-size: 14px;\n}\n\n/* ── Contact list ── */\n.sf-contact-list {\n  gap: 16px;\n}\n\n.sf-contact-item {\n  display: flex;\n  align-items: flex-start;\n  gap: 12px;\n  color: rgba(164, 178, 186, 0.8);\n  font-size: 14px;\n  line-height: 1.5;\n}\n\n.sf-icon {\n  color: rgba(164, 178, 186, 0.6);\n  font-size: 14px;\n  margin-top: 2px;\n  flex-shrink: 0;\n  width: 16px;\n  text-align: center;\n}\n\n/* ── Bottom bar ── */\n.sf-bottom {\n  border-top: 1px solid rgba(255, 255, 255, 0.06);\n  padding-top: 32px;\n  display: flex;\n  flex-direction: row;\n  justify-content: space-between;\n  align-items: center;\n  flex-wrap: wrap;\n  gap: 8px;\n}\n\n.sf-copy,\n.sf-credit {\n  font-family: 'Lato', sans-serif;\n  font-size: 11px;\n  font-weight: 400;\n  text-transform: uppercase;\n  letter-spacing: 0.1em;\n  color: rgba(164, 178, 186, 0.3);\n}\n\n@media (max-width: 540px) {\n  .sf-bottom {\n    flex-direction: column;\n    align-items: flex-start;\n    gap: 6px;\n  }\n}\n</style>"
