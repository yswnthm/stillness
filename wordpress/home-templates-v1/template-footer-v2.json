                    "settings": {
                        "html": "<div class='sf-footer'>\n\n  <!-- ── Main Grid ── -->\n  <div class='sf-grid'>\n\n    <!-- Brand Column -->\n    <div class='sf-col sf-brand'>\n      <a href='/' class='sf-logo'>Stillness.</a>\n      <p class='sf-brand-desc'>A sanctuary for the modern mind. Restoring balance through sensory reduction and nervous system regulation.</p>\n      \n      <div class='sf-social-email'>\n        <div class='sf-socials'>\n          <a href='#' class='sf-social-link' aria-label='Instagram'><i class='fab fa-instagram'></i></a>\n          <a href='#' class='sf-social-link' aria-label='Twitter'><i class='fab fa-twitter'></i></a>\n          <a href='#' class='sf-social-link' aria-label='Facebook'><i class='fab fa-facebook-f'></i></a>\n        </div>\n        <div class='sf-email'>\n          <a href='mailto:hello@stillness.com' class='sf-link'>hello@stillness.com</a>\n        </div>\n      </div>\n    </div>\n\n    <!-- Explore Column -->\n    <div class='sf-col'>\n      <h4 class='sf-col-heading'>Explore</h4>\n      <ul class='sf-link-list'>\n        <li><a href='/offerings' class='sf-link'>Sacred Offerings</a></li>\n        <li><a href='/shop' class='sf-link'>Shop</a></li>\n        <li><a href='/journal' class='sf-link'>Journal</a></li>\n        <li><a href='/about' class='sf-link'>About Us</a></li>\n      </ul>\n    </div>\n\n  </div>\n\n  <!-- ── Bottom Bar ── -->\n  <div class='sf-bottom'>\n    <span class='sf-copy'>&copy; 2026 Stillness Wellness Co. All rights reserved.</span>\n    <span class='sf-dev'>Developed by <a href='https://solicate.in' target='_blank' class='sf-dev-link'>Solicate.</a></span>\n  </div>\n\n</div>\n\n<style>\n/* ─────────────────────────────────\n   STILLNESS FOOTER V2 — 2-Column Grid\n──────────────────────────────────── */\n\n.sf-footer {\n  width: 100%;\n  max-width: 1200px;\n  margin: 0 auto;\n  padding: 0 40px;\n  box-sizing: border-box;\n  font-family: 'Lato', sans-serif;\n}\n\n/* ── 2-column grid layout ── */\n.sf-grid {\n  display: grid;\n  grid-template-columns: 1.5fr 1fr;\n  gap: 80px;\n  padding-bottom: 64px;\n}\n\n@media (max-width: 768px) {\n  .sf-grid {\n    grid-template-columns: 1fr;\n    gap: 40px;\n  }\n}\n\n/* ── Logo ── */\n.sf-logo {\n  font-family: 'Cormorant Garamond', serif;\n  font-size: 32px;\n  font-weight: 500;\n  color: #F7F0EC;\n  text-decoration: none;\n  display: inline-block;\n  margin-bottom: 32px !important;\n  letter-spacing: -0.01em;\n}\n\n/* ── Brand description ── */\n.sf-brand-desc {\n  color: rgba(164, 178, 186, 0.6);\n  font-size: 14px;\n  line-height: 1.7;\n  font-weight: 300;\n  margin: 0 0 64px !important;\n  max-width: 320px;\n}\n\n/* ── Social & Email Container ── */\n.sf-social-email {\n  display: flex;\n  flex-direction: column;\n  gap: 32px !important;\n}\n\n/* ── Social icons ── */\n.sf-socials {\n  display: flex;\n  gap: 16px;\n  align-items: center;\n}\n\n.sf-social-link {\n  color: rgba(164, 178, 186, 0.55);\n  font-size: 18px;\n  text-decoration: none;\n  transition: color 0.3s ease;\n}\n.sf-social-link:hover { color: #F7F0EC; }\n\n/* ── Email ── */\n.sf-email .sf-link {\n  font-family: 'Lato', sans-serif;\n  font-size: 14px;\n  letter-spacing: 0.05em;\n}\n\n/* ── Column heading ── */\n.sf-col-heading {\n  font-family: 'Lato', sans-serif;\n  font-size: 11px;\n  font-weight: 700;\n  text-transform: uppercase;\n  letter-spacing: 0.2em;\n  color: #688F9D;\n  margin: 0 0 24px;\n  padding: 0;\n}\n\n/* ── Nav link lists ── */\n.sf-link-list {\n  list-style: none;\n  margin: 0;\n  padding: 0;\n  display: flex;\n  flex-direction: column;\n  gap: 12px;\n}\n\n.sf-link {\n  color: rgba(164, 178, 186, 0.8);\n  font-size: 14px;\n  font-weight: 400;\n  text-decoration: none;\n  transition: color 0.3s ease;\n}\n.sf-link:hover { color: #F7F0EC; }\n\n/* ── Bottom bar ── */\n.sf-bottom {\n  border-top: 1px solid rgba(255, 255, 255, 0.06);\n  padding-top: 32px;\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  flex-wrap: wrap;\n  gap: 12px;\n}\n\n.sf-copy,\n.sf-dev {\n  font-family: 'Lato', sans-serif;\n  font-size: 10px;\n  font-weight: 400;\n  text-transform: uppercase;\n  letter-spacing: 0.1em;\n  color: rgba(164, 178, 186, 0.3);\n}\n\n.sf-dev-link {\n  color: inherit;\n  text-decoration: none;\n  transition: color 0.3s ease;\n}\n.sf-dev-link:hover { color: rgba(164, 178, 186, 0.6); }\n\n@media (max-width: 600px) {\n  .sf-footer { padding: 0 24px; }\n  .sf-bottom {\n    flex-direction: column;\n    align-items: center;\n    text-align: center;\n    gap: 8px;\n  }\n}\n</style>"
                    },
