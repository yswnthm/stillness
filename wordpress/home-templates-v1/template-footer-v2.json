                    "settings": {
                        "html": "<div class='sf-footer'>\n\n  <!-- ── Main Grid ── -->\n  <div class='sf-grid'>\n\n    <!-- Brand Column -->\n    <div class='sf-col sf-brand'>\n      <a href='/' class='sf-logo'>Stillness.</a>\n      <p class='sf-brand-desc'>A sanctuary for the modern mind. Restoring balance through sensory reduction and nervous system regulation.</p>\n      \n      <div class='sf-social-email'>\n        <!-- Email ABOVE Icons per RCA resolution -->\n        <div class='sf-email'>\n          <a href='mailto:hello@stillness.com' class='sf-link'>hello@stillness.com</a>\n        </div>\n        <div class='sf-socials'>\n          <a href='#' class='sf-social-link' aria-label='Instagram'><i class='fab fa-instagram'></i></a>\n          <a href='#' class='sf-social-link' aria-label='Twitter'><i class='fab fa-twitter'></i></a>\n          <a href='#' class='sf-social-link' aria-label='Facebook'><i class='fab fa-facebook-f'></i></a>\n        </div>\n      </div>\n    </div>\n\n    <!-- Explore Column -->\n    <div class='sf-col'>\n      <h4 class='sf-col-heading'>Explore</h4>\n      <ul class='sf-link-list'>\n        <li><a href='/offerings' class='sf-link'>Sacred Offerings</a></li>\n        <li><a href='/shop' class='sf-link'>Shop</a></li>\n        <li><a href='/journal' class='sf-link'>Journal</a></li>\n        <li><a href='/about' class='sf-link'>About Us</a></li>\n      </ul>\n    </div>\n\n  </div>\n\n  <!-- ── Bottom Bar ── -->\n  <div class='sf-bottom'>\n    <span class='sf-copy'>&copy; 2026 Stillness Wellness Co. All rights reserved.</span>\n    <span class='sf-dev'>Developed by <a href='https://solicate.in' target='_blank' class='sf-dev-link'>Solicate.</a></span>\n  </div>\n\n</div>\n\n<style>\n/* ─────────────────────────────────\n   STILLNESS FOOTER V2 — RE-ENFORCED\n──────────────────────────────────── */\n\n.sf-footer {\n  width: 100%;\n  max-width: 1200px;\n  margin: 0 auto;\n  padding: 0 40px !important;\n  box-sizing: border-box;\n  font-family: 'Lato', sans-serif;\n}\n\n/* ── 2-column grid layout ── */\n.sf-grid {\n  display: grid !important;\n  grid-template-columns: 1.5fr 1fr !important;\n  gap: 80px !important;\n  padding-bottom: 24px !important;\n}\n\n@media (max-width: 768px) {\n  .sf-grid {\n    grid-template-columns: 1fr !important;\n    gap: 32px !important;\n  }\n}\n\n/* ── Logo ── */\n.sf-footer .sf-logo {\n  font-family: 'Cormorant Garamond', serif !important;\n  font-size: 32px !important;\n  font-weight: 500 !important;\n  color: #F7F0EC !important;\n  text-decoration: none !important;\n  display: inline-block !important;\n  margin: 0 0 12px !important;\n  letter-spacing: -0.01em !important;\n}\n\n/* ── Brand description ── */\n.sf-footer .sf-brand-desc {\n  color: rgba(164, 178, 186, 0.6) !important;\n  font-size: 14px !important;\n  line-height: 1.6 !important;\n  font-weight: 300 !important;\n  margin: 0 0 24px !important;\n  max-width: 320px !important;\n}\n\n/* ── Social & Email Container ── */\n.sf-footer .sf-social-email {\n  display: flex !important;\n  flex-direction: column !important;\n  gap: 8px !important;\n}\n\n/* ── Social icons ── */\n.sf-footer .sf-socials {\n  display: flex !important;\n  gap: 16px !important;\n  align-items: center !important;\n}\n\n.sf-footer .sf-social-link {\n  color: rgba(164, 178, 186, 0.55) !important;\n  font-size: 18px !important;\n  text-decoration: none !important;\n  transition: color 0.3s ease !important;\n}\n.sf-footer .sf-social-link:hover { color: #F7F0EC !important; }\n\n/* ── Email (Website) ── */\n.sf-footer .sf-email .sf-link {\n  font-family: 'Lato', sans-serif !important;\n  font-size: 14px !important;\n  letter-spacing: 0.05em !important;\n  color: #F7F0EC !important;\n  text-decoration: none !important;\n}\n\n/* ── Column heading ── */\n.sf-footer .sf-col-heading {\n  font-family: 'Lato', sans-serif !important;\n  font-size: 11px !important;\n  font-weight: 700 !important;\n  text-transform: uppercase !important;\n  letter-spacing: 0.2em !important;\n  color: #688F9D !important;\n  margin: 0 0 16px !important;\n  padding: 0 !important;\n}\n\n/* ── Nav link lists ── */\n.sf-footer .sf-link-list {\n  list-style: none !important;\n  margin: 0 !important;\n  padding: 0 !important;\n  display: flex !important;\n  flex-direction: column !important;\n  gap: 8px !important;\n}\n\n.sf-footer .sf-link {\n  color: rgba(164, 178, 186, 0.8) !important;\n  font-size: 14px !important;\n  font-weight: 400 !important;\n  text-decoration: none !important;\n  transition: color 0.3s ease !important;\n}\n.sf-footer .sf-link:hover { color: #F7F0EC !important; }\n\n/* ── Bottom bar ── */\n.sf-footer .sf-bottom {\n  border-top: 1px solid rgba(255, 255, 255, 0.06) !important;\n  padding-top: 16px !important;\n  display: flex !important;\n  justify-content: space-between !important;\n  align-items: center !important;\n  flex-wrap: wrap !important;\n  gap: 12px !important;\n}\n\n.sf-footer .sf-copy,\n.sf-footer .sf-dev {\n  font-family: 'Lato', sans-serif !important;\n  font-size: 10px !important;\n  font-weight: 400 !important;\n  text-transform: uppercase !important;\n  letter-spacing: 0.1em !important;\n  color: rgba(164, 178, 186, 0.3) !important;\n}\n\n.sf-footer .sf-dev-link {\n  color: inherit !important;\n  text-decoration: none !important;\n  transition: color 0.3s ease !important;\n}\n.sf-footer .sf-dev-link:hover { color: rgba(164, 178, 186, 0.6) !important; }\n\n@media (max-width: 600px) {\n  .sf-footer { padding: 0 24px !important; }\n  .sf-footer .sf-bottom {\n    flex-direction: column !important;\n    align-items: center !important;\n    text-align: center !important;\n    gap: 8px !important;\n  }\n}\n</style>"
