ant; padding: 12px 32px !important; font-family: 'Lato', sans-serif !important; font-size: 12px !important; text-transform: uppercase !important; letter-spacing: 1px !important; font-weight: 700 !important; cursor: pointer !important; transition: all 0.7s ease !important; min-height: auto !important; line-height: normal !important; } .metform-newsletter-wrap button[type='submit']:hover, .metform-newsletter-wrap .metform-btn:hover { background: #0E1B30 !important; color: #F7F0EC !important; border-color: #0E1B30 !important; } @media (max-width: 480px) { .metform-newsletter-wrap form, .metform-newsletter-wrap .mf-form { flex-direction: column !important; border-radius: 24px !important; padding: 12px !important; } .metform-newsletter-wrap input[type='email'], .metform-newsletter-wrap .mf-input { text-align: center !important; padding-bottom: 12px !important; } .metform-newsletter-wrap button[type='submit'], .metform-newsletter-wrap .metform-btn { width: 100% !important; } } .disclaimer { text-align: center; color: rgba(14, 27, 48, 0.4); font-size: 10px; text-transform: uppercase; letter-spacing: 1px; margin-top: 24px; font-family: 'Lato', sans-serif; }</style>"
