                    "elType": "widget",
                    "settings": {
                        "html": "<div id='sh2-root'>\n  <div class='sh2-wrap'>\n    <a href='/' class='sh2-logo'>Stillness.</a>\n    \n    <!-- Desktop Nav -->\n    <nav class='sh2-nav sh2-desktop-nav'>\n        <a href='/#intro' class='sh2-link'>Philosophy</a>\n        <a href='/offerings' class='sh2-link'>Sacred Offerings</a>\n        <a href='/shop' class='sh2-link'>Shop</a>\n        <a href='/journal' class='sh2-link'>Journal</a>\n        <a href='/about' class='sh2-link'>About</a>\n        <a href='/reserve' class='sh2-book'>Book</a>\n    </nav>\n\n    <!-- Mobile Toggle -->\n    <button id='mobile-toggle' class='sh2-toggle' aria-label='Toggle Menu'>\n        <span class='sh2-toggle-line'></span>\n        <span class='sh2-toggle-line'></span>\n    </button>\n  </div>\n\n  <!-- Mobile Menu Overlay -->\n  <nav id='mobile-menu' class='sh2-mobile-nav'>\n    <div class='sh2-mobile-inner'>\n      <a href='/#intro' class='sh2-mobile-link'>Philosophy</a>\n      <a href='/offerings' class='sh2-mobile-link'>Sacred Offerings</a>\n      <a href='/shop' class='sh2-mobile-link'>Shop</a>\n      <a href='/journal' class='sh2-mobile-link'>Journal</a>\n      <a href='/about' class='sh2-mobile-link'>About</a>\n      <a href='/reserve' class='sh2-mobile-book'>Book</a>\n    </div>\n  </nav>\n</div>\n\n<script>\n(function() {\n    const toggle = document.getElementById('mobile-toggle');\n    const menu = document.getElementById('mobile-menu');\n    const root = document.getElementById('sh2-root');\n    \n    if (toggle && menu) {\n        toggle.addEventListener('click', function(e) {\n            e.preventDefault();\n            root.classList.toggle('sh2-mobile-open');\n        });\n\n        // Close on link click\n        menu.querySelectorAll('a').forEach(link => {\n            link.addEventListener('click', () => {\n                root.classList.remove('sh2-mobile-open');\n            });\n        });\n    }\n})();\n</script>\n\n<style>\n/* ─── Stillness Header v2 ───────────────────────────────────────────────────\n   Refined Fixed position & Mobile Nav\n────────────────────────────────────────────────────────────────────────── */\n\n#sh2-root {\n    width: 100%;\n    pointer-events: none; \n    background: transparent;\n    position: relative; /* Container is fixed via Elementor */\n}\n\n.sh2-wrap {\n    max-width: 1400px;\n    margin: 0 auto;\n    padding: 32px 60px;\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    box-sizing: border-box;\n    pointer-events: all;\n}\n\n.sh2-logo {\n    font-family: 'Cormorant Garamond', serif;\n    font-size: 32px;\n    font-weight: 500;\n    letter-spacing: -0.01em;\n    color: #FFFFFF;\n    text-decoration: none;\n    text-shadow: 0 1px 6px rgba(0,0,0,0.25);\n    position: relative;\n    z-index: 100001;\n}\n\n.sh2-nav {\n    display: flex;\n    align-items: center;\n    gap: 40px;\n}\n\n.sh2-link {\n    font-family: 'Lato', sans-serif;\n    font-size: 11px;\n    text-transform: uppercase;\n    letter-spacing: 0.18em;\n    color: #FFFFFF;\n    text-decoration: none;\n    transition: color 0.3s ease;\n    text-shadow: 0 1px 4px rgba(0,0,0,0.2);\n}\n.sh2-link:hover { color: #8BAFC0; }\n\n.sh2-book {\n    font-family: 'Lato', sans-serif;\n    font-size: 11px;\n    text-transform: uppercase;\n    letter-spacing: 0.18em;\n    padding: 10px 28px;\n    border: 1px solid rgba(255,255,255,0.7);\n    border-radius: 100px;\n    color: #FFFFFF;\n    text-decoration: none;\n    transition: all 0.3s ease;\n    backdrop-filter: blur(4px);\n}\n.sh2-book:hover {\n    background: #FFFFFF;\n    border-color: #FFFFFF;\n    color: #0E1B30;\n}\n\n/* ── Mobile Toggle ── */\n.sh2-toggle {\n    display: none; \n    background: none;\n    border: none;\n    cursor: pointer;\n    padding: 10px;\n    z-index: 100001;\n    pointer-events: all;\n}\n.sh2-toggle-line {\n    display: block;\n    width: 24px;\n    height: 1.5px;\n    background: #FFFFFF;\n    margin: 6px 0;\n    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);\n}\n\n/* ── Mobile Nav Overlay ── */\n.sh2-mobile-nav {\n    position: fixed;\n    top: 0;\n    left: 0;\n    width: 100%;\n    height: 100vh;\n    background: rgba(14, 27, 48, 0.98);\n    backdrop-filter: blur(12px);\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    opacity: 0;\n    visibility: hidden;\n    transition: all 0.5s ease;\n    pointer-events: all;\n    z-index: 100000;\n}\n\n.sh2-mobile-inner {\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    gap: 32px;\n    transform: translateY(20px);\n    transition: all 0.5s ease;\n}\n\n.sh2-mobile-link {\n    font-family: 'Lato', sans-serif;\n    font-size: 14px;\n    text-transform: uppercase;\n    letter-spacing: 0.2em;\n    color: #FFFFFF;\n    text-decoration: none;\n}\n\n.sh2-mobile-book {\n    font-family: 'Lato', sans-serif;\n    font-size: 14px;\n    text-transform: uppercase;\n    letter-spacing: 0.2em;\n    padding: 14px 40px;\n    border: 1px solid #FFFFFF;\n    border-radius: 50px;\n    color: #FFFFFF;\n    text-decoration: none;\n}\n\n/* ── Open State ── */\n.sh2-mobile-open .sh2-mobile-nav {\n    opacity: 1;\n    visibility: visible;\n}\n.sh2-mobile-open .sh2-mobile-inner {\n    transform: translateY(0);\n}\n.sh2-mobile-open .sh2-toggle-line:nth-child(1) {\n    transform: translateY(4px) rotate(45deg);\n}\n.sh2-mobile-open .sh2-toggle-line:nth-child(2) {\n    transform: translateY(-4px) rotate(-45deg);\n}\n\n/* ── Admin Bar Compatibility ── */\nbody.admin-bar #stillness-header {\n    top: 32px !important;\n}\n@media screen and (max-width: 782px) {\n    body.admin-bar #stillness-header { top: 46px !important; }\n}\n\n/* ── Responsive ── */\n@media (max-width: 768px) {\n    .sh2-wrap    { padding: 20px 24px; }\n    .sh2-desktop-nav { display: none; }\n    .sh2-toggle  { display: block; }\n    .sh2-logo    { font-size: 24px; }\n    \n    .sh2-mobile-inner { display: flex; flex-direction: column; }\n}\n</style>",
