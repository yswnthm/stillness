                    "id": "header_html_v2",
                    "elType": "widget",
                    "settings": {
                        "html": "<div id='sh2-root'>\n  <div class='sh2-wrap'>\n    <a href='/' class='sh2-logo'>Stillness.</a>\n    <nav class='sh2-nav'>\n        <a href='/#intro' class='sh2-link'>Philosophy</a>\n        <a href='/offerings' class='sh2-link'>Sacred Offerings</a>\n        <a href='/shop' class='sh2-link'>Shop</a>\n        <a href='/journal' class='sh2-link'>Journal</a>\n        <a href='/about' class='sh2-link'>About</a>\n        <a href='/reserve' class='sh2-book'>Book</a>\n    </nav>\n  </div>\n</div>\n\n<style>\n/* ─── Stillness Header v2 ───────────────────────────────────────────────────\n   Strategy: position:fixed so it floats over ANY Elementor container width\n   (full-width, boxed, stretched) without relying on negative margins.\n   All selectors are namespaced sh2- to avoid conflicts with other templates.\n────────────────────────────────────────────────────────────────────────── */\n\n#sh2-root {\n    position: fixed;\n    top: 0;\n    left: 0;\n    right: 0;\n    z-index: 99999;\n    pointer-events: none; /* let clicks pass through the invisible root */\n    background: transparent;\n}\n\n.sh2-wrap {\n    max-width: 1400px;\n    margin: 0 auto;\n    padding: 32px 60px;\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    box-sizing: border-box;\n    pointer-events: all; /* re-enable clicks on the actual bar */\n}\n\n.sh2-logo {\n    font-family: 'Cormorant Garamond', serif;\n    font-size: 32px;\n    font-weight: 500;\n    letter-spacing: -0.01em;\n    color: #FFFFFF;\n    text-decoration: none;\n    text-shadow: 0 1px 6px rgba(0,0,0,0.25);\n}\n\n.sh2-nav {\n    display: flex;\n    align-items: center;\n    gap: 40px;\n}\n\n.sh2-link {\n    font-family: 'Lato', sans-serif;\n    font-size: 11px;\n    text-transform: uppercase;\n    letter-spacing: 0.18em;\n    color: #FFFFFF;\n    text-decoration: none;\n    transition: color 0.3s ease;\n    text-shadow: 0 1px 4px rgba(0,0,0,0.2);\n}\n.sh2-link:hover { color: #8BAFC0; }\n\n.sh2-book {\n    font-family: 'Lato', sans-serif;\n    font-size: 11px;\n    text-transform: uppercase;\n    letter-spacing: 0.18em;\n    padding: 10px 28px;\n    border: 1px solid rgba(255,255,255,0.7);\n    border-radius: 100px;\n    color: #FFFFFF;\n    text-decoration: none;\n    transition: all 0.3s ease;\n    backdrop-filter: blur(4px);\n}\n.sh2-book:hover {\n    background: #FFFFFF;\n    border-color: #FFFFFF;\n    color: #0E1B30;\n}\n\n/* ── Compensate for fixed header so Elementor admin bar doesn't clash ── */\nbody.admin-bar #sh2-root {\n    top: 32px;\n}\n@media screen and (max-width: 782px) {\n    body.admin-bar #sh2-root { top: 46px; }\n}\n\n/* ── Responsive ── */\n@media (max-width: 768px) {\n    .sh2-wrap  { padding: 20px 24px; }\n    .sh2-nav   { display: none; }\n    .sh2-logo  { font-size: 26px; }\n}\n\n/* ── Wipe the Elementor container's own padding/margin so it takes zero\n   vertical space – the fixed header floats above everything. ── */\n#stillness-header-v2,\n#stillness-header-v2 > .elementor-container,\n#stillness-header-v2 > .e-con-inner {\n    padding-top: 0 !important;\n    padding-bottom: 0 !important;\n    margin-top: 0 !important;\n    margin-bottom: 0 !important;\n    min-height: 0 !important;\n    line-height: 0 !important;\n    overflow: visible !important;\n}\n</style>",
                        "_element_id": "stillness-header-html-v2"
                    },
                    "widgetType": "html"
                }
            ]
        }
