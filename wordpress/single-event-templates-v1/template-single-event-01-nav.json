            "html": "<nav class=\"se-nav\">\n  <a href=\"/events/\" class=\"se-nav-logo\">Stillness Co.</a>\n  <div class=\"se-nav-links\">\n    <a href=\"/events/\">Retreats</a>\n    <a href=\"/shop/\">Shop</a>\n    <a href=\"/journal/\">Journal</a>\n  </div>\n  <a href=\"#booking-section\" class=\"se-nav-cta\">Book Ticket</a>\n</nav>\n<style>\n@import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400;1,500&family=Jost:wght@200;300;400;500;600&display=swap');\n\n:root {\n  --se-stone: #0E1B30;\n  --se-midnight: #1D3152;\n  --se-seafoam: #688F9D;\n  --se-wave: #A4B2BA;\n  --se-breeze: #D9E8EB;\n  --se-sand: #C4BBB4;\n  --se-cream: #F7F0EC;\n  --se-white: #FFFFFF;\n  --se-amber: #C4935A;\n  --se-amber-light: #F0E4D0;\n  --se-text-body: #3D4F57;\n  --se-text-light: #7A8F96;\n}\n.se-nav { position: fixed !important; top: 0 !important; left: 0 !important; right: 0 !important; z-index: 100 !important; padding: 20px 52px !important; display: flex !important; justify-content: space-between !important; align-items: center !important; background: rgba(247,240,236,0.92) !important; backdrop-filter: blur(12px) !important; -webkit-backdrop-filter: blur(12px) !important; border-bottom: 0.5px solid rgba(196,187,180,0.3) !important; }\n.se-nav-logo { font-family: 'Cormorant Garamond', serif !important; font-size: 13px !important; font-weight: 400 !important; letter-spacing: 0.35em !important; text-transform: uppercase !important; color: var(--se-stone) !important; text-decoration: none !important; }\n.se-nav-links { display: flex !important; gap: 2rem !important; }\n.se-nav-links a { font-family: 'Jost', sans-serif !important; text-decoration: none !important; font-size: 10px !important; font-weight: 400 !important; letter-spacing: 0.15em !important; text-transform: uppercase !important; color: var(--se-stone) !important; transition: color 0.3s ease !important; }\n.se-nav-links a:hover { color: var(--se-seafoam) !important; }\n.se-nav-cta { font-family: 'Jost', sans-serif !important; font-size: 9px !important; letter-spacing: 0.22em !important; text-transform: uppercase !important; color: var(--se-cream) !important; background: var(--se-stone) !important; padding: 8px 20px !important; border-radius: 2px !important; text-decoration: none !important; transition: background 0.3s ease !important; font-weight: 400 !important; }\n.se-nav-cta:hover { background: var(--se-midnight) !important; color: var(--se-cream) !important; }\n@media(max-width: 768px) { .se-nav { padding: 15px 24px !important; } .se-nav-links { display: none !important; } .se-nav-logo { font-size: 12px !important; } }\n</style>"
