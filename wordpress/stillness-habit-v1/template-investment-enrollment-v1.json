          "settings": {
            "html": "<div class='investment-enrollment-container'>\n  <div class='investment-col-main'>\n    <div class='pathways-wrap'><span class='pathways-label'>The Commitment</span><h3 class='pathways-title'>Ritual Pathways</h3><div class='pathways-grid'><div class='pathways-card card-founders'><div class='card-badge'>Founders Circle</div><div class='card-price'>$333</div><div class='card-subtitle'>Early Intake / CAD</div><ul class='card-list'><li><i class='fas fa-check-circle'></i> Priority Intake Window</li><li><i class='fas fa-check-circle'></i> Lifetime Alumnus Hub</li><li><i class='fas fa-check-circle'></i> The Founders Bonus Workshop</li></ul></div><div class='pathways-card card-standard'><div class='card-badge'>Standard Enrollment</div><div class='card-price'>$444</div><div class='card-subtitle'>Regular Rate / CAD</div><ul class='card-list'><li><i class='fas fa-check-circle'></i> Full 30-Day Guided Journey</li><li><i class='fas fa-check-circle'></i> Digital Integration Library</li><li><i class='fas fa-check-circle'></i> Live Closing Fire Ritual</li></ul></div></div><div class='pathways-actions'><a href='/reserve' class='btn-primary'>Apply for Intake</a><a href='/contact' class='btn-secondary'>Discovery Session</a></div></div><style>.pathways-wrap { background: rgba(247, 240, 236, 0.2); padding: 64px; border-radius: 72px; border: 1px solid rgba(14, 27, 48, 0.05); display: flex; flex-direction: column; box-shadow: 0 20px 50px rgba(0,0,0,0.03); backdrop-filter: blur(4px); }@media (max-width: 768px) { .pathways-wrap { padding: 48px 24px; border-radius: 48px; } }.pathways-label { color: #688F9D; letter-spacing: 0.3em; text-transform: uppercase; font-size: 10px; margin-bottom: 32px; font-weight: 700; font-family: 'Lato', sans-serif; }.pathways-title { font-family: 'Cormorant Garamond', serif !important; font-size: 36px; font-weight: 400 !important; margin-bottom: 48px; color: #0E1B30 !important; }.pathways-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 32px; flex-grow: 1; }@media (max-width: 768px) { .pathways-grid { grid-template-columns: 1fr; } }.pathways-card { padding: 48px; border-radius: 40px; transition: all 0.3s ease; }.card-founders { background: #FFFFFF; border: 1px solid rgba(14, 27, 48, 0.05); box-shadow: 0 10px 30px rgba(0,0,0,0.02); }.card-founders:hover { border-color: rgba(104, 143, 157, 0.3); }.card-standard { background: rgba(14, 27, 48, 0.05); border: 1px solid transparent; }.card-standard:hover { border-color: rgba(14, 27, 48, 0.1); }.card-badge { font-size: 12px; text-transform: uppercase; letter-spacing: 0.1em; color: rgba(14, 27, 48, 0.4); margin-bottom: 24px; font-weight: 700; transition: color 0.3s ease; font-family: 'Lato', sans-serif; }.card-founders:hover .card-badge { color: #688F9D; }.card-price { font-family: 'Cormorant Garamond', serif !important; font-size: 60px; color: #0E1B30 !important; margin-bottom: 12px; line-height: 1; }.card-subtitle { font-size: 10px; color: rgba(14, 27, 48, 0.3); margin-bottom: 32px; text-transform: uppercase; letter-spacing: 0.2em; font-weight: 700; font-family: 'Lato', sans-serif; }.card-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 20px; }.card-list li { display: flex; align-items: center; gap: 16px; color: rgba(14, 27, 48, 0.6); font-size: 14px; font-family: 'Lato', sans-serif; }.card-list i { color: #688F9D; font-size: 16px; flex-shrink: 0; }.pathways-actions { margin-top: 64px; display: flex; gap: 24px; padding-top: 48px; border-top: 1px solid rgba(14, 27, 48, 0.05); }@media (max-width: 768px) { .pathways-actions { flex-direction: column; } }a.btn-primary, a.btn-secondary { flex: 1; text-align: center; padding: 24px; border-radius: 9999px; font-size: 10px; text-transform: uppercase; letter-spacing: 0.3em; font-weight: 700; text-decoration: none !important; transition: all 0.3s ease; font-family: 'Lato', sans-serif; line-height: 1; display: flex; align-items: center; justify-content: center; }a.btn-primary { background: #1D3152; color: #FFFFFF !important; box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04); }a.btn-primary:hover { background: #0E1B30; }a.btn-secondary { border: 1px solid rgba(14, 27, 48, 0.2); color: #0E1B30 !important; }a.btn-secondary:hover { background: rgba(14, 27, 48, 0.05); }</style>\n  </div>\n  <div class='investment-col-sidebar'>\n    <div class='contract-wrap'><div class='contract-bg-decor animate-breathe'></div><div class='contract-content sh-reveal'><i class='fas fa-sun contract-icon'></i><h4 class='contract-title'>The Sacred Contract.</h4><p class='contract-quote'>\"Your nervous system doesn't need more information. It needs more integration. Committing to 30 days is the first step.\"</p><div class='contract-badge'>Circle starts in 12 days</div></div></div><style>.contract-wrap { background: #0E1B30; color: #FFFFFF !important; padding: 64px; border-radius: 72px; box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25); position: relative; overflow: hidden; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; height: 100%; transition: all 0.5s ease; }@media (max-width: 768px) { .contract-wrap { padding: 48px 24px; border-radius: 48px; } }.contract-bg-decor { position: absolute; top: 0; right: 0; width: 160px; height: 160px; background: rgba(104, 143, 157, 0.1); border-radius: 50%; transform: translate(50%, -50%); pointer-events: none; }.contract-content { position: relative; z-index: 10; display: flex; flex-direction: column; align-items: center; }.contract-icon { color: #688F9D; font-size: 56px; margin-bottom: 40px; opacity: 0.6; transition: transform 1s ease; }.contract-wrap:hover .contract-icon { transform: rotate(45deg); }.contract-title { font-family: 'Cormorant Garamond', serif !important; font-size: 32px; font-weight: 400 !important; color: #FFFFFF !important; margin-bottom: 32px; max-width: 250px; line-height: 1.2; }.contract-quote { font-family: 'Lato', sans-serif !important; font-size: 16px; font-weight: 300 !important; font-style: italic; color: rgba(255, 255, 255, 0.5); line-height: 1.8; margin-bottom: 40px; max-width: 400px; }.contract-badge { padding: 16px 40px; background: rgba(255, 255, 255, 0.05); backdrop-filter: blur(4px); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 9999px; font-family: 'Lato', sans-serif; font-size: 10px; text-transform: uppercase; letter-spacing: 0.3em; font-weight: 700; color: #FFFFFF !important; }.sh-reveal { opacity: 0; transform: translateY(20px); animation: sh-fade-up 1.2s cubic-bezier(0.2, 0.8, 0.2, 1) forwards; }@keyframes sh-fade-up { to { opacity: 1; transform: translateY(0); } }@keyframes animate-breathe { 0%, 100% { transform: scale(1); opacity: 0.4; } 50% { transform: scale(1.1); opacity: 0.7; } }</style>\n  </div>\n</div>\n<style>\n.investment-enrollment-container {\n  display: flex;\n  flex-direction: column;\n  gap: 48px;\n  width: 100%;\n}\n@media (min-width: 1024px) {\n  .investment-enrollment-container {\n    flex-direction: row;\n    align-items: stretch;\n  }\n  .investment-col-main {\n    width: 66.666%;\n    display: flex;\n    flex-direction: column;\n  }\n  .investment-col-sidebar {\n    width: 33.333%;\n    display: flex;\n    flex-direction: column;\n  }\n}\n</style>\n"
