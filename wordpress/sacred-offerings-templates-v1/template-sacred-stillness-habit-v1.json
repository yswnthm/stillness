            "html": "<div class='ssh-wrapper'><div class='ssh-grid'><div class='ssh-img-col ssh-reveal'><div class='ssh-img-wrap'><img src='https://images.unsplash.com/photo-1508672019048-805c876b67e2?q=80&w=1600&auto=format&fit=crop' alt='The Stillness Habit' /><div class='ssh-img-overlay'></div></div></div><div class='ssh-text-col ssh-reveal ssh-delay-2'><div class='ssh-card'><div class='ssh-moon-icon'><i class='fas fa-moon'></i></div><span class='ssh-label'>Membership II</span><h3 class='ssh-title'>The Stillness Habit</h3><p class='ssh-desc'>Build a lifelong meditation practice in just 30 days. Join an intimate cohort for daily live-guided facilitation where consistency becomes sacred.</p><div class='ssh-list'><div class='ssh-list-item'><span class='ssh-bullet'></span>30 Daily Live Guided Sessions</div><div class='ssh-list-item'><span class='ssh-bullet'></span>Integrated Breathwork Training</div><div class='ssh-list-item'><span class='ssh-bullet'></span>Sacred Closing Ritual Event</div><div class='ssh-list-item'><span class='ssh-bullet'></span>Digital Habit Tracking Tools</div><div class='ssh-list-item'><span class='ssh-bullet'></span>Intimate Cohorts (Max 15)</div></div><div class='ssh-investment'><div class='ssh-inv-label'>Investment</div><div class='ssh-inv-price'>$333 <span class='ssh-inv-unit'>CAD / Founders</span></div><div class='ssh-inv-sub'>General Enrollment: $488 CAD</div></div><a href='/habit' class='ssh-btn'><div class='ssh-btn-circle'><i class='fas fa-arrow-left'></i></div><span class='ssh-btn-text'>Begin Practice</span></a></div></div></div></div><style>.ssh-wrapper { padding: 120px 24px; background-color: #FFFFFF; font-family: 'Lato', sans-serif; color: #1D3152; } .ssh-grid { display: flex; align-items: center; flex-direction: row-reverse; } .ssh-img-col { width: 60%; } .ssh-img-wrap { position: relative; aspect-ratio: 16/10; border-radius: 48px; overflow: hidden; box-shadow: 0 25px 50px -12px rgba(0,0,0,0.25); } .ssh-img-wrap img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.7s ease; } .ssh-img-wrap:hover img { transform: scale(1.05); } .ssh-img-overlay { position: absolute; inset: 0; background: rgba(29, 49, 82, 0.2); pointer-events: none; } .ssh-text-col { width: 40%; margin-right: -96px; z-index: 10; padding-top: 48px; } .ssh-card { background: #1D3152; padding: 56px; border-radius: 48px; box-shadow: 0 50px 100px -20px rgba(0,0,0,0.3); border: 1px solid rgba(255, 255, 255, 0.05); position: relative; min-height: 500px; display: flex; flex-direction: column; justify-content: center; overflow: hidden; } .ssh-moon-icon { position: absolute; top: 40px; left: 40px; font-size: 100px; color: rgba(255, 255, 255, 0.1); opacity: 0.1; transition: opacity 0.5s ease; pointer-events: none; } .ssh-card:hover .ssh-moon-icon { opacity: 0.2; } .ssh-label { color: #688F9D; letter-spacing: 0.2em; text-transform: uppercase; font-size: 12px; margin-bottom: 16px; display: block; font-weight: 700; } .ssh-title { font-family: 'Cormorant Garamond', serif; font-size: 48px; color: #FFFFFF; margin: 0 0 32px; font-weight: 400; line-height: 1.1; } .ssh-desc { color: rgba(255, 255, 255, 0.6); line-height: 1.8; margin: 0 0 32px; font-size: 14px; font-weight: 300; position: relative; z-index: 2; } .ssh-list { display: flex; flex-direction: column; gap: 16px; margin-bottom: 40px; position: relative; z-index: 2; } .ssh-list-item { display: flex; align-items: center; gap: 12px; color: rgba(255, 255, 255, 0.7); font-size: 12px; letter-spacing: 0.05em; } .ssh-bullet { width: 6px; height: 6px; border-radius: 99px; background: #688F9D; } .ssh-investment { padding: 24px; background: rgba(255, 255, 255, 0.05); border-radius: 16px; border: 1px solid rgba(255, 255, 255, 0.1); margin-bottom: 40px; position: relative; z-index: 2; } .ssh-inv-label { font-size: 10px; text-transform: uppercase; letter-spacing: 0.2em; color: #688F9D; margin-bottom: 4px; font-weight: 700; } .ssh-inv-price { font-family: 'Cormorant Garamond', serif; font-size: 24px; color: #FFFFFF; } .ssh-inv-unit { font-family: 'Lato', sans-serif; font-size: 14px; text-transform: uppercase; letter-spacing: 0.2em; opacity: 0.4; } .ssh-inv-sub { font-size: 12px; color: rgba(255, 255, 255, 0.4); margin-top: 4px; } .ssh-btn { display: inline-flex; align-items: center; justify-content: center; gap: 12px; padding: 16px 40px; background: #FFFFFF; border: 1px solid #FFFFFF; border-radius: 99px; text-decoration: none !important; color: #1D3152 !important; font-size: 14px; letter-spacing: 2px; text-transform: uppercase; font-weight: 700; transition: all 0.5s ease; box-shadow: 0 10px 20px -5px rgba(0,0,0,0.1); } .ssh-btn:hover { background: #1D3152 !important; color: #FFFFFF !important; border-color: #FFFFFF !important; transform: translateY(-2px); box-shadow: 0 15px 30px -10px rgba(0,0,0,0.2); } .ssh-btn-circle { width: 32px; height: 32px; border-radius: 99px; background: #1D3152; display: flex; align-items: center; justify-content: center; margin-right: 12px; transition: all 0.5s ease; color: #FFFFFF; } .ssh-btn:hover .ssh-btn-circle { background: #FFFFFF; color: #1D3152; } .ssh-reveal { opacity: 0; transform: translateY(30px); animation: ssh-fade-up 1.2s cubic-bezier(0.2, 0.8, 0.2, 1) forwards; } .ssh-delay-2 { animation-delay: 0.4s; } @keyframes ssh-fade-up { to { opacity: 1; transform: translateY(0); } } @media (max-width: 992px) { .ssh-grid { flex-direction: column; } .ssh-img-col { width: 100%; } .ssh-text-col { width: 100%; margin-right: 0; padding-top: 24px; margin-top: -48px; } .ssh-card { padding: 40px; } .ssh-title { font-size: 36px; } } @media (max-width: 480px) { .ssh-card { padding: 32px 24px; } .ssh-wrapper { padding: 80px 20px; } }</style>"
