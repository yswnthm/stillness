          "settings": {
            "html": "<div class='sds-wrapper'><div class='sds-line'></div><div class='sds-container'><div class='sds-header sds-reveal'><span class='sds-label'>Rhythm of Rest</span><h2 class='sds-title'>A Day in Stillness</h2></div><div class='sds-timeline'><div class='sds-row sds-reveal'><div class='sds-col-left'><div class='sds-circle sds-circle-1'><span class='sds-time'>06:00</span></div></div><div class='sds-col-right'><h4 class='sds-item-title'>Morning Dew</h4><p class='sds-item-desc'>Awaken to silence before the digital world demands your attention.</p></div></div><div class='sds-row sds-row-reverse sds-reveal'><div class='sds-col-left'><div class='sds-circle sds-circle-2 sds-align-left'><span class='sds-time'>13:00</span></div></div><div class='sds-col-right sds-text-right'><h4 class='sds-item-title'>The Midday Pause</h4><p class='sds-item-desc'>A deliberate check-in to reset the nervous system.</p></div></div><div class='sds-row sds-reveal'><div class='sds-col-left'><div class='sds-circle sds-circle-3'><span class='sds-time'>20:00</span></div></div><div class='sds-col-right'><h4 class='sds-item-title'>Evening Descent</h4><p class='sds-item-desc'>Communal practice to shed the day's weight.</p></div></div></div></div></div><style>.sds-wrapper { position: relative; padding: 160px 0; background: #0E1B30; color: #FFFFFF; overflow: hidden; } .sds-line { position: absolute; top: 0; left: 50%; width: 1px; height: 100%; background: rgba(255, 255, 255, 0.05); transform: translateX(-50%); z-index: 1; } .sds-container { max-width: 900px; margin: 0 auto; padding: 0 40px; position: relative; z-index: 10; } .sds-header { text-align: center; margin-bottom: 128px; } .sds-label { font-family: 'Lato', sans-serif !important; display: block; color: #688F9D !important; letter-spacing: 0.4em; text-transform: uppercase; font-size: 10px; margin-bottom: 24px; font-weight: 700; } .sds-wrapper h2.sds-title, .sds-title { font-family: 'Cormorant Garamond', serif !important; font-size: 60px !important; color: #FFFFFF !important; margin: 0 0 24px; font-weight: 400; line-height: 1.1; font-style: italic; } .sds-timeline { display: flex; flex-direction: column; gap: 160px; } .sds-row { display: flex; align-items: center; gap: 96px; } .sds-row-reverse { flex-direction: row-reverse; } .sds-col-left { width: 50%; display: flex; justify-content: flex-end; } .sds-col-right { width: 50%; } .sds-text-right { text-align: right; } .sds-row-reverse .sds-col-left { justify-content: flex-start; } .sds-circle { aspect-ratio: 1/1; width: 100%; max-width: 200px; border-radius: 999px; border: 1px solid rgba(255, 255, 255, 0.1); display: flex; align-items: center; justify-content: center; } .sds-circle-1 { background: rgba(217, 232, 235, 0.2); } .sds-circle-2 { background: rgba(104, 143, 157, 0.2); } .sds-circle-3 { background: rgba(29, 49, 82, 0.4); } .sds-wrapper .sds-time, .sds-time { font-family: 'Cormorant Garamond', serif !important; font-size: 36px !important; font-style: italic; color: #FFFFFF !important; font-weight: 400; } .sds-wrapper h4.sds-item-title, .sds-wrapper .sds-item-title, .sds-item-title { font-family: 'Cormorant Garamond', serif !important; font-size: 30px !important; color: #FFFFFF !important; font-weight: 400 !important; margin-bottom: 12px; line-height: 1.2 !important; } .sds-wrapper p.sds-item-desc, .sds-wrapper .sds-item-desc, .sds-item-desc { font-family: 'Lato', sans-serif !important; color: rgba(255, 255, 255, 0.5) !important; line-height: 1.8; margin: 0; font-size: 16px; font-weight: 300; } .sds-reveal { opacity: 0; transform: translateY(30px); animation: sds-fade-up 1.2s cubic-bezier(0.2, 0.8, 0.2, 1) forwards; } @keyframes sds-fade-up { to { opacity: 1; transform: translateY(0); } } @media (max-width: 1024px) { .sds-container { padding: 0 40px; } .sds-timeline { gap: 120px; } .sds-row { gap: 64px; } } @media (max-width: 991px) { .sds-wrapper h2.sds-title, .sds-title { font-size: 48px !important; } .sds-line { left: 40px; transform: none; } .sds-row { flex-direction: column; gap: 40px; align-items: flex-start; } .sds-row-reverse { flex-direction: column; } .sds-col-left, .sds-col-right { width: 100%; justify-content: flex-start; text-align: left; padding-left: 80px; } .sds-circle { max-width: 120px; } .sds-wrapper .sds-time, .sds-time { font-size: 24px !important; } .sds-timeline { gap: 80px; } .sds-text-right { text-align: left; } } @media (max-width: 767px) { .sds-col-left, .sds-col-right { padding-left: 60px; } .sds-line { left: 30px; } .sds-wrapper p.sds-item-desc, .sds-item-desc { font-size: 14px; } }</style>"
