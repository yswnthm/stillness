          "settings": {
            "html": "<div class='scc-wrapper'><div class='scc-grid'><div class='scc-img-col scc-reveal'><div class='scc-img-wrap'><img src='https://images.unsplash.com/photo-1545205597-3d9d02c29597?q=80&w=1600&auto=format&fit=crop' alt='Curated Calm' /><div class='scc-img-overlay'></div></div></div><div class='scc-text-col scc-reveal scc-delay-2'><div class='scc-card'><div class='scc-leaf-icon'><i class='fas fa-leaf'></i></div><span class='scc-label'>Membership I</span><h3 class='scc-title'>Curated Calm</h3><p class='scc-desc'>A bespoke journey of 12 private in-home wellness sessions, evolving with your needs over the course of a year. Because the deepest calm is the one you don't have to chase.</p><div class='scc-list'><div class='scc-list-item'><span class='scc-bullet'></span>11 Private In-Home Sessions</div><div class='scc-list-item'><span class='scc-bullet'></span>1 Floating Sound Bath Experience</div><div class='scc-list-item'><span class='scc-bullet'></span>Priority & Flexible Scheduling</div><div class='scc-list-item'><span class='scc-bullet'></span>Premium Stillness Tools Provided</div><div class='scc-list-item'><span class='scc-bullet'></span>Optional Guest Access ($99)</div></div><div class='scc-investment'><div class='scc-inv-label'>Investment</div><div class='scc-inv-price'>$3,333 <span class='scc-inv-unit'>CAD / Year</span></div><div class='scc-inv-sub'>or $297 / month</div></div><a href='/curated-calm' class='scc-btn'><div class='scc-btn-circle'><i class='fas fa-arrow-right'></i></div><span class='scc-btn-text'>Enter Sanctuary</span></a></div></div></div></div><style>.scc-wrapper { font-family: 'Lato', sans-serif; padding-top: 120px; padding-bottom: 240px; } .scc-grid { display: flex; align-items: center; } .scc-img-col { width: 60%; } .scc-img-wrap { position: relative; aspect-ratio: 16/10; border-radius: 48px; overflow: hidden; box-shadow: 0 25px 50px -12px rgba(0,0,0,0.25); } .scc-img-wrap img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.7s ease; } .scc-img-wrap:hover img { transform: scale(1.05); } .scc-img-overlay { position: absolute; inset: 0; background: rgba(14, 27, 48, 0.1); pointer-events: none; } .scc-text-col { width: 40%; margin-left: -96px; z-index: 10; padding-top: 48px; } .scc-card { background: #FFFFFF; padding: 56px; border-radius: 48px; box-shadow: 0 50px 100px -20px rgba(0,0,0,0.12); border: 1px solid rgba(14, 27, 48, 0.05); position: relative; min-height: 500px; display: flex; flex-direction: column; justify-content: center; overflow: hidden; } .scc-leaf-icon { position: absolute; top: 40px; right: 40px; font-size: 100px; color: rgba(14, 27, 48, 0.1); opacity: 0.1; transition: opacity 0.5s ease; pointer-events: none; } .scc-card:hover .scc-leaf-icon { opacity: 0.2; } .scc-label { color: #688F9D; letter-spacing: 0.2em; text-transform: uppercase; font-size: 12px; margin-bottom: 16px; display: block; font-weight: 700; } .scc-title { font-family: 'Cormorant Garamond', serif; font-size: 48px; color: #1D3152; margin-bottom: 24px; font-weight: 400; line-height: 1.1; } .scc-desc { color: rgba(14, 27, 48, 0.6); line-height: 1.8; margin: 0 0 32px; font-size: 14px; font-weight: 300; position: relative; z-index: 2; } .scc-list { display: flex; flex-direction: column; gap: 16px; margin-bottom: 40px; position: relative; z-index: 2; } .scc-list-item { display: flex; align-items: center; gap: 12px; color: rgba(14, 27, 48, 0.8); font-size: 12px; letter-spacing: 0.05em; } .scc-bullet { width: 6px; height: 6px; border-radius: 99px; background: #688F9D; } .scc-investment { padding: 24px; background: rgba(217, 232, 235, 0.3); border-radius: 16px; border: 1px solid rgba(104, 143, 157, 0.1); margin-bottom: 40px; position: relative; z-index: 2; } .scc-inv-label { font-size: 10px; text-transform: uppercase; letter-spacing: 0.2em; color: #688F9D; margin-bottom: 4px; font-weight: 700; } .scc-inv-price { font-family: 'Cormorant Garamond', serif; font-size: 24px; color: #0E1B30; } .scc-inv-unit { font-family: 'Lato', sans-serif; font-size: 14px; text-transform: uppercase; letter-spacing: 0.2em; opacity: 0.4; } .scc-inv-sub { font-size: 12px; color: rgba(14, 27, 48, 0.4); margin-top: 4px; } .scc-btn { margin-top: auto; display: inline-flex; align-items: center; justify-content: center; padding: 16px 32px; background: #1D3152; border: 1px solid #1D3152; border-radius: 99px; text-decoration: none !important; overflow: hidden; color: #FFFFFF !important; font-size: 14px; letter-spacing: 2px; text-transform: uppercase; font-weight: 700; transition: all 0.5s ease; box-shadow: 0 10px 20px -5px rgba(29, 49, 82, 0.2); } .scc-btn:hover { background: #FFFFFF !important; color: #1D3152 !important; border-color: #1D3152 !important; box-shadow: 0 15px 30px -10px rgba(29, 49, 82, 0.15); transform: translateY(-2px); } .scc-btn-circle { width: 32px; height: 32px; background: rgba(255, 255, 255, 0.2); border-radius: 99px; display: flex; align-items: center; justify-content: center; margin-right: 12px; transition: all 0.5s ease; } .scc-btn:hover .scc-btn-circle { background: #1D3152; color: #FFFFFF; } .scc-reveal { opacity: 0; transform: translateY(30px); animation: scc-fade-up 1.2s cubic-bezier(0.2, 0.8, 0.2, 1) forwards; } .scc-delay-2 { animation-delay: 0.4s; } @keyframes scc-fade-up { to { opacity: 1; transform: translateY(0); } } @media (max-width: 992px) { .scc-grid { flex-direction: column; } .scc-img-col { width: 100%; } .scc-text-col { width: 100%; margin-left: 0; padding-top: 24px; margin-top: -48px; } .scc-card { padding: 40px; } .scc-title { font-size: 36px; } } @media (max-width: 480px) { .scc-card { padding: 32px 24px; } .scc-wrapper { padding-top: 80px; padding-bottom: 120px; } }</style>"
