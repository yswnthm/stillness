            "html": "<div class='sre-wrapper sre-reveal'><div class='sre-inner'><div class='sre-header'>The Sensory Path</div><div class='sre-grid'><div class='sre-item'><div class='sre-icon-wrap'><i class='fas fa-water sre-icon'></i></div><h4 class='sre-title'>Immersion</h4><p class='sre-desc'>Weightless release</p></div><div class='sre-item'><div class='sre-icon-wrap'><i class='fas fa-sparkles sre-icon'></i></div><h4 class='sre-title'>Frequency</h4><p class='sre-desc'>Sound as healing</p></div><div class='sre-item'><div class='sre-icon-wrap'><i class='fas fa-wind sre-icon'></i></div><h4 class='sre-title'>Breath</h4><p class='sre-desc'>The primary tool</p></div><div class='sre-item'><div class='sre-icon-wrap'><i class='fas fa-sun sre-icon'></i></div><h4 class='sre-title'>Ritual</h4><p class='sre-desc'>Sacred habit</p></div></div></div></div><style>.sre-wrapper { padding: 160px 48px; background: rgba(217, 232, 235, 0.3); border-radius: 80px; margin-bottom: 240px; font-family: 'Lato', sans-serif; } .sre-header { text-align: center; margin-bottom: 96px; text-transform: uppercase; letter-spacing: 0.4em; font-size: 10px; color: #688F9D; font-weight: 700; } .sre-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 64px; } .sre-item { text-align: center; cursor: pointer; text-decoration: none !important; } .sre-icon-wrap { width: 80px; height: 80px; margin: 0 auto 32px; border: 1px solid rgba(14, 27, 48, 0.1); border-radius: 99px; display: flex; align-items: center; justify-content: center; background: #FFFFFF; transition: all 0.7s ease; } .sre-icon { font-size: 24px; color: #688F9D; transition: transform 0.7s ease; } .sre-item:hover .sre-icon-wrap { transform: scale(1.1); border-color: #688F9D; } .sre-item:hover .sre-icon { transform: rotate(12deg); } .sre-title { font-family: 'Cormorant Garamond', serif; font-size: 20px; font-weight: 400; color: #0E1B30; margin: 0 0 8px; line-height: 1.2; transition: color 0.3s ease; } .sre-item:hover .sre-title { color: #688F9D; } .sre-desc { color: rgba(14, 27, 48, 0.4); font-size: 12px; letter-spacing: 0.2em; text-transform: uppercase; margin: 0; } .sre-reveal { opacity: 0; transform: translateY(30px); animation: sre-fade-up 1.2s cubic-bezier(0.2, 0.8, 0.2, 1) forwards; } @keyframes sre-fade-up { to { opacity: 1; transform: translateY(0); } } @media (max-width: 1024px) { .sre-grid { gap: 32px; } } @media (max-width: 992px) { .sre-grid { grid-template-columns: repeat(2, 1fr); gap: 48px; } .sre-wrapper { padding: 120px 24px; border-radius: 40px; margin-left: 0; margin-right: 0; } } @media (max-width: 576px) { .sre-grid { grid-template-columns: 1fr; } }</style>"
