          "id": "lp_v2_html_testimonials",
          "elType": "widget",
          "settings": {
            "html": "<section class=\"testimonials\">\n  <p class=\"section-label\" style=\"color:var(--seafoam)\">What families say</p>\n  <h2 class=\"section-title\" style=\"color:var(--cream)\">The moments <em>that stayed.</em></h2>\n  <div class=\"testi-grid\">\n    <div class=\"testi-card reveal\">\n      <span class=\"testi-q\">\"</span>\n      <p class=\"testi-text\">My seven-year-old asks for a card every morning now. She calls it her 'feeling check.' I didn't teach her that — the deck did.</p>\n      <span class=\"testi-author\">M.L. · Mom of two · Vancouver</span>\n      <span class=\"testi-deck\">Mini Moments</span>\n    </div>\n    <div class=\"testi-card reveal\">\n      <span class=\"testi-q\">\"</span>\n      <p class=\"testi-text\">The question cards made me realise how rarely I say the things I actually feel about my kids. The conversations from one card are ones I'll remember forever.</p>\n      <span class=\"testi-author\">R.K. · Dad · Calgary</span>\n      <span class=\"testi-deck\">In This Little Life</span>\n    </div>\n    <div class=\"testi-card reveal\">\n      <span class=\"testi-q\">\"</span>\n      <p class=\"testi-text\">I bought both as gifts and kept them for us. Turns out adults need them just as much as kids do.</p>\n      <span class=\"testi-author\">A.T. · Aunt + educator · Toronto</span>\n      <span class=\"testi-deck\">Both decks</span>\n    </div>\n  </div>\n</section>\n<style>\n*,*::before,*::after{margin:0;padding:0;box-sizing:border-box}\n:root{--stone:#0E1B30;--midnight:#1D3152;--seafoam:#688F9D;--wave:#A4B2BA;--breeze:#D9E8EB;--sand:#C4BBB4;--cream:#F7F0EC;--warm:#F2E8DF;}\n/* Force zero spacing on Elementor parent containers */\n.elementor-widget-container, .elementor-widget-html, .elementor-column-wrap, .elementor-widget-wrap { margin: 0 !important; padding: 0 !important; }\n.testimonials{padding:6rem 4rem;background:var(--stone);margin:0 !important;}\n.section-label{font-family:'Jost',sans-serif !important;font-size:0.63rem;letter-spacing:0.42em;text-transform:uppercase;color:var(--seafoam);text-align:center;margin-bottom:1.25rem;display:block}\n.section-title{font-family:'Cormorant Garamond',serif !important;font-size:clamp(1.6rem,3vw,2.8rem);font-weight:300;text-align:center;color:var(--stone);margin-bottom:4rem;line-height:1.2}\n.section-title em{font-style:italic;color:var(--seafoam)}\n.testi-grid{max-width:960px;margin:3.5rem auto 0;display:grid;grid-template-columns:repeat(3,1fr);gap:1.75rem}\n.testi-card{background:rgba(255,255,255,0.04);padding:2rem;border:0.5px solid rgba(164,178,186,0.12)}\n.testi-q{font-family:'Cormorant Garamond',serif !important;font-size:3rem;color:rgba(104,143,157,0.2);line-height:0.5;display:block;margin-bottom:1rem}\n.testi-text{font-family:'Cormorant Garamond',serif !important;font-size:0.98rem;font-style:italic;font-weight:300;color:var(--cream);line-height:1.65;margin-bottom:1.25rem}\n.testi-author{font-family:'Jost',sans-serif !important;font-size:0.63rem;letter-spacing:0.25em;text-transform:uppercase;color:var(--seafoam);display:block}\n.testi-deck{font-family:'Jost',sans-serif !important;font-size:0.6rem;color:rgba(164,178,186,0.35);letter-spacing:0.15em;text-transform:uppercase;margin-top:0.3rem;display:block}\n.reveal{opacity:0;transform:translateY(16px);transition:opacity 0.7s ease,transform 0.7s ease}\n.reveal.visible{opacity:1;transform:translateY(0)}\n@media(max-width:768px){\n.testimonials{padding:5rem 1.5rem}\n.testi-grid{grid-template-columns:1fr}\n}\n</style>\n<script>\nvar observer=new IntersectionObserver(function(entries){entries.forEach(function(e){if(e.isIntersecting)e.target.classList.add('visible')})},{threshold:0.08});\ndocument.querySelectorAll('.reveal').forEach(function(el){observer.observe(el)});\n</script>"
          },
