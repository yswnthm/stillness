          "settings": {
            "html": "<section class=\"hero\">\n  <img class=\"hero-img\" src=\"\" alt=\"Both Stillness card decks spread open\">\n  <div class=\"hero-overlay\"></div>\n  <div class=\"hero-content\">\n    <span class=\"eyebrow\">For children · Ages 5–11 · Stillness</span>\n    <h1 class=\"hero-title\">The years that<br><em>shape everything.</em></h1>\n    <p class=\"hero-sub\">Two decks. One child. One window that won't stay open.</p>\n    <div class=\"hero-btns\">\n      <a href=\"#bundle\" class=\"btn-cream\">Get the bundle · $59 CAD</a>\n      <a href=\"#decks\" class=\"btn-ghost\">See the decks</a>\n    </div>\n  </div>\n  <div class=\"scroll-hint\">\n    <span>Scroll</span>\n    <div class=\"scroll-line\"></div>\n  </div>\n</section>\n<style>\n*,*::before,*::after{margin:0;padding:0;box-sizing:border-box}\n:root{--stone:#0E1B30;--midnight:#1D3152;--seafoam:#688F9D;--wave:#A4B2BA;--breeze:#D9E8EB;--sand:#C4BBB4;--cream:#F7F0EC;--warm:#F2E8DF;}\n/* Force zero spacing on Elementor parent containers */\n.elementor-widget-container, .elementor-widget-html, .elementor-column-wrap, .elementor-widget-wrap { margin: 0 !important; padding: 0 !important; }\n.hero{position:relative;height:100vh;min-height:640px;display:flex;align-items:flex-end;overflow:hidden;margin:0 !important;}\n.hero-img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center top}\n.hero-overlay{position:absolute;inset:0;background:linear-gradient(to top,rgba(14,27,48,0.92) 0%,rgba(14,27,48,0.45) 55%,rgba(14,27,48,0.15) 100%)}\n.hero-content{position:relative;z-index:2;padding:0 4rem 6rem;max-width:820px}\n.eyebrow{font-size:0.65rem;letter-spacing:0.42em;text-transform:uppercase;color:var(--breeze);margin-bottom:1.75rem;display:block;opacity:0;animation:fadeUp 1s ease 0.4s forwards}\n.hero-title{font-family:'Cormorant Garamond',serif !important;font-size:clamp(3.5rem,9vw,7.5rem);font-weight:300;line-height:0.95;color:var(--cream);margin-bottom:1.5rem;opacity:0;animation:fadeUp 1s ease 0.7s forwards}\n.hero-title em{font-style:italic;color:var(--wave);display:block}\n.hero-sub{font-family:'Cormorant Garamond',serif !important;font-size:clamp(1rem,2vw,1.4rem);font-style:italic;color:var(--wave);max-width:500px;line-height:1.65;margin-bottom:2.5rem;opacity:0;animation:fadeUp 1s ease 1s forwards}\n.hero-btns{display:flex;gap:1rem;flex-wrap:wrap;opacity:0;animation:fadeUp 1s ease 1.3s forwards}\n.btn-cream{font-family:'Jost',sans-serif !important;font-size:0.72rem;font-weight:500;letter-spacing:0.2em;text-transform:uppercase !important;color:var(--stone) !important;background:var(--cream) !important;border:none;padding:1rem 2.2rem;cursor:pointer;transition:all 0.3s;text-decoration:none !important;display:inline-block}\n.btn-cream:link,.btn-cream:visited,.btn-cream:hover,.btn-cream:focus,.btn-cream:active{color:var(--stone) !important;text-decoration:none !important}\n.btn-cream:hover{background:var(--breeze) !important;transform:translateY(-2px)}\n.btn-ghost{font-family:'Jost',sans-serif !important;font-size:0.7rem;letter-spacing:0.2em;text-transform:uppercase !important;color:var(--wave) !important;background:transparent !important;border:0.5px solid rgba(217,232,235,0.4) !important;padding:1rem 2.2rem;cursor:pointer;transition:all 0.3s;text-decoration:none !important;display:inline-block}\n.btn-ghost:link,.btn-ghost:visited,.btn-ghost:hover,.btn-ghost:focus,.btn-ghost:active{color:var(--wave) !important;text-decoration:none !important}\n.btn-ghost:hover{border-color:var(--wave) !important;color:var(--cream) !important}\n.scroll-hint{position:absolute;bottom:2.5rem;right:4rem;z-index:2;display:flex;flex-direction:column;align-items:center;gap:0.5rem;opacity:0;animation:fadeUp 1s ease 1.8s forwards}\n.scroll-hint span{font-family:'Jost',sans-serif !important;font-size:0.58rem;letter-spacing:0.35em;text-transform:uppercase;color:var(--seafoam);writing-mode:vertical-rl}\n.scroll-line{width:0.5px;height:52px;background:linear-gradient(to bottom,transparent,var(--seafoam));animation:scrollPulse 2s ease-in-out infinite}\n@keyframes fadeUp{from{opacity:0;transform:translateY(22px)}to{opacity:1;transform:translateY(0)}}\n@keyframes scrollPulse{0%,100%{opacity:0.4}50%{opacity:1}}\n@media(max-width:768px){\n.hero-content{padding:0 1.5rem 5rem}\n.scroll-hint{display:none}\n}\n</style>"
