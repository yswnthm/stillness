          "settings": {
            "html": "<div class=\"window-strip\">\n  <h2>They are <em>exactly this age</em> once.<br>That is the whole urgency.</h2>\n  <p style=\"margin-top:1rem\">The window between 5 and 11 is when a child's inner world is most actively shaped by the people around them. After that the window doesn't close — but it narrows.</p>\n</div>\n<style>\n*,*::before,*::after{margin:0;padding:0;box-sizing:border-box}\n:root{--stone:#0E1B30;--midnight:#1D3152;--seafoam:#688F9D;--wave:#A4B2BA;--breeze:#D9E8EB;--sand:#C4BBB4;--cream:#F7F0EC;--warm:#F2E8DF;}\n/* Force zero spacing on Elementor parent containers */\n.elementor-widget-container, .elementor-widget-html, .elementor-column-wrap, .elementor-widget-wrap { margin: 0 !important; padding: 0 !important; }\n.window-strip{background:var(--stone);padding:4.5rem 4rem;text-align:center;margin:0 !important;}\n.window-strip h2{font-family:'Cormorant Garamond',serif !important;font-size:clamp(1.6rem,3vw,2.8rem);font-weight:300;color:var(--cream);line-height:1.2;margin-bottom:1rem}\n.window-strip h2 em{font-style:italic;color:var(--wave)}\n.window-strip p{font-family:'Jost',sans-serif !important;font-size:0.88rem;color:var(--wave);max-width:520px;margin:0 auto;line-height:1.9;opacity:0.8}\n@media(max-width:768px){\n.window-strip{padding:5rem 1.5rem}\n}\n</style>"
          },
