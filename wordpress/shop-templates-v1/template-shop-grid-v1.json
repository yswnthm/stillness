                {
                    "id": "shop_products_grid",
                    "elType": "widget",
                    "settings": {
                        "html": "<div class='shop-product-grid'><div class='shop-card'><div class='shop-img-wrap'><div class='shop-badge'>Best Seller</div><img src='https://images.unsplash.com/photo-1544367567-0f2fcb009e0b?q=80&w=1000&auto=format&fit=crop' alt='The Starter Stillness Kit' /><div class='shop-add-btn'><button>Add to Cart</button></div></div><div class='shop-info'><div class='shop-title-row'><h3>The Starter Stillness Kit</h3><span class='shop-price'>$120.00</span></div><p>Everything you need to begin your daily practice.</p><div class='shop-view-more'>View Details <i class='fas fa-arrow-right'></i></div></div></div><div class='shop-card'><div class='shop-img-wrap'><img src='https://images.unsplash.com/photo-1601925260368-ae2f83cf8b7f?q=80&w=1000&auto=format&fit=crop' alt='Sustainable Ritual Mat' /><div class='shop-add-btn'><button>Add to Cart</button></div></div><div class='shop-info'><div class='shop-title-row'><h3>Sustainable Ritual Mat</h3><span class='shop-price'>$85.00</span></div><p>Earth-friendly, non-slip base for your daily journey.</p><div class='shop-view-more'>View Details <i class='fas fa-arrow-right'></i></div></div></div><div class='shop-card'><div class='shop-img-wrap'><img src='https://images.unsplash.com/photo-1608571423902-eed4a5ad8108?q=80&w=1000&auto=format&fit=crop' alt='Signature Aromatherapy Blend' /><div class='shop-add-btn'><button>Add to Cart</button></div></div><div class='shop-info'><div class='shop-title-row'><h3>Signature Aromatherapy Blend</h3><span class='shop-price'>$45.00</span></div><p>Grounding notes of cedar, frankincense, and lavender.</p><div class='shop-view-more'>View Details <i class='fas fa-arrow-right'></i></div></div></div></div><style>.shop-product-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 48px 32px; } @media (max-width: 1024px) { .shop-product-grid { grid-template-columns: 1fr 1fr; } } @media (max-width: 768px) { .shop-product-grid { grid-template-columns: 1fr; gap: 48px; } }.shop-card { display: flex; flex-direction: column; cursor: pointer; text-decoration: none; color: inherit; }.shop-img-wrap { position: relative; aspect-ratio: 4/5; overflow: hidden; border-radius: 16px; margin-bottom: 24px; background: rgba(196, 187, 180, 0.2); }.shop-img-wrap img { width: 100%; height: 100%; object-fit: cover; transition: transform 1s ease-out; }.shop-card:hover .shop-img-wrap img { transform: scale(1.05); }.shop-badge { position: absolute; top: 16px; left: 16px; z-index: 10; background: rgba(255, 255, 255, 0.9); backdrop-filter: blur(4px); padding: 4px 12px; border-radius: 99px; font-family: 'Lato', sans-serif; font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; color: #0E1B30; }.shop-add-btn { position: absolute; bottom: 24px; left: 0; right: 0; display: flex; justify-content: center; opacity: 0; transform: translateY(16px); transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1); }.shop-card:hover .shop-add-btn { opacity: 1; transform: translateY(0); }.shop-add-btn button { background: #688F9D; color: #FFFFFF; border: none; padding: 12px 32px; border-radius: 99px; font-family: 'Lato', sans-serif; font-size: 12px; text-transform: uppercase; letter-spacing: 2px; cursor: pointer; box-shadow: 0 8px 24px rgba(104, 143, 157, 0.2); transition: background 0.3s ease; }.shop-add-btn button:hover { background: #5a7d8a; }.shop-info { flex-grow: 1; display: flex; flex-direction: column; }.shop-title-row { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 8px; }.shop-info h3 { font-family: 'Cormorant Garamond', serif; font-size: 22px; color: #0E1B30; margin: 0; line-height: 1.2; transition: color 0.3s ease; }.shop-card:hover h3 { color: #688F9D; }.shop-price { font-family: 'Lato', sans-serif; font-weight: 700; color: #0E1B30; font-size: 16px; }.shop-info p { font-family: 'Lato', sans-serif; font-size: 14px; line-height: 1.5; color: rgba(14, 27, 48, 0.6); margin: 0 0 16px; }.shop-view-more { margin-top: auto; display: flex; align-items: center; gap: 8px; font-family: 'Lato', sans-serif; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 2px; color: #688F9D; opacity: 0; transition: opacity 0.3s ease; }.shop-card:hover .shop-view-more { opacity: 1; }</style>"
