                    "elType": "widget",
                    "settings": {
                        "html": "<div class='shop-controls'><div class='shop-categories'><a href='#' class='active'>All</a><a href='#'>Ritual Kits</a><a href='#'>Essentials</a><a href='#'>Subscriptions</a></div><button class='shop-filter-btn'><i class='fas fa-filter'></i> Filter & Sort <i class='fas fa-chevron-down'></i></button></div><style>.shop-controls { display: flex; justify-content: space-between; align-items: center; margin-bottom: 48px; border-bottom: 1px solid rgba(14, 27, 48, 0.1); padding-bottom: 24px; position: relative; } .shop-categories { display: flex; gap: 32px; overflow-x: auto; scrollbar-width: none; } .shop-categories::-webkit-scrollbar { display: none; } .shop-categories a { text-decoration: none; font-family: 'Lato', sans-serif; font-size: 14px; text-transform: uppercase; letter-spacing: 2px; color: rgba(14, 27, 48, 0.5); transition: color 0.3s ease; white-space: nowrap; } .shop-categories a.active { color: #688F9D; font-weight: 700; } .shop-categories a:hover { color: #0E1B30; } .shop-filter-btn { background: none; border: none; font-family: 'Lato', sans-serif; font-size: 14px; color: rgba(14, 27, 48, 0.7); display: flex; align-items: center; gap: 8px; cursor: pointer; transition: color 0.3s ease; } .shop-filter-btn:hover { color: #0E1B30; } .shop-filter-btn i { font-size: 12px; transition: transform 0.3s ease; } .shop-filter-btn:hover .fa-chevron-down { transform: translateY(2px); } @media (max-width: 768px) { .shop-filter-btn { display: none; } .shop-controls { margin-bottom: 32px; } }</style>"
                    },
