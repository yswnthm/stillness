                        {
                            "id": "packages-intro-html",
                            "elType": "widget",
                            "settings": {
                                "html": "<div class='packages-intro-content'><div class='pi-left'><div class='pi-badge-wrap'><span class='pi-badge-line'></span><span class='pi-badge-label'>Our Packages</span></div><h2 class='pi-headline'>Three ways to bring<br><span class='italic'>Stillness to your team.</span></h2></div><div class='pi-right'><p class='pi-description'>Every package is fully facilitated by our certified team. We bring everything your people need to just show up — and leave different.</p></div></div><style>.packages-intro-content { display: grid; grid-template-columns: 1fr 1fr; gap: 80px; align-items: flex-end; max-width: 1200px; margin: 0 auto; } .pi-badge-wrap { display: flex; align-items: center; gap: 20px; margin-bottom: 24px; } .pi-badge-line { width: 40px; height: 1px; background: #688F9D; } .pi-badge-label { font-family: 'Lato', sans-serif; font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: 4px; color: #688F9D; } .pi-headline { font-family: 'Cormorant Garamond', serif !important; font-size: 64px !important; line-height: 1.1 !important; color: #FFFFFF !important; margin: 0; font-weight: 400; } .pi-headline .italic { font-style: italic !important; color: #688F9D !important; } .pi-description { font-family: 'Lato', sans-serif !important; font-size: 18px !important; line-height: 1.8 !important; color: rgba(255, 255, 255, 0.6) !important; margin: 0; font-weight: 300; max-width: 450px; } @media (max-width: 1024px) { .packages-intro-content { grid-template-columns: 1fr; gap: 40px; text-align: left; } .pi-description { max-width: 100%; } } @media (max-width: 768px) { .pi-headline { font-size: 42px !important; } }</style>"
                            },
