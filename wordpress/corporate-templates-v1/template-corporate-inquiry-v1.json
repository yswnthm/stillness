{
    "version": "0.4",
    "title": "Corporate - Inquiry Form",
    "type": "section",
    "content": [
        {
            "id": "corporate-inquiry-wrapper",
            "elType": "container",
            "settings": {
                "content_width": "boxed",
                "boxed_width": {
                    "unit": "px",
                    "size": 1140
                },
                "flex_direction": "column",
                "flex_align_items": "center",
                "padding": {
                    "unit": "px",
                    "top": "120",
                    "bottom": "120",
                    "right": "40",
                    "left": "40",
                    "isLinked": false
                },
                "background_background": "classic",
                "background_color": "#FFFFFF"
            },
            "elements": [
                {
                    "id": "inquiry-heading",
                    "elType": "widget",
                    "widgetType": "heading",
                    "settings": {
                        "title": "Start a Conversation",
                        "align": "center",
                        "title_color": "#1D3152",
                        "typography_typography": "custom",
                        "typography_font_family": "Cormorant Garamond",
                        "typography_font_size": {
                            "unit": "px",
                            "size": 48
                        },
                        "typography_font_weight": "400",
                        "margin": {
                            "unit": "px",
                            "top": "0",
                            "bottom": "24",
                            "right": "0",
                            "left": "0",
                            "isLinked": false
                        }
                    }
                },
                {
                    "id": "inquiry-text",
                    "elType": "widget",
                    "widgetType": "text-editor",
                    "settings": {
                        "editor": "<p style=\"text-align: center; font-family: 'Lato', sans-serif; font-weight: 300; font-size: 18px; line-height: 1.6; color: rgba(29, 49, 82, 0.6); max-width: 672px; margin: 0 auto;\">Custom programs tailored to your organization's unique rhythm.</p>",
                        "margin": {
                            "unit": "px",
                            "top": "0",
                            "bottom": "64",
                            "right": "0",
                            "left": "0",
                            "isLinked": false
                        }
                    }
                },
                {
                    "id": "inquiry-html",
                    "elType": "widget",
                    "widgetType": "html",
                    "settings": {
                        "html": "<div class=\"inquiry-form\">\n  <input type=\"text\" class=\"inquiry-field\" placeholder=\"Company Name\" required />\n  <input type=\"email\" class=\"inquiry-field\" placeholder=\"Work Email\" required />\n  <textarea class=\"inquiry-field textarea-field\" placeholder=\"Tell us about your team's needs...\" rows=\"4\"></textarea>\n  <button type=\"button\" class=\"inquiry-button\">SEND INQUIRY</button>\n</div>\n\n<style>\n.inquiry-form {\n  max-width: 576px;\n  margin: 0 auto;\n  background-color: rgba(217, 232, 235, 0.5);\n  padding: 3rem 4rem;\n  border-radius: 24px;\n  box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);\n  border: 1px solid rgba(14, 27, 48, 0.05);\n  display: grid;\n  grid-template-columns: 1fr;\n  gap: 1.5rem;\n  width: 100%;\n  box-sizing: border-box;\n}\n\n.inquiry-field {\n  width: 100%;\n  padding: 1rem 1.5rem;\n  background-color: #FFFFFF;\n  border-radius: 9999px;\n  border: 1px solid rgba(14, 27, 48, 0.1);\n  font-family: 'Lato', sans-serif;\n  font-size: 16px;\n  color: #0E1B30;\n  outline: none;\n  transition: border-color 0.3s ease;\n  box-sizing: border-box;\n}\n\n.textarea-field {\n  border-radius: 16px;\n  resize: vertical;\n}\n\n.inquiry-field:focus {\n  border-color: #688F9D;\n}\n\n.inquiry-button {\n  width: 100%;\n  padding: 1rem 2rem;\n  background-color: #1D3152;\n  color: #F7F0EC;\n  border: none;\n  border-radius: 9999px;\n  font-family: 'Lato', sans-serif;\n  font-weight: 700;\n  font-size: 11px;\n  letter-spacing: 0.25em;\n  text-transform: uppercase;\n  cursor: pointer;\n  transition: all 0.3s ease;\n  margin-top: 0.5rem;\n  box-sizing: border-box;\n}\n\n.inquiry-button:hover {\n  background-color: #0E1B30;\n  transform: translateY(-2px);\n  box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);\n}\n\n@media (max-width: 768px) {\n  .inquiry-form {\n    padding: 2rem;\n  }\n}\n</style>"
                    }
                }
            ]
        }
    ],
    "page_settings": []
}