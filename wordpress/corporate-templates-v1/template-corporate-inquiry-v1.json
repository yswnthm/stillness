{
    "version": "0.4",
    "title": "Corporate - Minimal Inquiry Form",
    "type": "section",
    "content": [
        {
            "id": "corp_inquiry_minimal",
            "elType": "container",
            "settings": {
                "content_width": "full",
                "padding": { "unit": "px", "top": "160", "bottom": "160", "right": "40", "left": "40", "isLinked": false },
                "background_background": "classic",
                "background_color": "#FFFFFF",
                "flex_direction": "column",
                "flex_align_items": "center"
            },
            "elements": [
                {
                    "id": "inquiry_header_min",
                    "elType": "container",
                    "settings": {
                        "content_width": "boxed",
                        "boxed_width": { "unit": "px", "size": 800 },
                        "flex_direction": "column",
                        "flex_align_items": "center",
                        "margin": { "unit": "px", "bottom": "64", "isLinked": false }
                    },
                    "elements": [
                        {
                            "id": "inquiry_h2_min",
                            "elType": "widget",
                            "widgetType": "heading",
                            "settings": {
                                "title": "Start a Conversation.",
                                "align": "center",
                                "title_color": "#1D3152",
                                "typography_typography": "custom",
                                "typography_font_family": "Cormorant Garamond",
                                "typography_font_size": { "unit": "px", "size": 56 },
                                "typography_font_weight": "300",
                                "margin": { "unit": "px", "bottom": "24", "isLinked": false }
                            }
                        },
                        {
                            "id": "inquiry_p_min",
                            "elType": "widget",
                            "widgetType": "text-editor",
                            "settings": {
                                "editor": "<p style=\"text-align: center; font-family: 'Lato', sans-serif; font-size: 18px; color: rgba(29, 49, 82, 0.5); font-weight: 300; max-width: 500px; margin: 0 auto;\">Custom programs tailored to your organization's unique rhythm.</p>"
                            }
                        }
                    ]
                },
                {
                    "id": "inquiry_form_wrap_min",
                    "elType": "container",
                    "settings": {
                        "width": { "unit": "px", "size": 600 },
                        "content_width": "full",
                        "flex_align_self": "center"
                    },
                    "elements": [
                        {
                            "id": "inquiry_metform_min_css",
                            "elType": "widget",
                            "widgetType": "shortcode",
                            "settings": {
                                "shortcode": "<div class='stillness-minimal-form'>[metform form_id=\"4938\"]</div><style>/* 1. Force Pure Vertical Layout */ .stillness-minimal-form .row, .stillness-minimal-form .mf-row { display: flex !important; flex-direction: column !important; margin: 0 !important; gap: 24px !important; } .stillness-minimal-form [class*='col-'] { width: 100% !important; max-width: 100% !important; flex: 1 1 100% !important; padding: 0 !important; margin: 0 !important; } /* 2. Hide Titles, Labels, and MetForm Bloat */ .stillness-minimal-form h2, .stillness-minimal-form h3, .stillness-minimal-form label, .stillness-minimal-form .mf-section-title, .stillness-minimal-form .mf-input-label { display: none !important; } /* 3. Ultra-Minimal Inputs */ .stillness-minimal-form input:not([type='submit']), .stillness-minimal-form textarea, .stillness-minimal-form .mf-input { width: 100% !important; padding: 16px 0 !important; border: none !important; border-bottom: 1px solid rgba(29, 49, 82, 0.15) !important; background: transparent !important; font-family: 'Lato', sans-serif !important; font-size: 16px !important; color: #1D3152 !important; box-sizing: border-box !important; border-radius: 0 !important; outline: none !important; transition: border-color 0.4s ease !important; } /* 4. Textarea setup */ .stillness-minimal-form textarea { min-height: 120px !important; resize: none !important; } /* Focus states */ .stillness-minimal-form input:focus, .stillness-minimal-form textarea:focus { border-bottom-color: #688F9D !important; } .stillness-minimal-form input::placeholder, .stillness-minimal-form textarea::placeholder { color: rgba(29, 49, 82, 0.4) !important; font-weight: 300 !important; } /* 5. Elegant Submit Button */ .stillness-minimal-form .mf-btn-wraper { text-align: center !important; margin-top: 32px !important; } .stillness-minimal-form button[type='submit'], .stillness-minimal-form .metform-btn-submit { display: inline-block !important; background: #1D3152 !important; color: #FFFFFF !important; border: none !important; padding: 18px 48px !important; border-radius: 9999px !important; font-family: 'Lato', sans-serif !important; font-weight: 700 !important; text-transform: uppercase !important; letter-spacing: 2px !important; font-size: 11px !important; cursor: pointer !important; transition: all 0.4s ease !important; } .stillness-minimal-form button[type='submit']:hover, .stillness-minimal-form .metform-btn-submit:hover { background: #688F9D !important; transform: translateY(-2px); }</style>"
                            }
                        }
                    ]
                }
            ]
        }
    ],
    "page_settings": []
}
