{
    "version": "0.4",
    "title": "Corporate - Flow V1",
    "type": "section",
    "content": [
        {
            "id": "corporate-flow-wrapper",
            "elType": "container",
            "settings": {
                "content_width": "full",
                "padding": {
                    "unit": "px",
                    "top": "120",
                    "bottom": "120",
                    "right": "40",
                    "left": "40",
                    "isLinked": false
                },
                "background_background": "classic",
                "background_color": "#F8F5F2"
            },
            "elements": [
                {
                    "id": "flow-inner-container",
                    "elType": "container",
                    "settings": {
                        "content_width": "boxed",
                        "boxed_width": {
