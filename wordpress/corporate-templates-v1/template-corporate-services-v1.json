                    "id": "services-grid-html",
                    "elType": "widget",
                    "widgetType": "html",
                    "settings": {
                        "html": "<div class=\"services-grid\">\n  <div class=\"service-card\">\n    <div class=\"service-bg\">\n      <img src=\"https://picsum.photos/seed/corporate1/800/600\" alt=\"Team Float Rituals\" />\n    </div>\n    <div class=\"service-content\">\n      <div class=\"service-icon\">\n        <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2\"></path><circle cx=\"9\" cy=\"7\" r=\"4\"></circle><path d=\"M22 21v-2a4 4 0 0 0-3-3.87\"></path><path d=\"M16 3.13a4 4 0 0 1 0 7.75\"></path></svg>\n      </div>\n      <h3 class=\"service-title\">Team Float Rituals</h3>\n      <p class=\"service-desc\">Structured decompression sessions for small teams to reset together.</p>\n    </div>\n  </div>\n  \n  <div class=\"service-card\">\n    <div class=\"service-bg\">\n      <img src=\"https://picsum.photos/seed/corporate2/800/600\" alt=\"Executive Retreats\" />\n    </div>\n    <div class=\"service-content\">\n      <div class=\"service-icon\">\n        <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"2\" y=\"7\" width=\"20\" height=\"14\" rx=\"2\" ry=\"2\"></rect><path d=\"M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16\"></path></svg>\n      </div>\n      <h3 class=\"service-title\">Executive Retreats</h3>\n      <p class=\"service-desc\">Multi-day deep rest intensives for leadership teams in high-stress environments.</p>\n    </div>\n  </div>\n  \n  <div class=\"service-card\">\n    <div class=\"service-bg\">\n      <img src=\"https://picsum.photos/seed/corporate3/800/600\" alt=\"Performance Workshops\" />\n    </div>\n    <div class=\"service-content\">\n      <div class=\"service-icon\">\n        <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polygon points=\"13 2 3 14 12 14 11 22 21 10 12 10 13 2\"></polygon></svg>\n      </div>\n      <h3 class=\"service-title\">Performance Workshops</h3>\n      <p class=\"service-desc\">Breathwork and sound healing optimized for focus and creative flow.</p>\n    </div>\n  </div>\n</div>\n\n<style>\n.services-grid {\n  display: grid;\n  grid-template-columns: repeat(3, 1fr);\n  gap: 3rem;\n  width: 100%;\n}\n\n.service-card {\n  position: relative;\n  padding: 2rem;\n  border-radius: 24px;\n  background-color: #F7F0EC;\n  border: 1px solid rgba(14, 27, 48, 0.05);\n  overflow: hidden;\n  cursor: pointer;\n  transition: all 0.5s ease;\n}\n\n.service-card:hover {\n  border-color: rgba(104, 143, 157, 0.3);\n  box-shadow: 0 20px 25px -5px rgba(104, 143, 157, 0.05), 0 10px 10px -5px rgba(104, 143, 157, 0.02);\n}\n\n.service-bg {\n  position: absolute;\n  inset: 0;\n  border-radius: 24px;\n  overflow: hidden;\n  pointer-events: none;\n}\n\n.service-bg img {\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n  opacity: 0.4;\n  transition: transform 0.5s ease-out;\n}\n\n.service-card:hover .service-bg img {\n  transform: scale(1.1);\n}\n\n.service-content {\n  position: relative;\n  z-index: 10;\n}\n\n.service-icon {\n  width: 48px;\n  height: 48px;\n  border-radius: 50%;\n  border: 1px solid #688F9D;\n  color: #688F9D;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  margin-bottom: 1.5rem;\n  transition: all 0.5s ease;\n}\n\n.service-card:hover .service-icon {\n  background-color: #688F9D;\n  color: #FFFFFF;\n}\n\n.service-icon svg {\n  width: 24px;\n  height: 24px;\n}\n\n.service-title {\n  font-family: 'Cormorant Garamond', serif;\n  font-size: 20px;\n  color: #1D3152;\n  margin-bottom: 1rem;\n  font-weight: 400;\n}\n\n.service-desc {\n  font-family: 'Lato', sans-serif;\n  font-weight: 300;\n  font-size: 16px;\n  line-height: 1.6;\n  color: rgba(29, 49, 82, 0.6);\n  margin: 0;\n}\n\n@media (max-width: 1024px) {\n  .services-grid {\n    grid-template-columns: 1fr;\n    gap: 2rem;\n  }\n}\n</style>"
