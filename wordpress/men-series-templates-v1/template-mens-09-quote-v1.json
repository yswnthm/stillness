          "settings": {
            "html": "<section class=\"ms-quote-section\">\n  <div class=\"ms-quote-bg\"></div>\n  <div class=\"ms-section-inner\">\n    <div class=\"ms-quote-inner\">\n      <div class=\"ms-quote-label\">From Session 01 &nbsp;·&nbsp; March 27</div>\n      <blockquote class=\"ms-quote-text\">\"I didn't know I needed this until I walked out of it. The sound hit something I didn't have words for. I'm coming back.\"</blockquote>\n      <div class=\"ms-quote-attr\">\n        <div class=\"ms-quote-name\">— A., Attendee</div>\n        <div class=\"ms-quote-ctx\">Session 01 &nbsp;·&nbsp; Vancouver, BC</div>\n      </div>\n      <img src=\"\" alt=\"Men from Session 01\" class=\"ms-group-photo\" loading=\"lazy\">\n      <div class=\"ms-group-note\">Session 01 &nbsp;·&nbsp; 12 men &nbsp;·&nbsp; The Shop Theatre, Vancouver</div>\n    </div>\n  </div>\n</section>\n\n<style>\n@import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400;1,500&family=Jost:wght@200;300;400;500&display=swap');\n\n*,*::before,*::after{box-sizing:border-box !important}\n\n:root{\n  --ms-stone:#0E1B30;\n  --ms-cream:#F7F0EC;\n  --ms-wave:#7A8F96;\n  --ms-sand:#C4BBB4;\n}\n\n.ms-quote-section {\n  padding: 110px 0 !important;\n  background: var(--ms-stone) !important;\n  position: relative !important;\n  overflow: hidden !important;\n}\n\n.ms-quote-bg {\n  position: absolute !important;\n  inset: 0 !important;\n  background-image: url('') !important;\n  background-size: cover !important;\n  background-position: center top !important;\n  opacity: 0.12 !important;\n}\n\n.ms-section-inner {\n  max-width: 1080px !important;\n  margin: 0 auto !important;\n  padding: 0 52px !important;\n}\n\n.ms-quote-inner {\n  position: relative !important;\n  z-index: 1 !important;\n  display: flex !important;\n  flex-direction: column !important;\n  align-items: center !important;\n  text-align: center !important;\n  gap: 36px !important;\n}\n\n.ms-quote-label {\n  font-family: 'Jost', sans-serif !important;\n  font-size: 9px !important;\n  letter-spacing: 0.3em !important;\n  text-transform: uppercase !important;\n  color: var(--ms-sand) !important;\n  opacity: 0.7 !important;\n}\n\n.ms-quote-text {\n  font-family: 'Cormorant Garamond', serif !important;\n  font-size: clamp(24px, 3.5vw, 38px) !important;\n  font-style: italic !important;\n  font-weight: 300 !important;\n  line-height: 1.45 !important;\n  max-width: 700px !important;\n  color: var(--ms-cream) !important;\n  margin: 0 !important;\n}\n\n.ms-quote-attr {\n  display: flex !important;\n  flex-direction: column !important;\n  align-items: center !important;\n  gap: 5px !important;\n}\n\n.ms-quote-name {\n  font-family: 'Jost', sans-serif !important;\n  font-size: 11px !important;\n  letter-spacing: 0.2em !important;\n  text-transform: uppercase !important;\n  color: var(--ms-sand) !important;\n}\n\n.ms-quote-ctx {\n  font-family: 'Jost', sans-serif !important;\n  font-size: 10px !important;\n  color: var(--ms-wave) !important;\n  opacity: 0.6 !important;\n}\n\n.ms-group-photo {\n  width: 100% !important;\n  max-width: 660px !important;\n  border-radius: 3px !important;\n  opacity: 0.88 !important;\n  display: block !important;\n}\n\n.ms-group-note {\n  font-family: 'Jost', sans-serif !important;\n  font-size: 10px !important;\n  color: var(--ms-wave) !important;\n  opacity: 0.45 !important;\n  letter-spacing: 0.1em !important;\n}\n\n@media(max-width:768px){\n  .ms-section-inner{padding:0 24px !important}\n}\n</style>"
