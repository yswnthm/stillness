          "id": "ms_html_hero",
          "elType": "widget",
          "settings": {
            "html": "<section class=\"ms-hero\">\n  <div class=\"ms-hero-left\">\n    <div class=\"ms-hero-series-tag f1\">Men's Series &nbsp;·&nbsp; Monthly &nbsp;·&nbsp; Vancouver</div>\n    <h1 class=\"ms-hero-title f2\">A monthly space<br>for men to<br><em>come back to<br>themselves.</em></h1>\n    <p class=\"ms-hero-sub f3\">Sound healing, breathwork, and journaling — held in candlelight, once a month. No performance. No pressure. Just structured rest for men who are ready for something different.</p>\n    <div class=\"ms-hero-pills f4\">\n      <span class=\"ms-pill\">Sound Healing</span>\n      <span class=\"ms-pill\">Breathwork</span>\n      <span class=\"ms-pill\">Journaling</span>\n      <span class=\"ms-pill\">Men Only</span>\n      <span class=\"ms-pill\">Monthly</span>\n    </div>\n    <a href=\"#join\" class=\"ms-btn-primary f5\">Join the Community <span class=\"ms-btn-arrow\">→</span></a>\n    <div class=\"ms-hero-scroll f5\">\n      <div class=\"ms-hero-scroll-line\"></div>\n      <div class=\"ms-hero-scroll-txt\">Scroll to learn more</div>\n    </div>\n  </div>\n  <div class=\"ms-hero-right\">\n    <img src=\"\" alt=\"Men's Series Hero\" loading=\"eager\">\n    <div class=\"ms-hero-right-overlay\"></div>\n  </div>\n</section>\n\n<style>\n@import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400;1,500&family=Jost:wght@200;300;400;500&display=swap');\n\n*,*::before,*::after{box-sizing:border-box !important}\n\n:root{\n  --ms-stone:#0E1B30;\n  --ms-cream:#F7F0EC;\n  --ms-breeze:#D9E8EB;\n  --ms-seafoam:#688F9D;\n  --ms-wave:#7A8F96;\n  --ms-sand:#C4BBB4;\n  --ms-midnight:#1D3152;\n  --ms-warm:#E8DDD6;\n  --ms-amber:#C4935A;\n  --ms-text-body:#3D4F57;\n  --ms-text-light:#7A8F96;\n}\n\n.ms-hero {\n  min-height: 100vh !important;\n  position: relative !important;\n  display: grid !important;\n  grid-template-columns: 1fr 1fr !important;\n  overflow: hidden !important;\n}\n\n.ms-hero-left {\n  display: flex !important;\n  flex-direction: column !important;\n  justify-content: center !important;\n  padding: 120px 56px 80px !important;\n  position: relative !important;\n  z-index: 2 !important;\n  background: var(--ms-cream) !important;\n}\n\n.ms-hero-left::after {\n  content: '' !important;\n  position: absolute !important;\n  right: -1px !important;\n  top: 0 !important;\n  bottom: 0 !important;\n  width: 1px !important;\n  background: linear-gradient(to bottom, transparent, rgba(196,187,180,0.5), transparent) !important;\n}\n\n.ms-hero-right {\n  position: relative !important;\n  overflow: hidden !important;\n}\n\n.ms-hero-right img {\n  width: 100% !important;\n  height: 100% !important;\n  object-fit: cover !important;\n  object-position: center 25% !important;\n  animation: ms-slowzoom 16s ease forwards !important;\n}\n\n@keyframes ms-slowzoom { from { transform: scale(1.06); } to { transform: scale(1.0); } }\n\n.ms-hero-right-overlay {\n  position: absolute !important;\n  inset: 0 !important;\n  background: linear-gradient(to right, rgba(247,240,236,0.25) 0%, transparent 30%) !important;\n}\n\n@keyframes ms-fadeUp { from { opacity: 0; transform: translateY(22px); } to { opacity: 1; transform: translateY(0); } }\n\n.f1 { animation: ms-fadeUp 1.2s 0.1s ease both !important; }\n.f2 { animation: ms-fadeUp 1.2s 0.25s ease both !important; }\n.f3 { animation: ms-fadeUp 1.2s 0.4s ease both !important; }\n.f4 { animation: ms-fadeUp 1.2s 0.55s ease both !important; }\n.f5 { animation: ms-fadeUp 1.2s 0.7s ease both !important; }\n\n.ms-hero-series-tag {\n  display: inline-flex !important;\n  align-items: center !important;\n  gap: 8px !important;\n  font-family: 'Jost', sans-serif !important;\n  font-size: 9px !important;\n  letter-spacing: 0.3em !important;\n  text-transform: uppercase !important;\n  color: var(--ms-amber) !important;\n  margin-bottom: 24px !important;\n}\n\n.ms-hero-series-tag::before {\n  content: '' !important;\n  width: 24px !important;\n  height: 0.5px !important;\n  background: var(--ms-amber) !important;\n}\n\n.ms-hero-title {\n  font-family: 'Cormorant Garamond', serif !important;\n  font-size: clamp(46px, 5.5vw, 72px) !important;\n  font-weight: 300 !important;\n  line-height: 1.06 !important;\n  color: var(--ms-stone) !important;\n  margin-bottom: 24px !important;\n}\n\n.ms-hero-title em {\n  font-style: italic !important;\n  color: var(--ms-seafoam) !important;\n}\n\n.ms-hero-sub {\n  font-family: 'Jost', sans-serif !important;\n  font-size: 13.5px !important;\n  line-height: 1.9 !important;\n  color: var(--ms-text-body) !important;\n  margin-bottom: 36px !important;\n  max-width: 440px !important;\n}\n\n.ms-hero-pills {\n  display: flex !important;\n  gap: 8px !important;\n  flex-wrap: wrap !important;\n  margin-bottom: 40px !important;\n}\n\n.ms-pill {\n  font-family: 'Jost', sans-serif !important;\n  font-size: 8.5px !important;\n  letter-spacing: 0.18em !important;\n  text-transform: uppercase !important;\n  color: var(--ms-text-body) !important;\n  border: 0.5px solid rgba(61,79,87,0.25) !important;\n  padding: 6px 13px !important;\n  border-radius: 20px !important;\n}\n\n.ms-btn-primary {\n  display: inline-flex !important;\n  align-items: center !important;\n  gap: 14px !important;\n  background: var(--ms-stone) !important;\n  color: var(--ms-cream) !important;\n  padding: 16px 36px !important;\n  border-radius: 2px !important;\n  font-family: 'Jost', sans-serif !important;\n  font-size: 10px !important;\n  letter-spacing: 0.25em !important;\n  text-transform: uppercase !important;\n  text-decoration: none !important;\n  font-weight: 400 !important;\n  transition: all 0.3s ease !important;\n  margin-bottom: 48px !important;\n}\n\n.ms-btn-primary:hover {\n  background: var(--ms-midnight) !important;\n  transform: translateY(-2px) !important;\n}\n\n.ms-btn-arrow {\n  transition: transform 0.3s ease !important;\n}\n\n.ms-btn-primary:hover .ms-btn-arrow {\n  transform: translateX(5px) !important;\n}\n\n.ms-hero-scroll {\n  position: absolute !important;\n  bottom: 40px !important;\n  left: 56px !important;\n  display: flex !important;\n  align-items: center !important;\n  gap: 12px !important;\n}\n\n.ms-hero-scroll-line {\n  width: 40px !important;\n  height: 0.5px !important;\n  background: var(--ms-sand) !important;\n}\n\n.ms-hero-scroll-txt {\n  font-family: 'Jost', sans-serif !important;\n  font-size: 8.5px !important;\n  letter-spacing: 0.25em !important;\n  text-transform: uppercase !important;\n  color: var(--ms-text-light) !important;\n}\n\n@media (max-width: 900px) {\n  .ms-hero { grid-template-columns: 1fr !important; min-height: auto !important; }\n  .ms-hero-right { height: 55vw !important; }\n  .ms-hero-left { padding: 100px 28px 56px !important; }\n  .ms-hero-left::after { display: none !important; }\n}\n</style>"
