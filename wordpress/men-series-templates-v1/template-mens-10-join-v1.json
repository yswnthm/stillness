          "id": "ms_html_join",
          "elType": "widget",
          "settings": {
            "html": "<section class=\"ms-join-section\" id=\"join\">\n  <div class=\"ms-section-inner\">\n    <div class=\"ms-join-inner\">\n      <div class=\"ms-join-left\">\n        <div class=\"ms-section-eyebrow\">Join the Community</div>\n        <h2 class=\"ms-join-title\">Stay in the loop.<br><em>Hold the space.</em></h2>\n        <p class=\"ms-join-body\">Sessions happen once a month. Dates are announced inside the community first. Drop your email and we'll send you the WhatsApp invite — where session details, resources, and the conversation live between sessions.</p>\n        <div class=\"ms-join-how\">\n          <div class=\"ms-how-step\">\n            <div class=\"ms-how-num\">01</div>\n            <div class=\"ms-how-text\"><strong>Drop your email</strong> — you'll get the WhatsApp invite link immediately.</div>\n          </div>\n          <div class=\"ms-how-step\">\n            <div class=\"ms-how-num\">02</div>\n            <div class=\"ms-how-text\"><strong>Join the group</strong> — session dates, prompts, and resources posted monthly.</div>\n          </div>\n          <div class=\"ms-how-step\">\n            <div class=\"ms-how-num\">03</div>\n            <div class=\"ms-how-text\"><strong>Show up when it calls you</strong> — register for the session that fits your month.</div>\n          </div>\n        </div>\n      </div>\n\n      <div class=\"ms-form-card\">\n        <div id=\"msFormContent\">\n          <div class=\"ms-form-hl\">Join the Men's Series</div>\n          <div class=\"ms-form-sub\">Enter your name and email. We'll send the WhatsApp community link straight to your inbox.</div>\n          <div class=\"ms-form-group\">\n            <label class=\"ms-form-label\" for=\"fname\">First Name</label>\n            <input class=\"ms-form-input\" type=\"text\" id=\"fname\" placeholder=\"Your first name\">\n          </div>\n          <div class=\"ms-form-group\">\n            <label class=\"ms-form-label\" for=\"femail\">Email</label>\n            <input class=\"ms-form-input\" type=\"email\" id=\"femail\" placeholder=\"your@email.com\">\n          </div>\n          <div class=\"ms-consent-row\" onclick=\"msToggleConsent()\" id=\"msConsentRow\">\n            <div class=\"ms-consent-box\" id=\"msConsentBox\"></div>\n            <div class=\"ms-consent-text\">I confirm this community is <em>men only</em> and this applies to me. I understand sessions are held in Vancouver, BC.</div>\n          </div>\n          <button class=\"ms-form-btn\" onclick=\"msHandleSubmit()\">Send Me the WhatsApp Link →</button>\n          <div class=\"ms-form-disclaimer\">No spam. No selling your data. Unsubscribe anytime.</div>\n        </div>\n        <div class=\"ms-form-success\" id=\"msFormSuccess\">\n          <div class=\"ms-success-mark\">✦</div>\n          <div class=\"ms-success-title\">Welcome.</div>\n          <div class=\"ms-success-body\">Check your inbox — the WhatsApp invite is on its way.<br><br>We'll see you in the group.</div>\n          <p style=\"font-family:'Jost', sans-serif !important;font-size:10px !important;letter-spacing:0.2em !important;text-transform:uppercase !important;color:var(--ms-seafoam) !important;margin-top:8px !important\">Stillness Men's Series</p>\n        </div>\n      </div>\n    </div>\n  </div>\n</section>\n\n<style>\n@import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400;1,500&family=Jost:wght@200;300;400;500&display=swap');\n\n*,*::before,*::after{box-sizing:border-box !important}\n\n:root{\n  --ms-stone:#0E1B30;\n  --ms-cream:#F7F0EC;\n  --ms-seafoam:#688F9D;\n  --ms-wave:#7A8F96;\n  --ms-breeze:#D9E8EB;\n  --ms-warm:#E8DDD6;\n  --ms-amber:#C4935A;\n  --ms-text-body:#3D4F57;\n}\n\n.ms-join-section {\n  padding: 120px 0 !important;\n  background: var(--ms-cream) !important;\n}\n\n.ms-section-inner {\n  max-width: 1080px !important;\n  margin: 0 auto !important;\n  padding: 0 52px !important;\n}\n\n.ms-join-inner {\n  display: grid !important;\n  grid-template-columns: 1fr 1fr !important;\n  gap: 80px !important;\n  align-items: center !important;\n}\n\n.ms-join-left {\n  display: flex !important;\n  flex-direction: column !important;\n  gap: 22px !important;\n}\n\n.ms-section-eyebrow {\n  font-family: 'Jost', sans-serif !important;\n  font-size: 9px !important;\n  letter-spacing: 0.3em !important;\n  text-transform: uppercase !important;\n  color: var(--ms-amber) !important;\n  margin-bottom: 0 !important;\n}\n\n.ms-join-title {\n  font-family: 'Cormorant Garamond', serif !important;\n  font-size: clamp(36px, 4.5vw, 54px) !important;\n  font-weight: 300 !important;\n  line-height: 1.1 !important;\n  color: var(--ms-stone) !important;\n  margin: 0 !important;\n}\n\n.ms-join-title em {\n  font-style: italic !important;\n  color: var(--ms-seafoam) !important;\n}\n\n.ms-join-body {\n  font-family: 'Jost', sans-serif !important;\n  font-size: 13px !important;\n  line-height: 1.9 !important;\n  color: var(--ms-text-body) !important;\n  margin: 0 !important;\n}\n\n.ms-join-how {\n  display: flex !important;\n  flex-direction: column !important;\n  gap: 16px !important;\n  margin-top: 4px !important;\n}\n\n.ms-how-step {\n  display: flex !important;\n  align-items: flex-start !important;\n  gap: 18px !important;\n  padding: 14px 16px !important;\n  border-radius: 3px !important;\n  background: var(--ms-warm) !important;\n  border-left: 2px solid var(--ms-amber) !important;\n}\n\n.ms-how-num {\n  font-family: 'Cormorant Garamond', serif !important;\n  font-size: 13px !important;\n  color: var(--ms-amber) !important;\n  min-width: 18px !important;\n  padding-top: 1px !important;\n}\n\n.ms-how-text {\n  font-family: 'Jost', sans-serif !important;\n  font-size: 12.5px !important;\n  line-height: 1.6 !important;\n  color: var(--ms-text-body) !important;\n}\n\n.ms-how-text strong {\n  color: var(--ms-stone) !important;\n  font-weight: 400 !important;\n}\n\n.ms-form-card {\n  background: var(--ms-stone) !important;\n  border-radius: 4px !important;\n  padding: 48px 44px !important;\n  box-shadow: 0 24px 60px rgba(14,27,48,0.18) !important;\n}\n\n.ms-form-hl {\n  font-family: 'Cormorant Garamond', serif !important;\n  font-size: 24px !important;\n  font-weight: 300 !important;\n  color: var(--ms-cream) !important;\n  margin-bottom: 6px !important;\n}\n\n.ms-form-sub {\n  font-family: 'Jost', sans-serif !important;\n  font-size: 11.5px !important;\n  color: var(--ms-wave) !important;\n  margin-bottom: 28px !important;\n  line-height: 1.65 !important;\n  opacity: 0.85 !important;\n}\n\n.ms-form-group {\n  margin-bottom: 14px !important;\n}\n\n.ms-form-label {\n  display: block !important;\n  font-family: 'Jost', sans-serif !important;\n  font-size: 9px !important;\n  letter-spacing: 0.25em !important;\n  text-transform: uppercase !important;\n  color: var(--ms-seafoam) !important;\n  margin-bottom: 7px !important;\n}\n\n.ms-form-input {\n  width: 100% !important;\n  background: rgba(255,255,255,0.06) !important;\n  border: 0.5px solid rgba(164,178,186,0.25) !important;\n  border-radius: 2px !important;\n  padding: 13px 15px !important;\n  color: var(--ms-cream) !important;\n  font-family: 'Jost', sans-serif !important;\n  font-size: 13px !important;\n  font-weight: 300 !important;\n  outline: none !important;\n  transition: border-color 0.3s ease !important;\n}\n\n.ms-form-input::placeholder {\n  color: rgba(164,178,186,0.4) !important;\n}\n\n.ms-form-input:focus {\n  border-color: rgba(104,143,157,0.7) !important;\n}\n\n.ms-consent-row {\n  display: flex !important;\n  align-items: flex-start !important;\n  gap: 12px !important;\n  margin: 18px 0 !important;\n  cursor: pointer !important;\n  transition: opacity 0.3s ease !important;\n}\n\n.ms-consent-box {\n  width: 16px !important;\n  height: 16px !important;\n  border: 0.5px solid rgba(164,178,186,0.4) !important;\n  border-radius: 2px !important;\n  flex-shrink: 0 !important;\n  margin-top: 2px !important;\n  display: flex !important;\n  align-items: center !important;\n  justify-content: center !important;\n  transition: all 0.2s ease !important;\n  background: transparent !important;\n}\n\n.ms-consent-box.checked {\n  background: var(--ms-seafoam) !important;\n  border-color: var(--ms-seafoam) !important;\n}\n\n.ms-consent-text {\n  font-family: 'Jost', sans-serif !important;\n  font-size: 11px !important;\n  line-height: 1.6 !important;\n  color: var(--ms-wave) !important;\n  opacity: 0.85 !important;\n}\n\n.ms-consent-text em {\n  color: var(--ms-breeze) !important;\n  font-style: normal !important;\n}\n\n.ms-form-btn {\n  width: 100% !important;\n  background: var(--ms-seafoam) !important;\n  color: var(--ms-stone) !important;\n  border: none !important;\n  padding: 16px 32px !important;\n  border-radius: 2px !important;\n  font-family: 'Jost', sans-serif !important;\n  font-size: 10px !important;\n  letter-spacing: 0.25em !important;\n  text-transform: uppercase !important;\n  font-weight: 500 !important;\n  cursor: pointer !important;\n  transition: all 0.3s ease !important;\n  margin-top: 6px !important;\n}\n\n.ms-form-btn:hover {\n  background: var(--ms-breeze) !important;\n  transform: translateY(-1px) !important;\n}\n\n.ms-form-disclaimer {\n  font-family: 'Jost', sans-serif !important;\n  font-size: 10px !important;\n  color: var(--ms-wave) !important;\n  opacity: 0.4 !important;\n  margin-top: 12px !important;\n  text-align: center !important;\n  line-height: 1.5 !important;\n}\n\n.ms-form-success {\n  display: none !important;\n  flex-direction: column !important;\n  align-items: center !important;\n  text-align: center !important;\n  gap: 16px !important;\n  padding: 40px 16px !important;\n}\n\n.ms-success-mark {\n  width: 52px !important;\n  height: 52px !important;\n  border: 0.5px solid rgba(104,143,157,0.5) !important;\n  border-radius: 50% !important;\n  display: flex !important;\n  align-items: center !important;\n  justify-content: center !important;\n  font-size: 20px !important;\n  color: var(--ms-seafoam) !important;\n}\n\n.ms-success-title {\n  font-family: 'Cormorant Garamond', serif !important;\n  font-size: 28px !important;\n  font-weight: 300 !important;\n  color: var(--ms-cream) !important;\n  margin: 0 !important;\n}\n\n.ms-success-body {\n  font-family: 'Jost', sans-serif !important;\n  font-size: 12px !important;\n  line-height: 1.8 !important;\n  color: var(--ms-wave) !important;\n  margin: 0 !important;\n}\n\n@media(max-width:768px){\n  .ms-section-inner{padding:0 24px !important}\n  .ms-join-inner{grid-template-columns:1fr !important; gap:60px !important}\n  .ms-form-card{padding:40px 32px !important}\n}\n</style>\n\n<script>\nlet msConsented = false;\nfunction msToggleConsent() {\n  msConsented = !msConsented;\n  document.getElementById('msConsentBox').classList.toggle('checked', msConsented);\n}\nfunction msHandleSubmit() {\n  const name = document.getElementById('fname').value.trim();\n  const email = document.getElementById('femail').value.trim();\n  if (!name || !email || !email.includes('@')) {\n    ['fname','femail'].forEach(id => {\n      const el = document.getElementById(id);\n      if (!el.value.trim()) { \n        el.style.borderColor='rgba(104,143,157,0.8)'; \n        setTimeout(()=>el.style.borderColor='rgba(164,178,186,0.25)',2000); \n      }\n    });\n    return;\n  }\n  if (!msConsented) {\n    const row = document.getElementById('msConsentRow');\n    row.style.opacity='0.4'; \n    setTimeout(()=>row.style.opacity='1',1500);\n    return;\n  }\n  document.getElementById('msFormContent').style.display='none';\n  const s = document.getElementById('msFormSuccess');\n  s.style.setProperty('display', 'flex', 'important');\n}\n</script>"
          },
          "widgetType": "html"
        }
      ]
    }
  ],
  "page_settings": [],
  "version": "0.4",
  "title": "Men's Series — 10 Join",
  "type": "section"
