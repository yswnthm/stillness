                    "id": "marquee-html-widget",
                    "elType": "widget",
                    "settings": {
                        "html": "<div class='editorial-marquee-track'><div class='marquee-content'><span>SUSTAINABLE PACKAGING</span><span class='separator'>\u2022</span><span>ARTISAN CRAFTED</span><span class='separator'>\u2022</span><span>CONSCIOUSLY SOURCED</span><span class='separator'>\u2022</span><span>SMALL BATCH PRODUCTION</span><span class='separator'>\u2022</span></div><div class='marquee-content' aria-hidden='true'><span>SUSTAINABLE PACKAGING</span><span class='separator'>\u2022</span><span>ARTISAN CRAFTED</span><span class='separator'>\u2022</span><span>CONSCIOUSLY SOURCED</span><span class='separator'>\u2022</span><span>SMALL BATCH PRODUCTION</span><span class='separator'>\u2022</span></div></div><style>.editorial-marquee-track { display: flex; overflow: hidden; white-space: nowrap; user-select: none; } .marquee-content { display: flex; align-items: center; animation: editorial-marquee-scroll 40s linear infinite; } .marquee-content span { font-family: 'Lato', sans-serif; font-size: 13px; font-weight: 700; letter-spacing: 4px; color: #FFFFFF; padding: 0 40px; } .marquee-content .separator { color: #688F9D; opacity: 0.5; padding: 0; } @keyframes editorial-marquee-scroll { 0% { transform: translateX(0); } 100% { transform: translateX(-50%); } }</style>"
                    },
