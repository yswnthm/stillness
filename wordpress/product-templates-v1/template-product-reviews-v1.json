{
    "version": "0.4",
    "title": "Stillness Editorial Reviews V1",
    "type": "section",
    "content": [
        {
            "id": "editorial-reviews-section-wrapper",
            "elType": "container",
            "settings": {
                "content_width": "full",
                "background_background": "classic",
                "background_color": "#FFFFFF",
                "padding": {
                    "unit": "px",
                    "top": "80",
                    "bottom": "120",
                    "right": "40",
                    "left": "40",
                    "isLinked": false
                },
                "css_classes": "stillness-dynamic-reviews-container",
                "margin": {
                    "unit": "px",
                    "top": "0",
                    "bottom": "120",
                    "right": "0",
                    "left": "0",
                    "isLinked": false
                },
                "border_radius": {
                    "unit": "px",
                    "top": "24",
                    "right": "24",
                    "bottom": "24",
                    "left": "24",
                    "isLinked": true
                }
            },
            "elements": [
                {
                    "id": "reviews-html-injection",
                    "elType": "widget",
                    "settings": {
                        "html": "<div class='reviews-section-wrapper'><div class='reviews-header-custom'><h2 class='reviews-title-custom'>Community <span class='italic'>Notes.</span></h2></div></div><style>/* TITLE STYLING */.reviews-title-custom { font-family: 'Cormorant Garamond', serif !important; font-size: 48px !important; color: #0E1B30 !important; margin: 0; font-weight: 400 !important; }.reviews-title-custom .italic { font-style: italic !important; color: #688F9D !important; }.reviews-header-custom { padding-bottom: 32px; border-bottom: 1px solid rgba(14,27,48,0.1); margin-bottom: 48px; }/* REVIEW CONTENT */.stillness-dynamic-reviews-container #comments ol.commentlist li .description p { font-family: 'Cormorant Garamond', serif !important; font-size: 20px !important; line-height: 1.6 !important; color: rgba(14,27,48,0.8) !important; font-style: italic !important; }/* AUTHOR & UI ELEMENTS */.stillness-dynamic-reviews-container #comments ol.commentlist li .meta { font-family: 'Lato', sans-serif !important; font-size: 14px !important; text-transform: uppercase !important; letter-spacing: 2px !important; color: rgba(14,27,48,0.5) !important; font-weight: 700 !important; }.stillness-dynamic-reviews-container #reply-title { font-family: 'Cormorant Garamond', serif !important; font-size: 32px !important; color: #0E1B30 !important; }.stillness-dynamic-reviews-container .comment-form label { font-family: 'Lato', sans-serif !important; font-size: 11px !important; text-transform: uppercase !important; letter-spacing: 2px !important; }.stillness-dynamic-reviews-container .comment-form input, .stillness-dynamic-reviews-container .comment-form textarea { font-family: 'Lato', sans-serif !important; font-size: 16px !important; }.stillness-dynamic-reviews-container .comment-form .submit { font-family: 'Lato', sans-serif !important; font-size: 13px !important; font-weight: 700 !important; text-transform: uppercase !important; letter-spacing: 3px !important; background: #688F9D !important; border-radius: 100px !important; }</style>"
                    },
                    "widgetType": "html"
                }
            ]
        }
    ],
    "page_settings": []
}