                            "id": "sacred_timeline_html",
                            "elType": "widget",
                            "settings": {
                                "html": "<div class='timeline-section'><div class='timeline-header'><span class='timeline-label'>Rhythm of Rest</span><h2 class='timeline-main-title'>A Day in Stillness</h2></div><div class='timeline-container'><div class='timeline-line'></div><div class='timeline-rows'><div class='timeline-row left'><div class='timeline-circle-col'><div class='timeline-circle bg-breeze-low'><span class='time'>06:00</span></div></div><div class='timeline-content-col'><h4 class='timeline-title'>Morning Dew</h4><p class='timeline-text'>Awaken to silence before the digital world demands your attention.</p></div></div><div class='timeline-row right'><div class='timeline-circle-col'><div class='timeline-circle bg-seafoam-low'><span class='time'>13:00</span></div></div><div class='timeline-content-col'><h4 class='timeline-title'>The Midday Pause</h4><p class='timeline-text'>A deliberate check-in to reset the nervous system.</p></div></div><div class='timeline-row left'><div class='timeline-circle-col'><div class='timeline-circle bg-midnight-low'><span class='time'>20:00</span></div></div><div class='timeline-content-col'><h4 class='timeline-title'>Evening Descent</h4><p class='timeline-text'>Communal practice to shed the day's weight.</p></div></div></div></div></div><style>.timeline-section { position: relative; width: 100%; color: #F7F0EC; padding: 40px 0; }.timeline-header { text-align: center; margin-bottom: 120px; }.timeline-label { color: #688F9D; letter-spacing: 0.4em; text-transform: uppercase; font-size: 10px; margin-bottom: 24px; display: block; font-weight: 700; }.timeline-main-title { font-family: 'Cormorant Garamond', serif; font-style: italic; font-size: 56px; font-weight: 400; }.timeline-container { position: relative; max-width: 900px; margin: 0 auto; }.timeline-line { position: absolute; left: 50%; top: 0; bottom: 0; width: 1px; background: rgba(255, 255, 255, 0.05); transform: translateX(-50%); }@media (max-width: 768px) { .timeline-line { left: 40px; } }.timeline-rows { display: flex; flex-direction: column; gap: 120px; }.timeline-row { display: flex; align-items: center; gap: 80px; width: 100%; }@media (max-width: 768px) { .timeline-row { flex-direction: row !important; gap: 40px; text-align: left !important; } }.timeline-row.left { flex-direction: row; }.timeline-row.right { flex-direction: row-reverse; }.timeline-circle-col { width: 50%; display: flex; }@media (max-width: 768px) { .timeline-circle-col { width: 80px; flex-shrink: 0; } }.timeline-row.left .timeline-circle-col { justify-content: flex-end; }.timeline-row.right .timeline-circle-col { justify-content: flex-start; }.timeline-circle { width: 180px; height: 180px; border-radius: 50%; border: 1px solid rgba(255, 255, 255, 0.1); display: flex; align-items: center; justify-content: center; transition: all 0.5s ease; }@media (max-width: 768px) { .timeline-circle { width: 80px; height: 80px; } }.timeline-circle:hover { transform: scale(1.05); border-color: rgba(255, 255, 255, 0.3); }.time { font-family: 'Cormorant Garamond', serif; font-style: italic; font-size: 32px; }@media (max-width: 768px) { .time { font-size: 16px; } }.bg-breeze-low { background: rgba(217, 232, 235, 0.2); }.bg-seafoam-low { background: rgba(104, 143, 157, 0.2); }.bg-midnight-low { background: rgba(29, 49, 82, 0.4); }.timeline-content-col { width: 50%; }@media (max-width: 768px) { .timeline-content-col { width: calc(100% - 120px); } }.timeline-title { font-family: 'Cormorant Garamond', serif; font-size: 28px; margin-bottom: 16px; }.timeline-text { font-family: 'Lato', sans-serif; font-weight: 300; line-height: 1.6; color: rgba(247, 240, 236, 0.5); font-size: 14px; }</style>"
                            },
