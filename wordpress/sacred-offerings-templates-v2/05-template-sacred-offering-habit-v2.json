center; }@media (max-width: 1023px) { .offering-grid-habit { grid-template-columns: 1fr; display: flex; flex-direction: column-reverse; } }.offering-img-col-habit { position: relative; z-index: 1; }.offering-img-wrap-habit { aspect-ratio: 16/10; border-radius: 3rem; overflow: hidden; box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.3); position: relative; }.offering-img-wrap-habit img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.7s cubic-bezier(0.2, 0.8, 0.2, 1); }.offering-img-wrap-habit:hover img { transform: scale(1.05); }.overlay-dark { position: absolute; inset: 0; background: rgba(14, 27, 48, 0.2); }.offering-card-col-habit { position: relative; z-index: 10; margin-right: -96px; }@media (max-width: 1023px) { .offering-card-col-habit { margin-right: 0; margin-top: 48px; } }.offering-card-dark { background: #1D3152; padding: 40px; border-radius: 3rem; border: 1px solid rgba(255, 255, 255, 0.05); box-shadow: 0 50px 100px -20px rgba(0,0,0,0.3); position: relative; min-height: 500px; display: flex; flex-direction: column; justify-content: center; }@media (min-width: 1024px) { .offering-card-dark { padding: 56px; } }.offering-icon-bg-light { position: absolute; top: 40px; left: 40px; font-size: 100px; color: #FFFFFF; opacity: 0.1; transition: opacity 0.5s ease; pointer-events: none; }.offering-card-dark:hover .offering-icon-bg-light { opacity: 0.2; }.offering-label-seafoam { display: block; color: #688F9D; letter-spacing: 0.2em; text-transform: uppercase; font-size: 12px; margin-bottom: 16px; font-family: 'Lato', sans-serif; font-weight: 700; }.offering-title-white { font-family: 'Cormorant Garamond', serif; font-size: clamp(2rem, 4vw, 3rem); color: #F7F0EC; margin-bottom: 24px; font-weight: 500; }.offering-desc-white { font-family: 'Lato', sans-serif; color: rgba(247, 240, 236, 0.6); font-size: 14px; line-height: 1.625; margin-bottom: 32px; font-weight: 300; }.offering-features-white { margin-bottom: 40px; display: flex; flex-direction: column; gap: 16px; }.feature-item-white { display: flex; align-items: center; gap: 12px; color: rgba(247, 240, 236, 0.7); font-size: 12px; font-family: 'Lato', sans-serif; letter-spacing: 0.05em; }.dot-seafoam { width: 6px; height: 6px; background: #688F9D; border-radius: 50%; }.offering-pricing-dark { padding: 24px; background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 1rem; margin-bottom: 40px; }.price-label-seafoam { font-size: 10px; text-transform: uppercase; letter-spacing: 0.2em; color: #688F9D; margin-bottom: 4px; font-weight: 700; }.price-value-white { font-family: 'Cormorant Garamond', serif; font-size: 24px; color: #F7F0EC; }.price-unit-cream { font-family: 'Lato', sans-serif; font-size: 10px; text-transform: uppercase; letter-spacing: 0.2em; color: rgba(247, 240, 236, 0.4); margin-left: 8px; }.price-sub-cream { font-size: 12px; color: rgba(247, 240, 236, 0.4); margin-top: 4px; }.offering-btn-white { display: inline-flex; align-items: center; gap: 16px; text-decoration: none; color: #F7F0EC; align-self: flex-start; }.btn-icon-white { width: 48px; height: 48px; border-radius: 50%; border: 1px solid rgba(255, 255, 255, 0.2); display: flex; align-items: center; justify-content: center; transition: all 0.5s cubic-bezier(0.2, 0.8, 0.2, 1); }.offering-btn-white:hover .btn-icon-white { background: #F7F0EC; color: #0E1B30; }.offering-btn-white span { font-size: 14px; letter-spacing: 0.2em; text-transform: uppercase; font-family: 'Lato', sans-serif; border-bottom: 1px solid transparent; transition: all 0.5s ease; padding-bottom: 4px; }.offering-btn-white:hover span { border-color: #F7F0EC; }.reveal { opacity: 0; transform: translateY(30px); animation: revealFadeUp 1.2s cubic-bezier(0.2, 0.8, 0.2, 1) forwards; }.reveal-delay-1 { animation-delay: 0.2s; }@keyframes revealFadeUp { to { opacity: 1; transform: translateY(0); } }</style>"
