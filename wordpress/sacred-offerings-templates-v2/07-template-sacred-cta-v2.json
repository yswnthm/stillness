                    "settings": {
                        "html": "<div class='sacred-cta-wrap'><div class='sacred-cta-breathe'></div><div class='sacred-cta-content'><h2 class='sacred-cta-title'>Your practice<br>awaits.</h2><p class='sacred-cta-quote'>\"The quietest voice is often the most important.\"</p><div class='sacred-cta-actions'><a href='/about' class='cta-link'>Our Philosophy</a><a href='#memberships' class='cta-main'>View Offerings</a><a href='/contact' class='cta-link'>Inquire</a></div></div></div><style>.sacred-cta-wrap { position: relative; width: 100%; text-align: center; overflow: hidden; }.sacred-cta-breathe { position: absolute; inset: 0; background: rgba(217, 232, 235, 0.4); z-index: 0; animation: ctaBreathe 8s ease-in-out infinite; }.sacred-cta-content { position: relative; z-index: 10; max-width: 800px; margin: 0 auto; }.sacred-cta-title { font-family: 'Cormorant Garamond', serif; font-size: 72px; line-height: 1.1; color: #0E1B30; margin-bottom: 48px; }@media (max-width: 768px) { .sacred-cta-title { font-size: 48px; } }.sacred-cta-quote { font-family: 'Lato', sans-serif; font-style: italic; color: rgba(14, 27, 48, 0.6); margin-bottom: 64px; font-size: 18px; font-weight: 300; }.sacred-cta-actions { display: flex; flex-direction: row; align-items: center; justify-content: center; gap: 48px; }@media (max-width: 768px) { .sacred-cta-actions { flex-direction: column; gap: 32px; } }.cta-link { color: #0E1B30; text-decoration: none; text-transform: uppercase; letter-spacing: 0.2em; font-size: 12px; font-family: 'Lato', sans-serif; border-bottom: 1px solid rgba(14, 27, 48, 0.2); padding-bottom: 8px; transition: all 0.3s ease; }.cta-link:hover { border-color: #0E1B30; }.cta-main { background: #0E1B30; color: #FFFFFF; text-decoration: none; text-transform: uppercase; letter-spacing: 0.2em; font-size: 12px; font-family: 'Lato', sans-serif; padding: 20px 48px; border-radius: 99px; transition: all 0.5s cubic-bezier(0.2, 0.8, 0.2, 1); }.cta-main:hover { background: #1D3152; transform: scale(1.05); }@keyframes ctaBreathe { 0%, 100% { transform: scale(1); opacity: 0.3; } 50% { transform: scale(1.1); opacity: 0.5; } }</style>"
